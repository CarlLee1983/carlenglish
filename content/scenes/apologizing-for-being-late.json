  "sentences": [
    {
      "segments": [
        {
          "text": "Hi Kevin, I am calling because my bus is completely "
        },
        {
          "text": "stuck",
          "phraseIds": [
            "stuck-in-heavy-traffic"
          ],
          "wordIds": [
            "stuck"
          ]
        },
        {
          "text": " in heavy traffic",
          "phraseIds": [
            "stuck-in-heavy-traffic"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "嗨 Kevin，我打電話來是因為我的公車完全被卡在嚴重的塞車車陣中了。",
      "audio": {
        "src": "/audio/sentences/apologizing-for-being-late/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f1f5e8cfc71d14602b7018bb2cbca66171916902a47cd80947f2ab1ffc865948",
        "sha256": "9924879be32f7ad0045b52138eb43e795b84f3fb6e17004abe4e9d6a43a4273c"
      }
    },
    {
      "segments": [
        {
          "text": "I am "
        },
        {
          "text": "so ",
          "phraseIds": [
            "so-sorry-about-that"
          ]
        },
        {
          "text": "sorry",
          "phraseIds": [
            "so-sorry-about-that"
          ],
          "wordIds": [
            "sorry"
          ]
        },
        {
          "text": " about that",
          "phraseIds": [
            "so-sorry-about-that"
          ]
        },
        {
          "text": ", but I will be "
        },
        {
          "text": "fifteen minutes ",
          "phraseIds": [
            "fifteen-minutes-late"
          ]
        },
        {
          "text": "late",
          "phraseIds": [
            "fifteen-minutes-late"
          ],
          "wordIds": [
            "late"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我對此感到非常抱歉，但我大概會遲到十五分鐘。",
      "audio": {
        "src": "/audio/sentences/apologizing-for-being-late/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ac65a293adb37ac371a87374d44cbf2d51a0c1cb649e248485b3c162da031e70",
        "sha256": "071d21a70b9e6b76ef06e6ab4809f852f41e8cb6f0afba9ae0cf81ab1154af66"
      }
    },
    {
      "segments": [
        {
          "text": "Do not worry at all Leo, thank you for calling to let me know."
        }
      ],
      "translation": "Leo 完全不用擔心，謝謝你特地打電話告訴我。",
      "audio": {
        "src": "/audio/sentences/apologizing-for-being-late/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ce92ce62ddd3be353fb380689d8bc167255663cf5db47ba434413b23ae881062",
        "sha256": "1e7f1cc2267005a1538fb69ecf42a4e41665614cac06e33fff254459449fe06b"
      }
    },
    {
      "segments": [
        {
          "text": "There was a broken delivery truck blocking two lanes on the bridge."
        }
      ],
      "translation": "橋上有輛故障的貨車擋住了兩條車道。",
      "audio": {
        "src": "/audio/sentences/apologizing-for-being-late/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "24e0803f9fe07712a1b4daedd512b3dffaf3e0461c5fcb5845d5845d3d0cbcda",
        "sha256": "00789a398d7ffce939e65657cc98a2996fa4484e870db68942676be40932d474"
      }
    },
    {
      "segments": [
        {
          "text": "The traffic is starting to move again, so I should "
        },
        {
          "text": "arrive",
          "phraseIds": [
            "arrive-very-soon"
          ],
          "wordIds": [
            "arrive"
          ]
        },
        {
          "text": " very ",
          "phraseIds": [
            "arrive-very-soon"
          ]
        },
        {
          "text": "soon",
          "phraseIds": [
            "arrive-very-soon"
          ],
          "wordIds": [
            "soon"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "車流現在已經開始動了，所以我應該很快就會到達。",
      "audio": {
        "src": "/audio/sentences/apologizing-for-being-late/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "10297fc164180d2b46b6306bbfe40ca870dc36a66ffa51fa23214cfe9a892f9f",
        "sha256": "e72ce90ff5e19d900e519cb8b88a31bc51e41ec76dec13efa1d6c3f370f35f8d"
      }
    },
    {
      "segments": [
        {
          "text": "Take your time",
          "phraseIds": [
            "take-your-time"
          ]
        },
        {
          "text": " and stay safe, I will "
        },
        {
          "text": "wait",
          "wordIds": [
            "wait"
          ]
        },
        {
          "text": " for you inside the bookstore."
        }
      ],
      "translation": "你慢慢來注意安全，我會在書店裡面等你。",
      "audio": {
        "src": "/audio/sentences/apologizing-for-being-late/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "1e5e39dd764d20d6c9daeff5b1b7eb6a44c6363fefee3b223f2206724df2b65b",
        "sha256": "fe2734f6d06a3e2a9cfa59804f86913a164a11c78898f4b9605755b0d533b35c"
      }
    }
  ]
