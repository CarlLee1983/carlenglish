{
  "id": "supermarket-shopping",
  "title": "超市購物",
  "titleEn": "Shopping at the Supermarket",
  "category": "購物",
  "level": "初級",
  "image": {
    "src": "/images/scenes/supermarket-shopping.webp",
    "alt": "Nora 拿著裝有麵包和蘋果的購物籃，在超市貨架旁向一位女店員詢問牛奶的位置；店員指向冷藏架上的牛奶。",
    "width": 1536,
    "height": 1024
  },
  "sentences": [
    {
      "segments": [
        {
          "text": "Nora takes a "
        },
        {
          "text": "basket",
          "wordIds": [
            "basket"
          ]
        },
        {
          "text": " at the "
        },
        {
          "text": "supermarket",
          "wordIds": [
            "supermarket"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "Nora 在超市拿了一個購物籃。"
    },
    {
      "segments": [
        {
          "text": "She asks a staff member, “"
        },
        {
          "text": "Where can I find the ",
          "phraseIds": [
            "where-can-i-find"
          ]
        },
        {
          "text": "milk",
          "phraseIds": [
            "where-can-i-find"
          ],
          "wordIds": [
            "milk"
          ]
        },
        {
          "text": "?",
          "phraseIds": [
            "where-can-i-find"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "她問店員：「請問牛奶在哪裡？」"
    },
    {
      "segments": [
        {
          "text": "“"
        },
        {
          "text": "It's in ",
          "phraseIds": [
            "in-aisle-three"
          ]
        },
        {
          "text": "aisle",
          "phraseIds": [
            "in-aisle-three"
          ],
          "wordIds": [
            "aisle"
          ]
        },
        {
          "text": " three",
          "phraseIds": [
            "in-aisle-three"
          ]
        },
        {
          "text": ",” the staff member says."
        }
      ],
      "translation": "店員說：「在第三走道。」"
    },
    {
      "segments": [
        {
          "text": "She walks with Nora to "
        },
        {
          "text": "aisle",
          "wordIds": [
            "aisle"
          ]
        },
        {
          "text": " three and points to the "
        },
        {
          "text": "milk",
          "wordIds": [
            "milk"
          ]
        },
        {
          "text": " on a "
        },
        {
          "text": "shelf",
          "wordIds": [
            "shelf"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "她陪 Nora 走到第三走道，指給她看架上的牛奶。"
    },
    {
      "segments": [
        {
          "text": "“"
        },
        {
          "text": "I'll take a carton of ",
          "phraseIds": [
            "take-a-carton"
          ]
        },
        {
          "text": "milk",
          "phraseIds": [
            "take-a-carton"
          ],
          "wordIds": [
            "milk"
          ]
        },
        {
          "text": ",” Nora says, putting it in her "
        },
        {
          "text": "basket",
          "wordIds": [
            "basket"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "Nora 說：「我要拿一盒牛奶。」說完便把牛奶放進購物籃。"
    },
    {
      "segments": [
        {
          "text": "She picks up some "
        },
        {
          "text": "bread",
          "wordIds": [
            "bread"
          ]
        },
        {
          "text": " and apples, too."
        }
      ],
      "translation": "她也拿了一些麵包和蘋果。"
    },
    {
      "segments": [
        {
          "text": "At "
        },
        {
          "text": "checkout",
          "wordIds": [
            "checkout"
          ]
        },
        {
          "text": ", she asks, “"
        },
        {
          "text": "Can I ",
          "phraseIds": [
            "pay-by-card-question"
          ]
        },
        {
          "text": "pay by ",
          "phraseIds": [
            "pay-by-card-question",
            "pay-by-card"
          ]
        },
        {
          "text": "card",
          "phraseIds": [
            "pay-by-card-question",
            "pay-by-card"
          ],
          "wordIds": [
            "card"
          ]
        },
        {
          "text": "?",
          "phraseIds": [
            "pay-by-card-question"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "結帳時，她問：「可以刷卡嗎？」"
    },
    {
      "segments": [
        {
          "text": "She "
        },
        {
          "text": "pays by "
        },
        {
          "text": "card",
          "wordIds": [
            "card"
          ]
        },
        {
          "text": " and puts everything in a bag."
        }
      ],
      "translation": "她刷卡付了錢，並把買的東西都放進袋子裡。"
    }
  ],
