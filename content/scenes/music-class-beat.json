  "sentences": [
    {
      "segments": [
        {
          "text": "Mei holds a small "
        },
        {
          "text": "drum",
          "wordIds": [
            "drum"
          ]
        },
        {
          "text": " in "
        },
        {
          "text": "music",
          "wordIds": [
            "music"
          ]
        },
        {
          "text": " class."
        }
      ],
      "translation": "小美在音樂課上拿著一個小鼓。",
      "audio": {
        "src": "/audio/sentences/music-class-beat/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "89d1102b2ef2b49293db74b973e908b574b4d247da794eeea24754aff9941fc7",
        "sha256": "20b39dccabe70d142e8603d22dad8d856ed4741305b7d7403d1dacf1bcd984c8"
      }
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "teacher",
          "wordIds": [
            "teacher"
          ]
        },
        {
          "text": " says, “"
        },
        {
          "text": "Listen to the ",
          "phraseIds": [
            "listen-to-the-beat"
          ]
        },
        {
          "text": "beat",
          "phraseIds": [
            "listen-to-the-beat"
          ],
          "wordIds": [
            "beat"
          ]
        },
        {
          "text": ".”"
        }
      ],
      "translation": "老師說：「聽聽這個節拍。」",
      "audio": {
        "src": "/audio/sentences/music-class-beat/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "25d82043ce79f9885a068494e8155f68ec5382a5e93c18549c5c6772bf9cb143",
        "sha256": "2ce8ac099298555901b17d5a2c73657d65b2a11d88ac090f10f6cfd29e07d16a"
      }
    },
    {
      "segments": [
        {
          "text": "Mei taps the "
        },
        {
          "text": "drum",
          "wordIds": [
            "drum"
          ]
        },
        {
          "text": " with one "
        },
        {
          "text": "hand",
          "wordIds": [
            "hand"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "小美用一隻手輕敲小鼓。",
      "audio": {
        "src": "/audio/sentences/music-class-beat/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "09eb34607b469909443c465cc5c2f7287f7ddf78212f795059c9773b49cdf6f9",
        "sha256": "4160151d8029e309795ab9d7c339715684b9cc5bb80cfa755c554b73c77f9fe1"
      }
    },
    {
      "segments": [
        {
          "text": "Her "
        },
        {
          "text": "friends",
          "wordIds": [
            "friends"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "clap along",
          "phraseIds": [
            "clap-along"
          ]
        },
        {
          "text": " with her."
        }
      ],
      "translation": "她的朋友跟著她拍手。",
      "audio": {
        "src": "/audio/sentences/music-class-beat/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "0878e9d7c97a6014ae102f17916722c5963bf31a6332b00a161f60473a5d4c7d",
        "sha256": "838b199408b7eb1e33a5f60b86fa2539b47db806f2cb7068e3bb26b854f82140"
      }
    },
    {
      "segments": [
        {
          "text": "“"
        },
        {
          "text": "Can we play slowly",
          "phraseIds": [
            "can-we-play-slowly"
          ]
        },
        {
          "text": "?” asks Mei."
        }
      ],
      "translation": "小美問：「我們可以慢慢打嗎？」",
      "audio": {
        "src": "/audio/sentences/music-class-beat/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f4bb8354da8ef13675692e20aaa084d0503c5f2dcad3380c14a44fb93819fd81",
        "sha256": "8ee310b0754bc7fa12c88eb08c95240b7ebbd893e9e94edf1d2678335008cd76"
      }
    },
    {
      "segments": [
        {
          "text": "They "
        },
        {
          "text": "try again",
          "phraseIds": [
            "try-again"
          ]
        },
        {
          "text": " and smile together."
        }
      ],
      "translation": "他們再試一次，一起露出笑容。",
