  "sentences": [
    {
      "segments": [
        {
          "text": "Toby walks into the neighborhood "
        },
        {
          "text": "library",
          "wordIds": [
            "library"
          ]
        },
        {
          "text": " with his mother."
        }
      ],
      "translation": "Toby 和媽媽一起走進社區圖書館。"
    },
    {
      "segments": [
        {
          "text": "A sign on the wall says, “"
        },
        {
          "text": "Please be quiet in the ",
          "phraseIds": [
            "please-be-quiet-in-the-library"
          ]
        },
        {
          "text": "library",
          "phraseIds": [
            "please-be-quiet-in-the-library"
          ],
          "wordIds": [
            "library"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "please-be-quiet-in-the-library"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "牆上的標語寫著：「在圖書館裡請保持安靜。」"
    },
    {
      "segments": [
        {
          "text": "He looks at the tall "
        },
        {
          "text": "shelf",
          "wordIds": [
            "shelf"
          ]
        },
        {
          "text": " to find a fun story."
        }
      ],
      "translation": "他看著高高的書架，想找一本有趣的故事書。"
    },
    {
      "segments": [
        {
          "text": "He finds a picture "
        },
        {
          "text": "book",
          "wordIds": [
            "book"
          ]
        },
        {
          "text": " about animals that he wants to "
        },
        {
          "text": "read",
          "wordIds": [
            "read"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "他找到一本想讀的動物繪本。"
    },
    {
      "segments": [
        {
          "text": "Toby walks to the "
        },
        {
          "text": "librarian",
          "wordIds": [
            "librarian"
          ]
        },
        {
          "text": " and asks, “"
        },
        {
          "text": "Can I borrow this ",
          "phraseIds": [
            "can-i-borrow-this-book"
          ]
        },
        {
          "text": "book",
          "phraseIds": [
            "can-i-borrow-this-book"
          ],
          "wordIds": [
            "book"
          ]
        },
        {
          "text": "?",
          "phraseIds": [
            "can-i-borrow-this-book"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Toby 走向圖書館員並問：「我可以借這本書嗎？」"
    },
    {
      "segments": [
        {
          "text": "He smiles and says, “"
        },
        {
          "text": "Here is my library ",
          "phraseIds": [
            "here-is-my-library-card"
          ]
        },
        {
          "text": "card",
          "phraseIds": [
            "here-is-my-library-card"
          ],
          "wordIds": [
            "card"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "here-is-my-library-card"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "他微笑著說：「這是我的借書證。」"
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "librarian",
          "wordIds": [
            "librarian"
          ]
        },
        {
          "text": " stamps the "
        },
        {
          "text": "book",
          "wordIds": [
            "book"
          ]
        },
        {
          "text": " and says, “"
        },
        {
          "text": "Enjoy your reading!",
          "phraseIds": [
            "enjoy-your-reading"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "圖書館員在書上蓋章並說：「祝你閱讀愉快！」"
    }
