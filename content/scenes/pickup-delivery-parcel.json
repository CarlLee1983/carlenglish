  "sentences": [
    {
      "segments": [
        {
          "text": "Hello, I came here to "
        },
        {
          "text": "pick",
          "phraseIds": [
            "pick-up-a-parcel"
          ],
          "wordIds": [
            "pick"
          ]
        },
        {
          "text": " up a parcel",
          "phraseIds": [
            "pick-up-a-parcel"
          ]
        },
        {
          "text": " from online shopping."
        }
      ],
      "translation": "你好，我來這裡領取一件網購的包裹。",
      "audio": {
        "src": "/audio/sentences/pickup-delivery-parcel/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "cc28a8a37878a87c8413c763a9ead8b7f729bad3aca41c9acaa0cfe675fbdd07",
        "sha256": "b9d095cfd39f0c0e56c545a46963c3bc3c497f9dbd76fec029259681fb3ce603"
      }
    },
    {
      "segments": [
        {
          "text": "Could you please tell me your full name and "
        },
        {
          "text": "phone",
          "wordIds": [
            "phone"
          ]
        },
        {
          "text": " number?"
        }
      ],
      "translation": "可以請您告訴我您的完整姓名和電話號碼嗎？",
      "audio": {
        "src": "/audio/sentences/pickup-delivery-parcel/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "b18c48c82ae94b52599825e36cf5b74cad268c41a2b1ba0a84a7a711100d5a20",
        "sha256": "538ea62960af0afb5aa7e2a9d6f5c9de24ee0deda384e5ec164a89d976bbe164"
      }
    },
    {
      "segments": [
        {
          "text": "My name is Eric Lin, and "
        },
        {
          "text": "the ",
          "phraseIds": [
            "the-last-three-digits"
          ]
        },
        {
          "text": "last",
          "phraseIds": [
            "the-last-three-digits"
          ],
          "wordIds": [
            "last"
          ]
        },
        {
          "text": " three digits",
          "phraseIds": [
            "the-last-three-digits"
          ]
        },
        {
          "text": " are 508."
        }
      ],
      "translation": "我叫 Eric Lin，手機末三碼是 508。",
      "audio": {
        "src": "/audio/sentences/pickup-delivery-parcel/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "bc14ef4343d410fd0238696242a3b02e0dafcf9449df65aac0451bda5405ca51",
        "sha256": "fbcd24a9564061b15f04450194e8ecd193d9bbf4df777aa30bea302f9332a5ee"
      }
    },
    {
      "segments": [
        {
          "text": "Please "
        },
        {
          "text": "show",
          "wordIds": [
            "show"
          ]
        },
        {
          "text": " a "
        },
        {
          "text": "photo ID card",
          "phraseIds": [
            "photo-id-card"
          ]
        },
        {
          "text": " to verify before taking the "
        },
        {
          "text": "package",
          "wordIds": [
            "package"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "在拿走包裹之前，請出示有照片的身分證件進行核對。",
      "audio": {
        "src": "/audio/sentences/pickup-delivery-parcel/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e6e78a6c3596bfec3aa972f7a9ceda305f9c45dab7980993e56e0a88fcb27485",
        "sha256": "292c49702940800b4bce2b7138a7c15f9042fe9f4965d5a9dcd06bdadac4bca0"
      }
    },
    {
      "segments": [
        {
          "text": "Here is my student ID card with my official name on it."
        }
      ],
      "translation": "這是我的學生證，上面有我的正式姓名。",
      "audio": {
        "src": "/audio/sentences/pickup-delivery-parcel/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "610fc1653e875b1592160cb99133d04662588dcecf745ca021ae679ce03523e4",
        "sha256": "484a98e8cfcf32ad36c506a0c7a6b7c8e647acbbdf38aec2a0ccb3cb51fb81bd"
      }
    },
    {
      "segments": [
        {
          "text": "Everything matches",
          "phraseIds": [
            "everything-matches"
          ]
        },
        {
          "text": ", please "
        },
        {
          "text": "sign",
          "phraseIds": [
            "sign-on-the-screen"
          ],
          "wordIds": [
            "sign"
          ]
        },
        {
          "text": " on the screen",
          "phraseIds": [
            "sign-on-the-screen"
          ]
        },
        {
          "text": " to confirm."
        }
      ],
      "translation": "資料全部相符，請在螢幕上簽名確認就可以囉。",
      "audio": {
        "src": "/audio/sentences/pickup-delivery-parcel/6.mp3",
