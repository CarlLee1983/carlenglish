  "sentences": [
    {
      "segments": [
        {
          "text": "Good afternoon, could I get an English "
        },
        {
          "text": "guide",
          "phraseIds": [
            "guide-map"
          ],
          "wordIds": [
            "guide"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "map",
          "phraseIds": [
            "guide-map"
          ],
          "wordIds": [
            "map"
          ]
        },
        {
          "text": " of the building?"
        }
      ],
      "translation": "午安，我可以拿一份這棟建築物的英文導覽地圖嗎？",
      "audio": {
        "src": "/audio/sentences/information-desk-map/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f2aabda782696af8bfdb643e373cc7a82b01d30a6c41bef9f218272a3aa914b5",
        "sha256": "b23ba731690e35aa410818aab865c3d589e0b500b3d5bdebd46cd5c76473f31d"
      }
    },
    {
      "segments": [
        {
          "text": "Here is our "
        },
        {
          "text": "free",
          "phraseIds": [
            "free-visitor-guide"
          ],
          "wordIds": [
            "free"
          ]
        },
        {
          "text": " visitor ",
          "phraseIds": [
            "free-visitor-guide"
          ]
        },
        {
          "text": "guide",
          "phraseIds": [
            "free-visitor-guide"
          ],
          "wordIds": [
            "guide"
          ]
        },
        {
          "text": " with every exhibition hall."
        }
      ],
      "translation": "這份是我們的免費參觀指南，裡面標有每一個展覽廳。",
      "audio": {
        "src": "/audio/sentences/information-desk-map/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "57c569146988d5dd708ceec4bab176d7f7e1e919a5ef776cbf56cf7992f22804",
        "sha256": "03eff858419afde2accc1a8c79320cda316a268913860e36690b6119ecfd3da6"
      }
    },
    {
      "segments": [
        {
          "text": "Where are the "
        },
        {
          "text": "public restrooms",
          "phraseIds": [
            "public-restrooms"
          ]
        },
        {
          "text": " and the drinking water fountains located?"
        }
      ],
      "translation": "請問公共洗手間和飲水機位置在哪裡呢？",
      "audio": {
        "src": "/audio/sentences/information-desk-map/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "a1b329c48ea5c25212d3a9e2cfff55e3d75593b0613898107e0ab1c8fd4af370",
        "sha256": "6cc3fc661409e5dbdb97acc11b45f531f966762728862c9cac973c7a5cd47d48"
      }
    },
    {
      "segments": [
        {
          "text": "Restrooms are on every floor right "
        },
        {
          "text": "next to the ",
          "phraseIds": [
            "next-to-the-elevator"
          ]
        },
        {
          "text": "elevator",
          "phraseIds": [
            "next-to-the-elevator"
          ],
          "wordIds": [
            "elevator"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "每一層樓都有洗手間，就在電梯的正旁邊。",
      "audio": {
        "src": "/audio/sentences/information-desk-map/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "aa504785f7ceb74e109f7f70f58686e39110f226bf708d51728c6f0f752100d4",
        "sha256": "97d195fae132f9eec2bbd5ee064df907cfb9ffab20e14281c2598d5bce2f8a8b"
      }
    },
    {
      "segments": [
        {
          "text": "Can you "
        },
        {
          "text": "show",
          "wordIds": [
            "show"
          ]
        },
        {
          "text": " me where the special dinosaur hall is on this "
        },
        {
          "text": "level",
          "wordIds": [
            "level"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "您可以幫我指出恐龍特展廳在這一層的哪裡嗎？",
      "audio": {
        "src": "/audio/sentences/information-desk-map/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9c11d3d49b73fdb57a4b5aa87637e15f948383ef245b3fc7fc7719a0347462ab",
        "sha256": "49793b8f2820d91ae308842e0ad2eb59363ba7768db70c369eba76a0d50877ee"
      }
    },
    {
      "segments": [
        {
          "text": "It is "
        },
        {
          "text": "straight down this corridor",
          "phraseIds": [
            "straight-down-this-corridor"
          ]
        },
        {
          "text": " behind the gift shop."
        }
      ],
      "translation": "沿著這條走廊一直往前走，就在紀念品店的後方。",
      "audio": {
        "src": "/audio/sentences/information-desk-map/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "4998d1d32a34abd1e3d769c78e90d24fb51290f37111e42a4b63086035fa997c",
        "sha256": "98f3476026c6fbde59c89e54b7058ed5d9995958ab10f4036ed0209de821e340"
      }
    }
  ]
