  "sentences": [
    {
      "segments": [
        {
          "text": "Good morning Mrs. Chen, are you "
        },
        {
          "text": "heading out",
          "phraseIds": [
            "heading-out"
          ]
        },
        {
          "text": " for a morning walk?"
        }
      ],
      "translation": "陳太太早安，您正準備出門晨間散步嗎？",
      "audio": {
        "src": "/audio/sentences/neighbor-elevator-chat/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "743c8672fc081ad22a8cd1ef5af246dafad4876852d829deed4507b35c3d1956",
        "sha256": "944a470fa8021dfda2dee0ed3b75c91b88bae42b9c690c23f47694b1270c6bac"
      }
    },
    {
      "segments": [
        {
          "text": "Good morning Leo, yes, the "
        },
        {
          "text": "weather",
          "wordIds": [
            "weather"
          ]
        },
        {
          "text": " is so "
        },
        {
          "text": "nice",
          "phraseIds": [
            "nice-and-cool"
          ],
          "wordIds": [
            "nice"
          ]
        },
        {
          "text": " and cool",
          "phraseIds": [
            "nice-and-cool"
          ]
        },
        {
          "text": " today."
        }
      ],
      "translation": "Leo 早安，是呀，今天的天氣真的非常舒服涼爽。",
      "audio": {
        "src": "/audio/sentences/neighbor-elevator-chat/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "7df35d0be4ee6c74a43b10d88d3b1b96a1e28a242673449ccb5fb2261082565d",
        "sha256": "9977bdd0211b9ef5efb8fe12696b93ea6a6759544056b46c79faa366fc9f9e04"
      }
    },
    {
      "segments": [
        {
          "text": "After several days of rain",
          "phraseIds": [
            "after-several-days-of-rain"
          ]
        },
        {
          "text": ", it is wonderful to see the bright sun."
        }
      ],
      "translation": "在下了好幾天雨之後，能看到明亮的陽光真是太棒了。",
      "audio": {
        "src": "/audio/sentences/neighbor-elevator-chat/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c84568b889f2b314ed2a8be83d8a0828f0566a559fc07d644cc8498a948d140b",
        "sha256": "685f4476bb85315ad8ec54ada3e8fc5cc1703db40f754769808d69e1645080b0"
      }
    },
    {
      "segments": [
        {
          "text": "Are you "
        },
        {
          "text": "heading off to school",
          "phraseIds": [
            "heading-off-to-school"
          ]
        },
        {
          "text": " or do you have sports practice?"
        }
      ],
      "translation": "你現在是要去學校上課，還是有運動隊伍的練習呢？",
      "audio": {
        "src": "/audio/sentences/neighbor-elevator-chat/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "1eea1bfebbd65b4e903fa6c454a77db10c4e65c7a72a81670659a69f38391aa1",
        "sha256": "083e851f2b257ec434380ec87aeb4d9077f1823ca9b38c2549bd52c31e99cc8d"
      }
    },
    {
      "segments": [
        {
          "text": "I have soccer training with my school teammates on the grass field."
        }
      ],
      "translation": "我和我學校的隊友們在草地上有足球訓練課。",
      "audio": {
        "src": "/audio/sentences/neighbor-elevator-chat/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "2ad7e2c67a99849a6ad31c34d5b4ed2382dfd8f1764f935b3cddc8ad6aa4a865",
        "sha256": "c7a28e733f09a53ac6b9d0e1039c1cd191835c7001d8f1a017a7203a968bb9b3"
      }
    },
    {
      "segments": [
        {
          "text": "With a warm "
        },
        {
          "text": "smile",
          "wordIds": [
            "smile"
          ]
        },
        {
          "text": ", she wished me a "
        },
        {
          "text": "lovely",
          "phraseIds": [
            "lovely-sunny-weekend"
          ],
          "wordIds": [
            "lovely"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "sunny",
          "phraseIds": [
            "lovely-sunny-weekend"
          ],
          "wordIds": [
            "sunny"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "weekend",
          "phraseIds": [
            "lovely-sunny-weekend"
          ],
          "wordIds": [
            "weekend"
          ]
        },
        {
          "text": "!"
        }
      ],
      "translation": "她帶著溫暖的微笑，祝我有個愉快陽光的週末！",
      "audio": {
        "src": "/audio/sentences/neighbor-elevator-chat/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c96a95e34bde87b2c484b41fbeaadf57ed16ee70419f2d883de1306483df6039",
        "sha256": "1d379a43f1bc9bea71ea3c887f8bbcb7cf111f6b1d8c2e324a5ed863dbaf7833"
      }
    }
  ]
