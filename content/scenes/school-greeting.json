  "sentences": [
    {
      "segments": [
        {
          "text": "It is the first day of "
        },
        {
          "text": "school",
          "wordIds": [
            "school"
          ]
        },
        {
          "text": ", and Leo walks into the "
        },
        {
          "text": "classroom",
          "wordIds": [
            "classroom"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "開學第一天，Leo 走進教室。"
    },
    {
      "segments": [
        {
          "text": "A "
        },
        {
          "text": "friendly",
          "wordIds": [
            "friendly"
          ]
        },
        {
          "text": " girl "
        },
        {
          "text": "smiles",
          "wordIds": [
            "smile"
          ]
        },
        {
          "text": " and says, “"
        },
        {
          "text": "Hello!",
          "phraseIds": [
            "hello"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "一位友善的女孩微笑著說：「你好！」"
    },
    {
      "segments": [
        {
          "text": "Leo smiles back and says, “Hi, "
        },
        {
          "text": "my ",
          "phraseIds": [
            "my-name-is"
          ]
        },
        {
          "text": "name",
          "phraseIds": [
            "my-name-is"
          ],
          "wordIds": [
            "name"
          ]
        },
        {
          "text": " is",
          "phraseIds": [
            "my-name-is"
          ]
        },
        {
          "text": " Leo.”"
        }
      ],
      "translation": "Leo 也微笑回應說：「嗨，我的名字是 Leo。」"
    },
    {
      "segments": [
        {
          "text": "Then he asks, “"
        },
        {
          "text": "What is your ",
          "phraseIds": [
            "what-is-your-name"
          ]
        },
        {
          "text": "name",
          "phraseIds": [
            "what-is-your-name"
          ],
          "wordIds": [
            "name"
          ]
        },
        {
          "text": "?",
          "phraseIds": [
            "what-is-your-name"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "接著他問：「你叫什麼名字？」"
    },
    {
      "segments": [
        {
          "text": "The girl says, “"
        },
        {
          "text": "Nice to meet you!",
          "phraseIds": [
            "nice-to-meet-you"
          ]
        },
        {
          "text": " I am Emma.”"
        }
      ],
      "translation": "女孩說：「很高興認識你！我是 Emma。」"
    },
    {
      "segments": [
        {
          "text": "Leo says, “Nice to meet you, too. "
        },
        {
          "text": "Let's be ",
          "phraseIds": [
            "lets-be-friends"
          ]
        },
        {
          "text": "friends",
          "phraseIds": [
            "lets-be-friends"
          ],
          "wordIds": [
            "friend"
          ]
        },
        {
          "text": "!",
          "phraseIds": [
            "lets-be-friends"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Leo 說：「我也很高興認識你。我們當朋友吧！」"
    }
  ],
