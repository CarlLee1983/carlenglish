  "sentences": [
    {
      "segments": [
        {
          "text": "Excuse me "
        },
        {
          "text": "officer",
          "wordIds": [
            "officer"
          ]
        },
        {
          "text": ", I got lost and my cell phone battery completely "
        },
        {
          "text": "ran out of charge",
          "phraseIds": [
            "ran-out-of-charge"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "警察先生不好意思，我迷路了而且我的手機電池電量完全耗盡了。",
      "audio": {
        "src": "/audio/sentences/asking-police-for-help/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "11f7103f1527bb36e510456297670368aa3bbe8266207ae6b02350e587813792",
        "sha256": "1732b8e7d0e26acff5a6540b11bea7d7252171693d38c0ffac32358408026d0a"
      }
    },
    {
      "segments": [
        {
          "text": "Please step inside our "
        },
        {
          "text": "police",
          "phraseIds": [
            "police-station"
          ],
          "wordIds": [
            "police"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "station",
          "phraseIds": [
            "police-station"
          ],
          "wordIds": [
            "station"
          ]
        },
        {
          "text": " and sit down on the comfortable bench."
        }
      ],
      "translation": "請進來我們派出所室內，先在舒服的長椅上坐一下。",
      "audio": {
        "src": "/audio/sentences/asking-police-for-help/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "48683108779dc44e3692e0e9397b4303cac9b593dffecd37da497b53b372c1aa",
        "sha256": "2fbb1524ea5112f565b2f10bc23c5bce58c270c46b72103010aeefe1eedbe1a9"
      }
    },
    {
      "segments": [
        {
          "text": "The friendly "
        },
        {
          "text": "police",
          "phraseIds": [
            "police-officer"
          ],
          "wordIds": [
            "police"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "officer",
          "phraseIds": [
            "police-officer"
          ],
          "wordIds": [
            "officer"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "listened",
          "phraseIds": [
            "listened-carefully"
          ],
          "wordIds": [
            "listen"
          ]
        },
        {
          "text": " carefully",
          "phraseIds": [
            "listened-carefully"
          ]
        },
        {
          "text": " as I "
        },
        {
          "text": "explained",
          "wordIds": [
            "explain"
          ]
        },
        {
          "text": " my urgent situation."
        }
      ],
      "translation": "親切的警員在我說明我焦急的狀況時，非常仔細專心地聆聽。",
      "audio": {
        "src": "/audio/sentences/asking-police-for-help/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "946f9403849bae2c5b2688c0ae9827c9745162e69572ccec4dabb498290173d7",
        "sha256": "585c372c9a33cb51b109aa96ff78c51407454b85523e539110bad373ef214da5"
      }
    },
    {
      "segments": [
        {
          "text": "He allowed me to "
        },
        {
          "text": "report",
          "wordIds": [
            "report"
          ]
        },
        {
          "text": " the issue and use the "
        },
        {
          "text": "station",
          "wordIds": [
            "station"
          ]
        },
        {
          "text": " landline phone to call my family."
        }
      ],
      "translation": "他讓我報告狀況，並使用派出所的室內有線電話打電話給家人。",
      "audio": {
        "src": "/audio/sentences/asking-police-for-help/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "91b4ab900c9f788cd95586012540bd56926f31406adb676307e4c041ee8ac5b3",
        "sha256": "33875450b2ef40be0b2a1613af419ef0787f516f7c0e77f0b855e7948052057e"
      }
    },
    {
      "segments": [
        {
          "text": "He also printed out a simple street map to show me the way back to the "
        },
        {
          "text": "station",
          "wordIds": [
            "station"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "他還印了一張簡單的街道地圖，為我指引走回車站的方向。",
      "audio": {
        "src": "/audio/sentences/asking-police-for-help/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "60bcc68b33108f64c5982bcf30a6c860fcd70c7b933b580889494de7b4a389b0",
        "sha256": "5cbf13aaaca4647a8406292920959c976c3781a62d274c7cb476869028230296"
      }
    },
    {
      "segments": [
        {
          "text": "I "
        },
        {
          "text": "felt very safe",
          "phraseIds": [
            "felt-very-safe"
          ]
        },
        {
          "text": " and deeply grateful for the community "
        },
        {
          "text": "police",
          "phraseIds": [
            "police-officer"
          ],
          "wordIds": [
            "police"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "officer",
          "phraseIds": [
            "police-officer"
          ],
          "wordIds": [
            "officer"
          ]
        },
        {
          "text": "'s help."
        }
      ],
      "translation": "我感到非常有安全感，並對社區警察先生的熱心幫忙充滿感激。",
      "audio": {
        "src": "/audio/sentences/asking-police-for-help/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "3aa2fd08f076ec6d4975094d6f3cf24c5750734d24e90508db24075aa819af29",
        "sha256": "cd6f53920360e06f38e6bb219f5e66e9604a4218bb5ad4d1a825d249dbea4c62"
      }
    }
  ]
