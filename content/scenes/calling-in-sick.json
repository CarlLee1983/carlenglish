  "sentences": [
    {
      "segments": [
        {
          "text": "Hello Mr. Davis, this is Leo "
        },
        {
          "text": "calling from home",
          "phraseIds": [
            "calling-from-home"
          ]
        },
        {
          "text": " this morning."
        }
      ],
      "translation": "戴維斯老師您好，我是 Leo，今天早上在家裡打電話過來。",
      "audio": {
        "src": "/audio/sentences/calling-in-sick/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "55f5a6c8c19f7bd5121b37df5317d72270a0fb7f85491b49505be7f2dbb70703",
        "sha256": "f43dc2ba9cc76d34ed88f58789f12e5fadf76e780fdefc4a6a976d637139b037"
      }
    },
    {
      "segments": [
        {
          "text": "I "
        },
        {
          "text": "feel very ",
          "phraseIds": [
            "feel-very-sick"
          ]
        },
        {
          "text": "sick",
          "phraseIds": [
            "feel-very-sick"
          ],
          "wordIds": [
            "sick"
          ]
        },
        {
          "text": " with stomach pain and cannot come to class today."
        }
      ],
      "translation": "我感到非常不舒服而且胃痛，今天沒辦法去學校上課。",
      "audio": {
        "src": "/audio/sentences/calling-in-sick/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "2ec8dade9cfefd04d6bed8e81e5325710b1288685d9285fbe6b28f8c69ffd7af",
        "sha256": "d8a3e66d9c347a22b4b286afcaefb335158ae474c9db614ce929b56053df95af"
      }
    },
    {
      "segments": [
        {
          "text": "I am sorry for the "
        },
        {
          "text": "short notice",
          "phraseIds": [
            "short-notice"
          ]
        },
        {
          "text": ", but I need to "
        },
        {
          "text": "stay",
          "phraseIds": [
            "stay-home-and-rest"
          ],
          "wordIds": [
            "stay"
          ]
        },
        {
          "text": " home and ",
          "phraseIds": [
            "stay-home-and-rest"
          ]
        },
        {
          "text": "rest",
          "phraseIds": [
            "stay-home-and-rest"
          ],
          "wordIds": [
            "rest"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "很抱歉臨時通知您，但我必須待在家裡好好休息。",
      "audio": {
        "src": "/audio/sentences/calling-in-sick/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "24714de8f12e40eae398636404f26e0d59aff3a96f65f6587ed86db1758790cd",
        "sha256": "2cfe2049d73e0d22a9f2b07711ed3b942ebb5c76f7c438cb0a992498d7cce033"
      }
    },
    {
      "segments": [
        {
          "text": "Have you seen a doctor yet to check the main "
        },
        {
          "text": "reason",
          "wordIds": [
            "reason"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "你去看過醫生檢查主要原因了嗎？",
      "audio": {
        "src": "/audio/sentences/calling-in-sick/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "a2d1e07950c1b7b2be96210f40c2772fe141ad66192e2aff49b588b53b95576b",
        "sha256": "be885d0a0deffbd5fc39f4016f5ced797bcb68ef9c549ef335d21c6ff72e91a4"
      }
    },
    {
      "segments": [
        {
          "text": "My mother is taking me to the hospital clinic later this morning."
        }
      ],
      "translation": "我媽媽今天早上晚點會帶我去醫院診所檢查。",
      "audio": {
        "src": "/audio/sentences/calling-in-sick/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "98bdfff362634f72a0d1fa7796e7615e1ba69aec382f60043b6181e6b5fc8ca1",
        "sha256": "7ff1423a5d1ac5e2ffd82f6d3bc4dd76126d6cfdfdac60cc989c74753aef3129"
      }
    },
    {
      "segments": [
        {
          "text": "I "
        },
        {
          "text": "hope",
          "wordIds": [
            "hope"
          ]
        },
        {
          "text": " to get plenty of "
        },
        {
          "text": "rest",
          "wordIds": [
            "rest"
          ]
        },
        {
          "text": " and "
        },
        {
          "text": "be ",
          "phraseIds": [
            "be-able-to-return"
          ]
        },
        {
          "text": "able",
          "phraseIds": [
            "be-able-to-return"
          ],
          "wordIds": [
            "able"
          ]
        },
        {
          "text": " to return",
          "phraseIds": [
            "be-able-to-return"
          ]
        },
        {
          "text": " tomorrow."
        }
      ],
      "translation": "我希望多休息之後，明天能夠順利回學校上課。",
      "audio": {
        "src": "/audio/sentences/calling-in-sick/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "59e949f644bd90c43162e77f72da4d02f522244bf0a5cf34d78c1255e5f9fdff",
        "sha256": "52524a7f4cf7c923a132f6cbb82751a94e5c1e63290bd93358182816d349c235"
      }
    }
  ]
