  "sentences": [
    {
      "segments": [
        {
          "text": "After class, Kevin stays in the classroom to talk to his English "
        },
        {
          "text": "teacher",
          "wordIds": [
            "teacher"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "下課後，Kevin 留在教室裡找他的英文老師談談。"
    },
    {
      "segments": [
        {
          "text": "He looks at the helpful "
        },
        {
          "text": "feedback",
          "wordIds": [
            "feedback"
          ]
        },
        {
          "text": " written on his "
        },
        {
          "text": "essay",
          "wordIds": [
            "essay"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "他看著寫在他作文上很有幫助的批改意見。"
    },
    {
      "segments": [
        {
          "text": "Kevin points to a note and asks, “"
        },
        {
          "text": "Could you ",
          "phraseIds": [
            "could-you-explain-this-part"
          ]
        },
        {
          "text": "explain",
          "phraseIds": [
            "could-you-explain-this-part"
          ],
          "wordIds": [
            "explain"
          ]
        },
        {
          "text": " this part?",
          "phraseIds": [
            "could-you-explain-this-part"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Kevin 指著一段評語問道：「您可以解釋這部分嗎？」"
    },
    {
      "segments": [
        {
          "text": "He wants to do better and asks, “"
        },
        {
          "text": "How can I ",
          "phraseIds": [
            "how-can-i-improve-my-writing"
          ]
        },
        {
          "text": "improve",
          "phraseIds": [
            "how-can-i-improve-my-writing"
          ],
          "wordIds": [
            "improve"
          ]
        },
        {
          "text": " my writing?",
          "phraseIds": [
            "how-can-i-improve-my-writing"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "他想寫得更好，便問道：「我該如何改進我的寫作呢？」"
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "teacher",
          "wordIds": [
            "teacher"
          ]
        },
        {
          "text": " gives him clear "
        },
        {
          "text": "advice",
          "wordIds": [
            "advice"
          ]
        },
        {
          "text": " on organizing his main ideas."
        }
      ],
      "translation": "老師就如何組織主要論點給了他明確的建議。"
    },
    {
      "segments": [
        {
          "text": "Kevin smiles and says, “"
        },
        {
          "text": "Thank you for the ",
          "phraseIds": [
            "thank-you-for-the-advice"
          ]
        },
        {
          "text": "advice",
          "phraseIds": [
            "thank-you-for-the-advice"
          ],
          "wordIds": [
            "advice"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "thank-you-for-the-advice"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Kevin 微笑著說：「謝謝您的建議。」"
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "teacher",
          "wordIds": [
            "teacher"
          ]
        },
        {
          "text": " smiles back and encourages him, “"
        },
        {
          "text": "Keep up the good work.",
          "phraseIds": [
            "keep-up-the-good-work"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "老師也對他微笑並鼓勵道：「繼續保持優異的表現。」"
    }
  ],
