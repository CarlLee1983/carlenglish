  "sentences": [
    {
      "segments": [
        {
          "text": "Our history presentation is next week, so we need to "
        },
        {
          "text": "divide the roles",
          "phraseIds": [
            "divide-the-roles"
          ]
        },
        {
          "text": " today."
        }
      ],
      "translation": "我們的歷史簡報就在下週，所以我們今天必須把角色分工好。",
      "audio": {
        "src": "/audio/sentences/project-role-sharing/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "79afce65aa3f709f0bd3d12b757ede0ea74556557111d31d0a0fce67a14374b0",
        "sha256": "16978dca2ba2f6f8de270c92bceb297a916bcb62abbe24924c2ec63434a4e1fc"
      }
    },
    {
      "segments": [
        {
          "text": "I can "
        },
        {
          "text": "take the ",
          "phraseIds": [
            "take-the-part-of"
          ]
        },
        {
          "text": "part",
          "phraseIds": [
            "take-the-part-of"
          ],
          "wordIds": [
            "part"
          ]
        },
        {
          "text": " of",
          "phraseIds": [
            "take-the-part-of"
          ]
        },
        {
          "text": " searching for old photos and facts online."
        }
      ],
      "translation": "我可以負責在網路上搜尋歷史老照片和相關史實的部分。",
      "audio": {
        "src": "/audio/sentences/project-role-sharing/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "fe14ac09b5a9cbc703ded34b94b14d104978134cf8ebc067dab7ac86857b7806",
        "sha256": "c9999c4576902a131a74fcada0e547569f031cd3a2a53e53653ee9c1ce272ee8"
      }
    },
    {
      "segments": [
        {
          "text": "Who wants to "
        },
        {
          "text": "choose",
          "wordIds": [
            "choose"
          ]
        },
        {
          "text": " to "
        },
        {
          "text": "make the presentation slides",
          "phraseIds": [
            "make-the-presentation-slides"
          ]
        },
        {
          "text": " and design the layout?"
        }
      ],
      "translation": "有誰想選擇製作簡報投影片和設計版面編排嗎？",
      "audio": {
        "src": "/audio/sentences/project-role-sharing/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "45086b8692477810562af1d322237079bba2ca080efa6a25b3384114c7069d8e",
        "sha256": "edf2161263f15b4c3f589f8607904fa0532df2311e5700a8373fa7181a723756"
      }
    },
    {
      "segments": [
        {
          "text": "I am good at drawing charts, so I will prepare the visual slides."
        }
      ],
      "translation": "我滿擅長畫圖表繪圖的，所以我來準備視覺投影片。",
      "audio": {
        "src": "/audio/sentences/project-role-sharing/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9eb039681a421ad6274b21749db68ec19e59d4d368dab5ba250b6b371e7e79a1",
        "sha256": "2d1c3a86d05048917ff0ee71f6cffc801075bc8d1aaa288a3e59a19391abf48d"
      }
    },
    {
      "segments": [
        {
          "text": "We all ",
          "phraseIds": [
            "we-all-agree"
          ]
        },
        {
          "text": "agree",
          "phraseIds": [
            "we-all-agree"
          ],
          "wordIds": [
            "agree"
          ]
        },
        {
          "text": " that to "
        },
        {
          "text": "share",
          "phraseIds": [
            "share-the-workload"
          ],
          "wordIds": [
            "share"
          ]
        },
        {
          "text": " the workload",
          "phraseIds": [
            "share-the-workload"
          ]
        },
        {
          "text": " equally makes our "
        },
        {
          "text": "team",
          "wordIds": [
            "team"
          ]
        },
        {
          "text": " stronger."
        }
      ],
      "translation": "我們大家都同意，公平分擔工作量能讓我們的團隊表現更好。",
      "audio": {
        "src": "/audio/sentences/project-role-sharing/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "b09bb8da498af3cc714c1777c1a30e960023a8f2595ff17c2fe91da19529038c",
        "sha256": "543a941e00082c2f38c788fc775b7c02c3b7d960c9340c093ac6914acd6192fe"
      }
    },
    {
      "segments": [
        {
          "text": "Let us "
        },
        {
          "text": "start",
          "wordIds": [
            "start"
          ]
        },
        {
          "text": " writing our outline together before leaving school."
        }
      ],
      "translation": "我們在放學離開學校之前，先一起著手寫出大綱架構吧。",
      "audio": {
