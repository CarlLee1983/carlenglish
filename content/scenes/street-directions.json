{
  "id": "street-directions",
  "title": "街上問路",
  "titleEn": "Asking for Directions",
  "category": "交通與問路",
  "level": "初級至初中級",
  "image": {
    "src": "/images/scenes/street-directions.webp",
    "alt": "Leo 拿著手機在街道人行道上向一名女子問路；女子指向前方，遠處可見紅綠燈、銀行與車站。",
    "width": 1536,
    "height": 1024
  },
  "sentences": [
    {
      "segments": [
        {
          "text": "Leo stops on a neighborhood "
        },
        {
          "text": "street",
          "wordIds": [
            "street"
          ]
        },
        {
          "text": " and checks his "
        },
        {
          "text": "phone",
          "wordIds": [
            "phone"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "Leo 在一條街區道路上停下來，查看手機。"
    },
    {
      "segments": [
        {
          "text": "He asks a "
        },
        {
          "text": "woman",
          "wordIds": [
            "woman"
          ]
        },
        {
          "text": ", “"
        },
        {
          "text": "How do I get to the ",
          "phraseIds": [
            "how-to-get-to-station"
          ]
        },
        {
          "text": "station",
          "phraseIds": [
            "how-to-get-to-station"
          ],
          "wordIds": [
            "station"
          ]
        },
        {
          "text": "?",
          "phraseIds": [
            "how-to-get-to-station"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "他問一位女子：「請問車站怎麼走？」"
    },
    {
      "segments": [
        {
          "text": "“"
        },
        {
          "text": "Go ",
          "phraseIds": [
            "go-straight"
          ]
        },
        {
          "text": "straight",
          "phraseIds": [
            "go-straight"
          ],
          "wordIds": [
            "straight"
          ]
        },
        {
          "text": " along this "
        },
        {
          "text": "street",
          "wordIds": [
            "street"
          ]
        },
        {
          "text": ",” she says, pointing ahead."
        }
      ],
      "translation": "她指向前方說：「沿著這條街直走。」"
    },
    {
      "segments": [
        {
          "text": "“Then "
        },
        {
          "text": "turn ",
          "phraseIds": [
            "turn-left-at-light"
          ]
        },
        {
          "text": "left",
          "phraseIds": [
            "turn-left-at-light"
          ],
          "wordIds": [
            "left"
          ]
        },
        {
          "text": " at the traffic light",
          "phraseIds": [
            "turn-left-at-light"
          ]
        },
        {
          "text": ".”"
        }
      ],
      "translation": "「然後在紅綠燈左轉。」"
    },
    {
      "segments": [
        {
          "text": "“The "
        },
        {
          "text": "station",
          "wordIds": [
            "station"
          ]
        },
        {
          "text": " is "
        },
        {
          "text": "next to the ",
          "phraseIds": [
            "next-to-bank"
          ]
        },
        {
          "text": "bank",
          "phraseIds": [
            "next-to-bank"
          ],
          "wordIds": [
            "bank"
          ]
        },
        {
          "text": ".”"
        }
      ],
      "translation": "「車站就在銀行旁邊。」"
    },
    {
      "segments": [
        {
          "text": "“It's about "
        },
        {
          "text": "a five-minute ",
          "phraseIds": [
            "five-minute-walk"
          ]
        },
        {
          "text": "walk",
          "phraseIds": [
            "five-minute-walk"
          ],
          "wordIds": [
            "walk"
          ]
        },
        {
          "text": " from here.”"
        }
      ],
      "translation": "「從這裡走過去大約五分鐘。」"
    },
    {
      "segments": [
        {
          "text": "“Thank you for your help,” Leo says."
        }
      ],
      "translation": "Leo 說：「謝謝妳幫忙。」"
    },
    {
      "segments": [
        {
          "text": "He puts away his "
        },
        {
          "text": "phone",
          "wordIds": [
            "phone"
          ]
        },
        {
          "text": " and starts walking."
        }
      ],
      "translation": "他收起手機，開始往車站走。"
    }
  ],
