  "sentences": [
    {
      "segments": [
        {
          "text": "Excuse me, I am having some "
        },
        {
          "text": "technical ",
          "phraseIds": [
            "technical-trouble"
          ]
        },
        {
          "text": "trouble",
          "phraseIds": [
            "technical-trouble"
          ],
          "wordIds": [
            "trouble"
          ]
        },
        {
          "text": " with this self-ordering kiosk."
        }
      ],
      "translation": "不好意思，我使用這台自助點餐機時遇到了一些技術上的問題。",
      "audio": {
        "src": "/audio/sentences/device-connection-trouble/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ace6e41a13372e7d7b6d041e6421a3e601cd696b4f7847a7727537ac3ad6e4de",
        "sha256": "7d40df3498776b8814740d674e8aa701001481e0867dcc2a0e611445a4a0278a"
      }
    },
    {
      "segments": [
        {
          "text": "What happened on the "
        },
        {
          "text": "touch ",
          "phraseIds": [
            "touch-screen"
          ]
        },
        {
          "text": "screen",
          "phraseIds": [
            "touch-screen"
          ],
          "wordIds": [
            "screen"
          ]
        },
        {
          "text": " while you were selecting your items?"
        }
      ],
      "translation": "在您剛才選取商品項目的時候，觸控螢幕上發生了什麼事呢？",
      "audio": {
        "src": "/audio/sentences/device-connection-trouble/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "006d222b6f5276dea5e43713f3f3ab8369b7143e066b4efccc5d9a9a898e7998",
        "sha256": "387a3697f01a9344b392a795e473e8f4dcbbeb846a248f6fcbb84c647412b308"
      }
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "screen",
          "wordIds": [
            "screen"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "completely froze",
          "phraseIds": [
            "completely-froze"
          ]
        },
        {
          "text": " and keeps displaying a network connection error."
        }
      ],
      "translation": "螢幕整個凍結卡住了，而且一直顯示網路連線錯誤的提示。",
      "audio": {
        "src": "/audio/sentences/device-connection-trouble/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "b99d1c1c1e61c11b78b9c915843760d54b82f7c18db0adf9961e4d8b485fcb92",
        "sha256": "07fb614097d878edf0d0f6c2361c5f8348df6df3290b56e59c01d8665b07cd11"
      }
    },
    {
      "segments": [
        {
          "text": "Let me open the lower cabinet and "
        },
        {
          "text": "turn",
          "phraseIds": [
            "turn-off-the-power-switch"
          ],
          "wordIds": [
            "turn"
          ]
        },
        {
          "text": " off the power switch",
          "phraseIds": [
            "turn-off-the-power-switch"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "讓我把下方底櫃打開，把主電源開關關掉。",
      "audio": {
        "src": "/audio/sentences/device-connection-trouble/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "43b07a8efda4c47dadbfae9668456aa50cb443ad901d52170080d5f7dd6fe527",
        "sha256": "8bc61efc16d3a9eefc7bc16b6c59e1c4d5617841864f3deceb4ad2542e6aa418"
      }
    },
    {
      "segments": [
        {
          "text": "We will wait ten seconds before pressing the "
        },
        {
          "text": "restart",
          "phraseIds": [
            "restart-button"
          ],
          "wordIds": [
            "restart"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "button",
          "phraseIds": [
            "restart-button"
          ],
          "wordIds": [
            "button"
          ]
        },
        {
          "text": " again."
        }
      ],
      "translation": "我們先等待十秒鐘，然後再重新按下重新開機鍵。",
      "audio": {
        "src": "/audio/sentences/device-connection-trouble/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f89d0ca6a6fd3e07ced2ed7d730c85e62cf0686f9a363f79a4c6da5945aea4ce",
        "sha256": "97b107d3279c7219f5f7126fcb61b3a200225780336b77c4f5027fabd3cccfb8"
      }
    },
    {
      "segments": [
        {
          "text": "The system rebooted successfully, please "
        },
        {
          "text": "try",
          "wordIds": [
            "try"
          ]
        },
        {
          "text": " tapping your card now."
        }
      ],
      "translation": "系統已經成功重啟完成了，請您現在再次嘗試刷卡感應。",
      "audio": {
        "src": "/audio/sentences/device-connection-trouble/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "1303bc97e077a73e2cff127980cf9817190d106ed28b2ba5a27e7665afa719e8",
        "sha256": "6eadef6e373a562e4d355892def8c64042e0836807f02d6cfcde996110fa237d"
      }
    }
  ]
