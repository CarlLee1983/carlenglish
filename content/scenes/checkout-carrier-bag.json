          ],
          "wordIds": [
            "plastic"
          ]
        },
        {
          "text": " bag",
          "phraseIds": [
            "purchase-a-plastic-bag"
          ]
        },
        {
          "text": " for two dollars?"
        }
      ],
      "translation": "需要花兩元購買一個塑膠提袋嗎？",
      "audio": {
        "src": "/audio/sentences/checkout-carrier-bag/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "1e35305bb1943e2d0caa2fec018909c277c50b2de5268b519f6c7d481ba8899f",
        "sha256": "ab17f41b19b08f1128b6b834bc06a488a0b028acf122816b387d806b3c2d09d1"
      }
    },
    {
      "segments": [
        {
          "text": "No thank you, I "
        },
        {
          "text": "brought my ",
          "phraseIds": [
            "brought-my-own-bag"
          ]
        },
        {
          "text": "own",
          "phraseIds": [
            "brought-my-own-bag"
          ],
          "wordIds": [
            "own"
          ]
        },
        {
          "text": " bag",
          "phraseIds": [
            "brought-my-own-bag"
          ]
        },
        {
          "text": " today."
        }
      ],
      "translation": "不用謝謝，我今天有自己帶袋子。",
      "audio": {
        "src": "/audio/sentences/checkout-carrier-bag/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
