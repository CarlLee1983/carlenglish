        {
          "text": "screen",
          "wordIds": [
            "screen"
          ]
        },
        {
          "text": " instead."
        }
      ],
      "translation": "請改刷我手機螢幕上的條碼載具就好。",
      "audio": {
        "src": "/audio/sentences/checkout-carrier-bag/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
