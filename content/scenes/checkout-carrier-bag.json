    },
    {
      "segments": [
        {
          "text": "Do you want to "
        },
        {
          "text": "print out the receipt",
          "phraseIds": [
            "print-out-the-receipt"
          ]
        },
        {
          "text": " with your purchase?"
        }
      ],
      "translation": "這次購買您需要印出發票收據嗎？",
      "audio": {
        "src": "/audio/sentences/checkout-carrier-bag/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
