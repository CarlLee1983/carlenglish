  "sentences": [
    {
      "segments": [
        {
          "text": "Selling fried food "
        },
        {
          "text": "sounds fun",
          "phraseIds": [
            "sounds-fun"
          ]
        },
        {
          "text": ", but maybe there is "
        },
        {
          "text": "a ",
          "phraseIds": [
            "a-better-option"
          ]
        },
        {
          "text": "better",
          "phraseIds": [
            "a-better-option"
          ],
          "wordIds": [
            "better"
          ]
        },
        {
          "text": " option",
          "phraseIds": [
            "a-better-option"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "賣炸物聽起來很有趣，但也許我們有更好的選擇方案。",
      "audio": {
        "src": "/audio/sentences/sharing-alternative-idea/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "7c9235eaf692c5cf98517935624b2976d6d40a3f8042d0ac05aef341a4aa2705",
        "sha256": "52285d52ce83904a157754b5fdcbf83f105be287a961726250b04c11722c7b8f"
      }
    },
    {
      "segments": [
        {
          "text": "What is your "
        },
        {
          "text": "main ",
          "phraseIds": [
            "main-point"
          ]
        },
        {
          "text": "point",
          "phraseIds": [
            "main-point"
          ],
          "wordIds": [
            "point"
          ]
        },
        {
          "text": " and reason against that plan?"
        }
      ],
      "translation": "你反對那個方案的主要論點和理由是什麼呢？",
      "audio": {
        "src": "/audio/sentences/sharing-alternative-idea/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "20eb9495312108705d03d8edf923b85bb0331de8b28c9621c6b1f9171393cecf",
        "sha256": "5eed1219da719d475653dca9b34e674701d974d16051c80daa6cbec2dd89a447"
      }
    },
    {
      "segments": [
        {
          "text": "I think buying oil and heavy cooking pots costs too much money."
        }
      ],
      "translation": "我認為購買油品和笨重的烹飪鍋具會花費太多預算。",
      "audio": {
        "src": "/audio/sentences/sharing-alternative-idea/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "d606c9e0f088c2995d3817d3f42ff25d49f1d8a6a892b84d44293df6502b760a",
        "sha256": "5afbe134b5728071775983894ef6d5ea264272085b696e22d497f0b0159bc497"
      }
    },
    {
      "segments": [
        {
          "text": "Even ",
          "phraseIds": [
            "even-though"
          ]
        },
        {
          "text": "though",
          "phraseIds": [
            "even-though"
          ],
          "wordIds": [
            "though"
          ]
        },
        {
          "text": " hot food is popular, creating less "
        },
        {
          "text": "waste",
          "wordIds": [
            "waste"
          ]
        },
        {
          "text": " is also important."
        }
      ],
      "translation": "雖然熱食很受歡迎，但減少垃圾浪費同樣非常重要。",
      "audio": {
        "src": "/audio/sentences/sharing-alternative-idea/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "7a491d31748eb198ec2cfba7c8f234685e988fd8cb371ef4dba13fe9f91e02ed",
        "sha256": "a0c83de07aad3cef928d332833d9312ca5ec80189bb838a273e418524f21a3b3"
      }
    },
    {
      "segments": [
        {
          "text": "My alternative "
        },
        {
          "text": "idea",
          "wordIds": [
            "idea"
          ]
        },
        {
          "text": " is setting up an interactive ring toss game booth."
        }
      ],
      "translation": "我提出的替代構想是設立一個互動套圈圈的遊戲攤位。",
      "audio": {
        "src": "/audio/sentences/sharing-alternative-idea/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "3b98baffa8dede6d9612ee5a01da4f9eb62ae08657f5f89be31407cef30d799e",
        "sha256": "ad33a729a94de7afc913348177649ff5bab7aef3e3e7e1f340c134f2965b4bf6"
      }
    },
    {
      "segments": [
        {
          "text": "We all "
        },
        {
          "text": "believe",
          "wordIds": [
            "believe"
          ]
        },
        {
          "text": " your "
        },
        {
          "text": "point",
          "wordIds": [
            "point"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "makes great sense",
          "phraseIds": [
            "makes-great-sense"
          ]
        },
        {
          "text": " for our budget."
        }
      ],
      "translation": "我們大家都相信你的觀點對我們的班級預算來說非常有道理。",
      "audio": {
        "src": "/audio/sentences/sharing-alternative-idea/6.mp3",
