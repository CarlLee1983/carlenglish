  "sentences": [
    {
      "segments": [
        {
          "text": "Our beloved family "
        },
        {
          "text": "pet",
          "wordIds": [
            "pet"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "cat",
          "wordIds": [
            "cat"
          ]
        },
        {
          "text": " slipped out of the balcony door and "
        },
        {
          "text": "got lost yesterday",
          "phraseIds": [
            "got-lost-yesterday"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我們全家心愛的寵物橘貓昨天從陽台門溜了出去走失了。",
      "audio": {
        "src": "/audio/sentences/seeking-lost-pet-notice/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e5c000101d0335f371b559cfdd8f7712712dd83435746921edba27e471f143a0",
        "sha256": "7ededb1ace0db3d56822e69413e3538b1f4c6839d8978b48eec467eb5e4cb5c4"
      }
    },
    {
      "segments": [
        {
          "text": "We designed a clear "
        },
        {
          "text": "search ",
          "phraseIds": [
            "search-poster"
          ]
        },
        {
          "text": "poster",
          "phraseIds": [
            "search-poster"
          ],
          "wordIds": [
            "poster"
          ]
        },
        {
          "text": " with her color "
        },
        {
          "text": "photo",
          "wordIds": [
            "photo"
          ]
        },
        {
          "text": " and distinguishing physical features."
        }
      ],
      "translation": "我們設計了一張印有她彩色照片與明顯外觀特徵的清晰尋貓海報。",
      "audio": {
        "src": "/audio/sentences/seeking-lost-pet-notice/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "6aba2470faafcffc4f184710b4b4d190f8634fc29d796a413a2e403f41f8dcd6",
        "sha256": "21e7a89c9749e262093962dcf8dd8ac203da9439263a9f31d0716ddb1c1bc946"
      }
    },
    {
      "segments": [
        {
          "text": "She is wearing a "
        },
        {
          "text": "red collar with a bell",
          "phraseIds": [
            "red-collar-with-a-bell"
          ]
        },
        {
          "text": " around her neck."
        }
      ],
      "translation": "她毛茸茸的脖子上戴著一條附有小銀鈴鐺的紅色小項圈。",
      "audio": {
        "src": "/audio/sentences/seeking-lost-pet-notice/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "59d6ec7646734e8782b71bea98d87f408fb3edaeb13836b19d2cb55d5bfa71f6",
        "sha256": "9a81750e4ef5bb20961b66298764a3f9be2a9585ec5e47d1d29ab71231a6c5f9"
      }
    },
    {
      "segments": [
        {
          "text": "Please post this notice on the "
        },
        {
          "text": "community notice board",
          "phraseIds": [
            "community-notice-board"
          ]
        },
        {
          "text": " near the park gate."
        }
      ],
      "translation": "請把這份尋貓啟事張貼在公園大門旁邊的社區公告欄上。",
      "audio": {
        "src": "/audio/sentences/seeking-lost-pet-notice/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "091262dfccf47ff146c699b94ef8d9f535ed8dd4d5396e27b95c6375fb327040",
        "sha256": "265f45372dd9e6d2aba0aa6b748e5bfd6dd0b8cfaaf971603e3afc78323b11a9"
      }
    },
    {
      "segments": [
        {
          "text": "If you spot her, please "
        },
        {
          "text": "contact",
          "wordIds": [
            "contact"
          ]
        },
        {
          "text": " our family and we will offer a kind "
        },
        {
          "text": "reward",
          "wordIds": [
            "reward"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "如果有人看見她，請立即聯繫我們家人，我們會提供一份心意酬金。",
      "audio": {
        "src": "/audio/sentences/seeking-lost-pet-notice/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9e54cea15f5ce8e04b2a4643d5a67db3ac02ad6e485081216deb09e38a5167da",
        "sha256": "d3b9785cad2376e9df41238c72a1a3370a182e5c5e3e64ec484389c3388b88c6"
      }
    },
    {
      "segments": [
        {
          "text": "A kind neighbor recognized the bell sound and "
        },
        {
          "text": "safely reunited",
          "phraseIds": [
            "safely-reunited"
          ]
        },
        {
          "text": " her with our family."
        }
      ],
      "translation": "一位好心的鄰居認出了鈴鐺的聲音，讓她平安順利地回到了我們全家人的身邊。",
      "audio": {
        "src": "/audio/sentences/seeking-lost-pet-notice/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9e8c79ad4562df9c7990b1fa9c09ef418592cffead67e2bcff7019215e36d53f",
        "sha256": "3400bb724006da936e91cb4b37675a60cc802b4dbcead4a888b45308262bfd41"
      }
    }
  ]
