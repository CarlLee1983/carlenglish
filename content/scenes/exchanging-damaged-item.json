  "sentences": [
    {
      "segments": [
        {
          "text": "Hello, I bought this desk lamp yesterday, but there is a "
        },
        {
          "text": "problem",
          "wordIds": [
            "problem"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "你好，我昨天買了這台檯燈，但它好像有點問題。",
      "audio": {
        "src": "/audio/sentences/exchanging-damaged-item/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "a65845b1ef0d9c52be5a908356eb924eed049f1fa71ce0f179babd6899717243",
        "sha256": "edfc26606d03645b5dfa578e7fb295f191c992131533a7cf2cef1cdb2cd817b4"
      }
    },
    {
      "segments": [
        {
          "text": "When I plugged it into the wall socket, the switch was "
        },
        {
          "text": "not working",
          "phraseIds": [
            "not-working"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "當我插上牆壁插座時，開關完全沒有反應壞掉了。",
      "audio": {
        "src": "/audio/sentences/exchanging-damaged-item/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f9b124e5621bb0f825b834071e7046b8a0ba8b20af47cd19c274909e2402ab73",
        "sha256": "3beff09e55734c873988ae231257e276884e29eecb964ac9346664604bf60e56"
      }
    },
    {
      "segments": [
        {
          "text": "Did you "
        },
        {
          "text": "bring",
          "wordIds": [
            "bring"
          ]
        },
        {
          "text": " the "
        },
        {
          "text": "purchase ",
          "phraseIds": [
            "purchase-receipt"
          ]
        },
        {
          "text": "receipt",
          "phraseIds": [
            "purchase-receipt"
          ],
          "wordIds": [
            "receipt"
          ]
        },
        {
          "text": " and the original box?"
        }
      ],
      "translation": "請問您有帶當初購買的原店發票和商品外盒嗎？",
      "audio": {
        "src": "/audio/sentences/exchanging-damaged-item/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "06a3eccc379ecdb14227bb58ad421e6771c681ab471933c8490548f97982709c",
        "sha256": "d7c2d55bd2e455c6501ba7636960c9590e64912034b3d9799e6b006eef1f5ecc"
      }
    },
    {
      "segments": [
        {
          "text": "Yes, here is the paper "
        },
        {
          "text": "receipt",
          "wordIds": [
            "receipt"
          ]
        },
        {
          "text": " and all the accessories "
        },
        {
          "text": "inside the box",
          "phraseIds": [
            "inside-the-box"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "有的，紙本發票和盒子裡的所有配件都在這裡。",
      "audio": {
        "src": "/audio/sentences/exchanging-damaged-item/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "6a9804556498229398c6b7c3ccd3a1f41c69575127645ae3b82fd5b0f9a47d9c",
        "sha256": "801a1ed891eff4ce7f49a0ce963fba89c69709aab75ad5bb01e5402074e9e5c6"
      }
    },
    {
      "segments": [
        {
          "text": "We can "
        },
        {
          "text": "exchange",
          "phraseIds": [
            "exchange-for-a-new-one"
          ],
          "wordIds": [
            "exchange"
          ]
        },
        {
          "text": " for a ",
          "phraseIds": [
            "exchange-for-a-new-one"
          ]
        },
        {
          "text": "new",
          "phraseIds": [
            "exchange-for-a-new-one"
          ],
          "wordIds": [
            "new"
          ]
        },
        {
          "text": " one",
          "phraseIds": [
            "exchange-for-a-new-one"
          ]
        },
        {
          "text": " immediately for you."
        }
      ],
      "translation": "我們可以立刻幫您換一台全新同款的檯燈。",
      "audio": {
        "src": "/audio/sentences/exchanging-damaged-item/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "d6787014a6e7d05be37875ec420ef6ce5fa3ed2aeb8cd7d1aad09a3fb8c46944",
        "sha256": "9c241ebd7a76a95f29e7b9dcb92962b3222ff29567c3a56587abe55b4c866d07"
      }
    },
    {
      "segments": [
        {
          "text": "Let me "
        },
        {
          "text": "replace",
          "wordIds": [
            "replace"
          ]
        },
        {
          "text": " the unit and "
        },
        {
          "text": "test it right here",
          "phraseIds": [
            "test-it-right-here"
          ]
        },
        {
          "text": " to be sure."
        }
      ],
      "translation": "讓我幫您更換新品並當場進行測試，確保一切正常。",
      "audio": {
        "src": "/audio/sentences/exchanging-damaged-item/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "a523c4993f4f4831af44ca7675138da8cae8a100380e723c5169722b6ecc2a0f",
        "sha256": "c00fff5c9803bcdd2e59777f693c62c4ac4f0b7fbf6d8b9ba2e368006bfda993"
      }
    }
  ]
