  "sentences": [
    {
      "segments": [
        {
          "text": "I am registering a new online account, but I have not "
        },
        {
          "text": "received",
          "wordIds": [
            "receive"
          ]
        },
        {
          "text": " the "
        },
        {
          "text": "text ",
          "phraseIds": [
            "text-message"
          ]
        },
        {
          "text": "message",
          "phraseIds": [
            "text-message"
          ],
          "wordIds": [
            "message"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我正在註冊一個新的線上帳號，但我一直沒有收到驗證簡訊。",
      "audio": {
        "src": "/audio/sentences/resending-verification-code/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "86f0355f7159102d4b6b61c3bc6f803d336e66f06ff4e6a44eb3e38f2edffd24",
        "sha256": "0f10f2290a9ce7479aa91fb36688e9a5735ed364bd9bab01ea40dc65832e7921"
      }
    },
    {
      "segments": [
        {
          "text": "Please "
        },
        {
          "text": "check",
          "wordIds": [
            "check"
          ]
        },
        {
          "text": " if the phone number you entered is completely correct."
        }
      ],
      "translation": "請檢查看看剛才輸入的手機號碼是不是完全正確無誤。",
      "audio": {
        "src": "/audio/sentences/resending-verification-code/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "4cb0a5d3f464360ae13637524fe2867b309129cdf6f5ce814cb0b2d29a160c48",
        "sha256": "f724f4cd0abebbb730b2b4dc3b69b432462e1925392b5e960fb7b1fc3f40d328"
      }
    },
    {
      "segments": [
        {
          "text": "I "
        },
        {
          "text": "double checked",
          "phraseIds": [
            "double-checked"
          ]
        },
        {
          "text": " every single digit, and the mobile number is right."
        }
      ],
      "translation": "我每個數字都重複檢查過了，手機號碼是完全正確的。",
      "audio": {
        "src": "/audio/sentences/resending-verification-code/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e397a58068568eb48d5b89975feb9d55bdc1201cfc81084c67fb6b228de079ec",
        "sha256": "1752738d7bad0d02dfaedeb23e41df6c696f39ce383222c18a0a00a3ae1720e7"
      }
    },
    {
      "segments": [
        {
          "text": "Sometimes the automated "
        },
        {
          "text": "verification ",
          "phraseIds": [
            "verification-system"
          ]
        },
        {
          "text": "system",
          "phraseIds": [
            "verification-system"
          ],
          "wordIds": [
            "system"
          ]
        },
        {
          "text": " takes up to sixty seconds."
        }
      ],
      "translation": "有時候自動發送的驗證系統最多需要等上六十秒的時間。",
      "audio": {
        "src": "/audio/sentences/resending-verification-code/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e9c7fd1d9c1805b28e5a9c2ae21533a9412a44a0bfa7ecbbf47d3036a73caa8a",
        "sha256": "3583bb7112fab01c50245d9bf288aa8e06c300f78026c1de130838e9d8c4588e"
      }
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "countdown timer",
          "phraseIds": [
            "countdown-timer"
          ]
        },
        {
          "text": " just reached zero, so I can "
        },
        {
          "text": "click",
          "phraseIds": [
            "click-the-resend-button"
          ],
          "wordIds": [
            "click"
          ]
        },
        {
          "text": " the resend button",
          "phraseIds": [
            "click-the-resend-button"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "倒數計時器剛好歸零了，所以我現在可以點擊重新發送的按鈕。",
      "audio": {
        "src": "/audio/sentences/resending-verification-code/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c3e03e86ab2c0af97b873ec9631d781d0241aa6d9587ea9d3f5443b1a8767bdc",
        "sha256": "a8f345c9e99a8b92eb282214e689f0587c9777e05c88309200e7f5c4d19bb2bb"
      }
    },
    {
      "segments": [
        {
          "text": "The new six-digit "
        },
        {
          "text": "code",
          "wordIds": [
            "code"
          ]
        },
        {
          "text": " arrived instantly on my phone screen."
        }
      ],
      "translation": "新的六位數驗證碼立刻跳出顯示在我手機螢幕上了。",
      "audio": {
        "src": "/audio/sentences/resending-verification-code/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "a030315d54d10c29b04bc0866371379642bb891aa004854c8204730a48b8b97c",
        "sha256": "17945bc0cbf94c4c72b9e51d880a1d72dc85db34051da3ac0987a984fcf872ff"
      }
    }
  ]
