  "sentences": [
    {
      "segments": [
        {
          "text": "My phone "
        },
        {
          "text": "battery",
          "wordIds": [
            "battery"
          ]
        },
        {
          "text": " is extremely "
        },
        {
          "text": "low",
          "wordIds": [
            "low"
          ]
        },
        {
          "text": " and "
        },
        {
          "text": "down to three percent",
          "phraseIds": [
            "down-to-three-percent"
          ]
        },
        {
          "text": " right now."
        }
      ],
      "translation": "我的手機電量極低，現在掉到只剩下百分之三了。",
      "audio": {
        "src": "/audio/sentences/borrowing-power-bank/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "6c6fa305871d21816fab20fdc5d7bd9c2e6436464f0aa3c30ed4540f830e1767",
        "sha256": "52c5fd0699eaa5bec1bf1b9dff17495143c18a6f488231d17dd16d7126c53e99"
      }
    },
    {
      "segments": [
        {
          "text": "If my "
        },
        {
          "text": "phone dies",
          "phraseIds": [
            "phone-dies"
          ]
        },
        {
          "text": ", I will not be able to contact my parents."
        }
      ],
      "translation": "如果我手機沒電關機的話，我就沒辦法聯絡我的父母了。",
      "audio": {
        "src": "/audio/sentences/borrowing-power-bank/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "a1f334829b5562e71ad12fbbc3d7d81aee3e02d2cdd5fdab9eb6ebd526ce663d",
        "sha256": "63a2e6faa65e78de4374bb5fb4bd109999ad011656d0faffff2a48538aaeb402"
      }
    },
    {
      "segments": [
        {
          "text": "Do not panic, I have a fully charged "
        },
        {
          "text": "portable ",
          "phraseIds": [
            "portable-power-bank"
          ]
        },
        {
          "text": "power",
          "phraseIds": [
            "portable-power-bank"
          ],
          "wordIds": [
            "power"
          ]
        },
        {
          "text": " bank",
          "phraseIds": [
            "portable-power-bank"
          ]
        },
        {
          "text": " with me."
        }
      ],
      "translation": "別慌張，我身上剛好帶著一顆充飽電的行動電源。",
      "audio": {
        "src": "/audio/sentences/borrowing-power-bank/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ce6a1c9bb0f3fe5b76adbcbd89a5fe4a5749210a22aa8f3de88dfd6b9ddb9260",
        "sha256": "3f807e5514545c8788729018fb7b2be34b5585b370fc0d8c976eba95c551f717"
      }
    },
    {
      "segments": [
        {
          "text": "Do you have a "
        },
        {
          "text": "charging",
          "phraseIds": [
            "charging-cable"
          ],
          "wordIds": [
            "charge"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "cable",
          "phraseIds": [
            "charging-cable"
          ],
          "wordIds": [
            "cable"
          ]
        },
        {
          "text": " that matches my phone socket?"
        }
      ],
      "translation": "你有符合我手機插孔規格的充電連接線嗎？",
      "audio": {
        "src": "/audio/sentences/borrowing-power-bank/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "3622b20b3a462f5bbcce7067429a967a5b5c76631a6f290329645c80377b7c65",
        "sha256": "d7595e9083fae3dd9d739b658d1730bf7f0f5344ddde00543d3006e22fce7e1b"
      }
    },
    {
      "segments": [
        {
          "text": "Yes, "
        },
        {
          "text": "plug",
          "phraseIds": [
            "plug-this-white-cable-into"
          ],
          "wordIds": [
            "plug"
          ]
        },
        {
          "text": " this white ",
          "phraseIds": [
            "plug-this-white-cable-into"
          ]
        },
        {
          "text": "cable",
          "phraseIds": [
            "plug-this-white-cable-into"
          ],
          "wordIds": [
            "cable"
          ]
        },
        {
          "text": " into",
          "phraseIds": [
            "plug-this-white-cable-into"
          ]
        },
        {
          "text": " the bottom port of your phone."
        }
      ],
      "translation": "有的，把這條白色充電線插進你手機底部的充電孔就行了。",
      "audio": {
        "src": "/audio/sentences/borrowing-power-bank/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "fe550df1e95b11e3c503c09097adaa276be975cd460eabc3d45af32df312da8c",
        "sha256": "fcb7fb2841c4dedbdb4b69cb50eaa0c36e6ca65747fcf62aa05133402bd8aedc"
      }
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "charging",
          "wordIds": [
            "charge"
          ]
        },
        {
          "text": " lightning icon appeared, thank you for saving my day!"
        }
      ],
      "translation": "充電的閃電圖示跳出來了，太感謝你及時救了我一命！",
      "audio": {
        "src": "/audio/sentences/borrowing-power-bank/6.mp3",
