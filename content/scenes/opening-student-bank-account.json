  "sentences": [
    {
      "segments": [
        {
          "text": "Good morning, I want to open a "
        },
        {
          "text": "student savings account",
          "phraseIds": [
            "student-savings-account"
          ]
        },
        {
          "text": " to "
        },
        {
          "text": "save",
          "wordIds": [
            "save"
          ]
        },
        {
          "text": " money today."
        }
      ],
      "translation": "早安，我今天想要開立一個學生儲蓄帳戶來存錢。",
      "audio": {
        "src": "/audio/sentences/opening-student-bank-account/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "8344d9d2252be06f506b83638e24a36f3c06d9bde2e7e42ce84aba1f3304ce69",
        "sha256": "62d5f14cccf1b1cb67348239edc49e852f93bab7bf6b9487381b762cc0240e3f"
      }
    },
    {
      "segments": [
        {
          "text": "Please provide your "
        },
        {
          "text": "photo identification card",
          "phraseIds": [
            "photo-identification-card"
          ]
        },
        {
          "text": " and a "
        },
        {
          "text": "written signature",
          "phraseIds": [
            "written-signature"
          ]
        },
        {
          "text": " consent form from your "
        },
        {
          "text": "parents",
          "wordIds": [
            "parent"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "請出示您的照片身分證件，以及一份有父母親親筆簽名的同意書。",
      "audio": {
        "src": "/audio/sentences/opening-student-bank-account/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ff00e8f1df20952f731a66a6c912d6dd07328aa4bb2f8b742a564eab34bfb7af",
        "sha256": "f3cf3474ee2665d5d83eb93846f24e1c42409dd82c49dd01f88dfe845db9101d"
      }
    },
    {
      "segments": [
        {
          "text": "Here are all the legal documents and our family household certificate."
        }
      ],
      "translation": "這些是所有的法定證件文件，還有我們家的戶口名簿。",
      "audio": {
        "src": "/audio/sentences/opening-student-bank-account/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "731c0baa1765b7ac5b6eff529cd6ea0ee08fbc496ad05f66a67e1477e08a95e9",
        "sha256": "75c7c1e7b0fb23a3c97c9a4ee91cc2dd1c4169bca51edc13803cdfe6f4ff7adf"
      }
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "bank",
          "phraseIds": [
            "bank-staff"
          ],
          "wordIds": [
            "bank"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "staff",
          "phraseIds": [
            "bank-staff"
          ],
          "wordIds": [
            "staff"
          ]
        },
        {
          "text": " helped me fill out the registration form line by line."
        }
      ],
      "translation": "銀行行員非常親切地協助我一行一行填寫開戶登記表單。",
      "audio": {
        "src": "/audio/sentences/opening-student-bank-account/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c09f5f4679f6775e7faa0650530c9558cbaa25ee8c7c9532c9ba511c793a27b5",
        "sha256": "97c8ee7a3a6d64f44ff610b18fff5691b7c43cf07f37bc1de84135f07c339b3e"
      }
    },
    {
      "segments": [
        {
          "text": "You can make an "
        },
        {
          "text": "initial ",
          "phraseIds": [
            "initial-deposit"
          ]
        },
        {
          "text": "deposit",
          "phraseIds": [
            "initial-deposit"
          ],
          "wordIds": [
            "deposit"
          ]
        },
        {
          "text": " of five hundred dollars into your new account."
        }
      ],
      "translation": "您可以在您剛辦好的新帳戶中存入第一筆五百元的開戶存款。",
      "audio": {
        "src": "/audio/sentences/opening-student-bank-account/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "3feb0f29dfbc3a9ceed054bb16002dbeccc9d38f5b1abf9c9e1b5fd024d63a45",
        "sha256": "415d52c4f945e530900bd9c727d1d5ce41b4422369930594af8a9728d4c07090"
      }
    },
    {
      "segments": [
        {
          "text": "This savings account earns yearly "
        },
        {
          "text": "interest",
          "wordIds": [
            "interest"
          ]
        },
        {
          "text": " and includes a debit card for payments."
        }
      ],
      "translation": "這個儲蓄帳戶每年可以賺取利息收益，並且附帶一張可消費付款的金融卡。",
      "audio": {
        "src": "/audio/sentences/opening-student-bank-account/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "566f1c8ca27c1edd552742b49dfcc1684a94d353f4895b6e3613c390d6a2b170",
        "sha256": "cb0ed779153c0f2d80009ffa7319ec3ff9cd76f5f5222f60895c539e37bc4071"
      }
    }
  ]
