        "sha256": "b90af2ec858f64c70e47a10c7e14d30e4ef02f4a29673f9eed34b0a559db34f9"
      }
    },
    {
      "segments": [
        {
          "text": "Our team is trailing by just two points "
        },
        {
          "text": "on the electronic scoreboard",
          "phraseIds": [
            "on-the-electronic-scoreboard"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "在電子記分板上，我們隊伍只落後僅僅兩分而已。",
      "audio": {
        "src": "/audio/sentences/sports-match-cheering/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "7a523798ccc92be07b597e587380bd46fb29738ca3205a93544ac21283a526a4",
        "sha256": "18dc2d1f56c49d036bf0210c5ff547750d4f90e58e3aabf78c1eb32d25b57aeb"
      }
    },
    {
      "segments": [
        {
          "text": "Number seven made a fantastic pass, and the center "
        },
        {
          "text": "scored",
          "wordIds": [
            "score"
          ]
        },
        {
          "text": " a thrilling goal!"
        }
      ],
      "translation": "七號球員做出了絕妙的傳球，中鋒隨即投進了激動人心的一球！",
      "audio": {
        "src": "/audio/sentences/sports-match-cheering/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "13bc870b6d8c8ae0ac7760d4c852c17def16decc95799f1542592c4abae68d48",
        "sha256": "f133fcb00349d4b0c8a4647896a32292c68091b78c6da1aa8ecf00a84c03ff72"
      }
    },
    {
      "segments": [
        {
          "text": "Every player on the court showed incredible defensive "
        },
        {
          "text": "action",
          "wordIds": [
            "action"
          ]
        },
        {
          "text": " in the final minute."
        }
      ],
      "translation": "場上的每一位球員在最後一分鐘都展現了驚人的防守行動。",
      "audio": {
        "src": "/audio/sentences/sports-match-cheering/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "8ad46ea319f312b7b64a5b8fd61b7091abac4ac6d9ec63bb9bd3bdbc865cf357",
        "sha256": "970d66e30d914727e95d6cdba6f1de5ec45bfc83b087e748f6711042230478c4"
      }
    },
    {
      "segments": [
        {
          "text": "Everyone stood up and shouted "
        },
        {
          "text": "loud",
          "wordIds": [
            "loud"
          ]
        },
        {
          "text": " cheers as our team "
        },
        {
          "text": "took the ",
          "phraseIds": [
            "took-the-lead"
          ]
        },
        {
          "text": "lead",
          "phraseIds": [
            "took-the-lead"
          ],
          "wordIds": [
            "lead"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "當我們隊伍取得領先時，全場所有人都站了起來發出響亮的歡呼！",
      "audio": {
        "src": "/audio/sentences/sports-match-cheering/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "427df01072779206c4196b95394220fdd82c97e373fd122f8005fbb14250df32",
        "sha256": "980f9aa1764ac942c06e21991b5fcf7e1f998b431fddfe085a90e62509ada092"
      }
    },
    {
      "segments": [
        {
          "text": "With great effort and collective determination, our classmates celebrated a "
        },
        {
          "text": "proud ",
          "phraseIds": [
            "proud-win"
          ]
        },
        {
          "text": "win",
          "phraseIds": [
            "proud-win"
          ],
          "wordIds": [
            "win"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "憑藉著巨大的努力與團隊決心，同學們歡欣慶祝了一場驕傲的勝利。",
      "audio": {
