  "sentences": [
    {
      "segments": [
        {
          "text": "The basketball gym is completely packed with students "
        },
        {
          "text": "cheering for our ",
          "phraseIds": [
            "cheering-for-our-school"
          ]
        },
        {
          "text": "school",
