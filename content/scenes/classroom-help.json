{
  "id": "classroom-help",
  "title": "課堂借物與求助",
  "titleEn": "Borrowing a Pencil in Class",
  "category": "校園生活",
  "level": "入門",
  "image": {
    "src": "/images/scenes/classroom-help.webp",
    "alt": "在陽光明亮的教室裡，小男孩坐在書桌前向鄰座的女同學借鉛筆，女同學面帶微笑親切地遞給他鉛筆，講臺前的老師溫柔地微笑注視著他們。",
    "width": 1536,
    "height": 1024
  },
  "sentences": [
    {
      "segments": [
        {
          "text": "Leo looks at his "
        },
        {
          "text": "desk",
          "wordIds": [
            "desk"
          ]
        },
        {
          "text": ", but he only has an "
        },
        {
          "text": "eraser",
          "wordIds": [
            "eraser"
          ]
        },
        {
          "text": " and a "
        },
        {
          "text": "ruler",
          "wordIds": [
            "ruler"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "Leo 看著書桌，但他只有一個橡皮擦和一把尺。"
    },
    {
      "segments": [
        {
          "text": "He forgot his "
        },
        {
          "text": "pencil",
          "wordIds": [
            "pencil"
          ]
        },
        {
          "text": " and turns to his "
        },
        {
          "text": "classmate",
          "wordIds": [
            "classmate"
          ]
        },
        {
          "text": " Mia for help."
        }
      ],
      "translation": "他忘了帶鉛筆，便轉向同學 Mia 求助。"
    },
    {
      "segments": [
        {
          "text": "Leo asks politely, “"
        },
        {
          "text": "Can I borrow a ",
          "phraseIds": [
            "can-i-borrow-a-pencil"
          ]
        },
        {
          "text": "pencil",
          "phraseIds": [
            "can-i-borrow-a-pencil"
          ],
          "wordIds": [
            "pencil"
          ]
        },
        {
          "text": "?",
          "phraseIds": [
            "can-i-borrow-a-pencil"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Leo 有禮貌地問：「我可以借一枝鉛筆嗎？」"
    },
    {
      "segments": [
        {
          "text": "Mia smiles warmly and says, “"
        },
        {
          "text": "Here you are.",
          "phraseIds": [
            "here-you-are"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Mia 親切地微笑著說：「這給你。」"
    },
    {
      "segments": [
        {
          "text": "Leo takes the "
        },
        {
          "text": "pencil",
          "wordIds": [
            "pencil"
          ]
        },
        {
          "text": " and says, “"
        },
        {
          "text": "Thank you very much.",
          "phraseIds": [
            "thank-you-very-much"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Leo 接過鉛筆並說：「非常謝謝你。」"
    },
    {
      "segments": [
        {
          "text": "Mia answers with a friendly smile, “"
        },
        {
          "text": "You're welcome.",
          "phraseIds": [
            "youre-welcome"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Mia 帶著友善的微笑回答：「不客氣。」"
    },
    {
      "segments": [
        {
          "text": "Their "
        },
        {
          "text": "teacher",
          "wordIds": [
            "teacher"
          ]
        },
        {
          "text": " smiles at them and starts the lesson."
        }
      ],
      "translation": "他們的老師對著他們微笑，並開始上課。"
    }
  ],
