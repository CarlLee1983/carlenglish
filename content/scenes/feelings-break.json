    "width": 1536,
    "height": 1024
  },
  "sentences": [
    {
      "segments": [
        {
          "text": "Mei feels "
        },
        {
          "text": "upset",
          "wordIds": [
            "upset"
          ]
        },
        {
          "text": " about her "
        },
        {
          "text": "drawing",
          "wordIds": [
            "drawing"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "小美對自己的畫有點懊惱。",
      "audio": {
        "src": "/audio/sentences/feelings-break/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9aabc758200ab88a5d623e8e94f6a037331f687a6424f7e139c5db0f45bcce1a",
        "sha256": "56554eb24c3cad5b8f6415ed33fb2b71a1cf5c0a373f972cd90886c8760f2d64"
      }
    },
    {
      "segments": [
        {
          "text": "She tells her "
        },
        {
          "text": "friend",
          "wordIds": [
            "friend"
          ]
        },
        {
          "text": ", “"
        },
        {
          "text": "I need a ",
          "phraseIds": [
            "i-need-a-break"
          ]
        },
        {
          "text": "break",
          "phraseIds": [
            "i-need-a-break"
          ],
          "wordIds": [
            "break"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "i-need-a-break"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "她告訴朋友：「我需要休息一下。」",
      "audio": {
        "src": "/audio/sentences/feelings-break/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "48902b56238a1d51fcf907e33466abff976bb8b5e6cfbb141febda0629b1c56e",
        "sha256": "4cfcda160981f29d2b8d99c2bfb0b1b88ec117b4f8ca85cbb92751c6f521704a"
      }
    },
    {
      "segments": [
        {
          "text": "Her "
        },
        {
          "text": "friend",
          "wordIds": [
            "friend"
          ]
        },
        {
          "text": " says, “"
        },
        {
          "text": "Take your time.",
          "phraseIds": [
            "take-your-time"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "她的朋友說：「慢慢來。」",
      "audio": {
        "src": "/audio/sentences/feelings-break/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9e600e529e57c311c7d0659e22ad223a83c4b55c75d81505e5038cadf348ccba",
        "sha256": "f48ae0a7c9c269ca23e238fc055d7b5dff1624d203a783898853dd9a298c1008"
      }
    },
    {
      "segments": [
        {
          "text": "Mei puts down her "
        },
        {
          "text": "crayon",
          "wordIds": [
            "crayon"
          ]
        },
        {
          "text": " and breathes "
        },
        {
          "text": "slowly",
          "wordIds": [
            "slowly"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "小美放下蠟筆，慢慢呼吸。",
      "audio": {
        "src": "/audio/sentences/feelings-break/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "b5edad854f71726114afeddb0ba09afbbf704bbc20a0f45eb97dd0b0f98b7f39",
        "sha256": "c1df8b44b0effff14094b1f1b6bceb081972e7a45314237f1149469502147e06"
      }
    },
    {
      "segments": [
        {
          "text": "Later, Mei says, “"
        },
        {
          "text": "I am ready now.",
          "phraseIds": [
            "i-am-ready-now"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "過了一會兒，小美說：「我現在準備好了。」",
      "audio": {
        "src": "/audio/sentences/feelings-break/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9d14f3a0c72d2dfe897e10347322dc35061ccff697d9192ef43750ba75dfe9f5",
        "sha256": "dcca63a0bec8fcfdfca4a948eb43a9ae813ac5b5388430080c448e8322a94a6e"
      }
    },
    {
      "segments": [
        {
          "text": "They sit together, and Mei "
        },
        {
          "text": "tries again",
          "phraseIds": [
            "tries-again"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "他們坐在一起，小美再試一次。",
      "audio": {
        "src": "/audio/sentences/feelings-break/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9e67a029b07e1d4be01d19334c30f09316c706a1a2ee42cad554983b385411a3",
