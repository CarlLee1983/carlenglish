{
  "id": "playground-turns",
  "title": "操場輪流玩",
  "titleEn": "Taking Turns on the Playground",
  "category": "校園活動",
  "level": "入門",
  "image": {
    "src": "/images/scenes/playground-turns.webp",
    "alt": "下課時的校園操場上，小學生們在紅色溜滑梯旁乖乖排隊輪流玩耍，旁邊有盪鞦韆與草地，大家都笑得很開心。",
    "width": 1536,
    "height": 1024
  },
  "sentences": [
    {
      "segments": [
        {
          "text": "The children have fun together on the "
        },
        {
          "text": "playground",
          "wordIds": [
            "playground"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "孩子們在學校操場上一起開心地玩耍。"
    },
    {
      "segments": [
        {
          "text": "Amy swings high on the "
        },
        {
          "text": "swing",
          "wordIds": [
            "swing"
          ]
        },
        {
          "text": ", and Leo walks to the big "
        },
        {
          "text": "slide",
          "wordIds": [
            "slide"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "Amy 在鞦韆上盪得很高，Leo 則走向大溜滑梯。"
    },
    {
      "segments": [
        {
          "text": "Leo smiles at Mia and asks, “"
        },
        {
          "text": "Can I play too?",
          "phraseIds": [
            "can-i-play-too"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Leo 對著 Mia 微笑並問：「我也可以一起玩嗎？」"
    },
    {
      "segments": [
        {
          "text": "Mia nods and says, “Yes! "
        },
        {
          "text": "Let's wait in ",
          "phraseIds": [
            "lets-wait-in-line"
          ]
        },
        {
          "text": "line",
          "phraseIds": [
            "lets-wait-in-line"
          ],
          "wordIds": [
            "line"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "lets-wait-in-line"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Mia 點點頭說：「好啊！我們一起排隊吧。」"
    },
    {
      "segments": [
        {
          "text": "Leo waits patiently and asks, “"
        },
        {
          "text": "Is it my ",
          "phraseIds": [
            "is-it-my-turn"
          ]
        },
        {
          "text": "turn",
          "phraseIds": [
            "is-it-my-turn"
          ],
          "wordIds": [
            "turn"
          ]
        },
        {
          "text": "?",
          "phraseIds": [
            "is-it-my-turn"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Leo 耐心地排隊等待，並問：「輪到我了嗎？」"
    },
    {
      "segments": [
        {
          "text": "Mia smiles and says, “"
        },
        {
          "text": "It's your ",
          "phraseIds": [
            "its-your-turn-now"
          ]
        },
        {
          "text": "turn",
          "phraseIds": [
            "its-your-turn-now"
          ],
          "wordIds": [
            "turn"
          ]
        },
        {
          "text": " now.",
          "phraseIds": [
            "its-your-turn-now"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Mia 微笑著說：「現在輪到你了。」"
    },
    {
      "segments": [
        {
          "text": "Leo slides down the "
        },
        {
          "text": "slide",
          "wordIds": [
            "slide"
          ]
        },
        {
          "text": ", and the children are "
        },
        {
          "text": "happy",
          "wordIds": [
            "happy"
          ]
        },
        {
          "text": " to play together."
        }
      ],
      "translation": "Leo 從溜滑梯滑下來，孩子們很開心能一起玩耍。"
    }
  ],
