          "wordIds": [
            "duck"
          ]
        },
        {
          "text": " swims past the "
        },
        {
          "text": "fish",
          "wordIds": [
            "fish"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "一隻鴨子游過魚的旁邊。",
      "audio": {
        "src": "/audio/sentences/pond-watch/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
