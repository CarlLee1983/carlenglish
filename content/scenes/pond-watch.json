      }
    },
    {
      "segments": [
        {
          "text": "“One is "
        },
        {
          "text": "orange",
          "wordIds": [
            "orange"
          ]
        },
        {
          "text": ",” he says to Dad."
        }
      ],
      "translation": "他對爸爸說：「其中一條是橘色的。」",
      "audio": {
        "src": "/audio/sentences/pond-watch/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ab9a3e766ec26484b4b75731c7f471c253f5cffb1b5467d65682cc37534397c5",
