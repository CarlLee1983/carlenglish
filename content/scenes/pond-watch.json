      }
    },
    {
      "segments": [
        {
          "text": "Bo sees two "
        },
        {
          "text": "fish",
          "wordIds": [
            "fish"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "under the ",
          "phraseIds": [
            "under-the-water"
          ]
        },
        {
          "text": "water",
          "phraseIds": [
            "under-the-water"
          ],
          "wordIds": [
            "water"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "小柏看見水裡有兩條魚。",
      "audio": {
        "src": "/audio/sentences/pond-watch/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
