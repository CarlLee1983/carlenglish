  "sentences": [
    {
      "segments": [
        {
          "text": "Welcome to Burger Corner, "
        },
        {
          "text": "what combo meal",
          "phraseIds": [
            "what-combo-meal"
          ]
        },
        {
          "text": " would you like?"
        }
      ],
      "translation": "歡迎光臨漢堡小館，今天想點幾號套餐呢？",
      "audio": {
        "src": "/audio/sentences/fast-food-combo/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "034a5e3ecf59eafa497e92d3926e8afc757461c8b1157c539a7cf56524ce2a7a",
        "sha256": "8d7cf23694fcb0682e6959598e11b07cbdbc9765bcfe400b6010207da53f8849"
      }
    },
    {
      "segments": [
        {
          "text": "I want number three, but can I "
        },
        {
          "text": "change",
          "phraseIds": [
            "change-the-side-dish"
          ],
          "wordIds": [
            "change"
          ]
        },
        {
          "text": " the ",
          "phraseIds": [
            "change-the-side-dish"
          ]
        },
        {
          "text": "side",
          "phraseIds": [
            "change-the-side-dish"
          ],
          "wordIds": [
            "side"
          ]
        },
        {
          "text": " dish",
          "phraseIds": [
            "change-the-side-dish"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "我想點三號餐，但我可以更換附餐嗎？",
      "audio": {
        "src": "/audio/sentences/fast-food-combo/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f3ed6af2ff303a528d9c712c979b609eee1a472eac759139fcece6a1cdb24d6f",
        "sha256": "d11d7e65b68bfe6c19891efd184e4c42080ed14b8976e869690e899066efb71b"
      }
    },
    {
      "segments": [
        {
          "text": "You can choose hot soup or fresh salad "
        },
        {
          "text": "instead of fries",
          "phraseIds": [
            "instead-of-fries"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "您可以選擇熱湯或生菜沙拉來代替薯條。",
      "audio": {
        "src": "/audio/sentences/fast-food-combo/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "112f0bc642a803f271defdd9c0fe3dff32a3b274b65930b7f46d8bd2b21ef30a",
        "sha256": "a95eb390f0404d30d6f10010217706ad2eb2e570c68bf5321d845210be0ff27f"
      }
    },
    {
      "segments": [
        {
          "text": "I will take the salad, and what about the drink "
        },
        {
          "text": "size",
          "wordIds": [
            "size"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "那我要沙拉，請問飲料有分大小嗎？",
      "audio": {
        "src": "/audio/sentences/fast-food-combo/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "099add9ed7eeb7fd8e46431d2fc0ff1a16bbd3d2869c2639013ad1a73447c4f7",
        "sha256": "8811bd790961ab0bab6aafc9e3cb535a1ccb6021fe86c0d218c3968ada06231c"
      }
    },
    {
      "segments": [
        {
          "text": "You can upgrade to a "
        },
        {
          "text": "large",
          "wordIds": [
            "large"
          ]
        },
        {
          "text": " cup "
        },
        {
          "text": "for an ",
          "phraseIds": [
            "for-an-extra-dollar"
          ]
        },
        {
          "text": "extra",
          "phraseIds": [
            "for-an-extra-dollar"
          ],
          "wordIds": [
            "extra"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "dollar",
          "phraseIds": [
            "for-an-extra-dollar"
          ],
          "wordIds": [
            "dollar"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "只要多加一元，就可以升級成大杯飲料。",
      "audio": {
        "src": "/audio/sentences/fast-food-combo/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e44ef4e40fbf4d015f771e5422651f3287d9f92699899ef55fe5c4d64b5ed8f8",
        "sha256": "e0df575e244427b641f02b1944d05be8c25218896f945645ec142fa8d0bff1d4"
      }
    },
    {
      "segments": [
        {
          "text": "That "
        },
        {
          "text": "sounds great",
          "phraseIds": [
            "sounds-great"
          ]
        },
        {
          "text": ", I will take the "
        },
        {
          "text": "large",
          "wordIds": [
            "large"
          ]
        },
        {
          "text": " iced green tea."
        }
      ],
      "translation": "聽起來很棒，那我要大杯冰綠茶。",
      "audio": {
        "src": "/audio/sentences/fast-food-combo/6.mp3",
