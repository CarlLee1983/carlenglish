{
  "id": "cafe-breakfast",
  "title": "咖啡店買早餐",
  "titleEn": "Breakfast at the café",
  "category": "飲食",
  "level": "初級",
  "image": {
    "src": "/images/scenes/cafe-breakfast.webp",
    "alt": "早晨的咖啡店裡，Mia 在櫃檯向店員點外帶早餐，檯面上有咖啡紙杯與裝著吐司的紙袋。",
    "width": 1536,
    "height": 1024
  },
  "sentences": [
    {
      "segments": [
        {
          "text": "On a sunny morning, Mia stops at a small "
        },
        {
          "text": "café",
          "wordIds": [
            "cafe"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "晴朗的早晨，Mia 來到一間小咖啡店。"
    },
    {
      "segments": [
        {
          "text": "She looks at the "
        },
        {
          "text": "menu",
          "wordIds": [
            "menu"
          ]
        },
        {
          "text": " and says, “"
        },
        {
          "text": "I'd like a ",
          "phraseIds": [
            "id-like"
          ]
        },
        {
          "text": "coffee",
          "phraseIds": [
            "id-like"
          ],
          "wordIds": [
            "coffee"
          ]
        },
        {
          "text": " and some "
        },
        {
          "text": "toast",
          "wordIds": [
            "toast"
          ]
        },
        {
          "text": ", please.”"
        }
      ],
      "translation": "她看著菜單說：「我想要一杯咖啡和一些吐司，謝謝。」"
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "barista",
          "wordIds": [
            "barista"
          ]
        },
        {
          "text": " asks, “"
        },
        {
          "text": "For here or to go?",
          "phraseIds": [
            "for-here-or-to-go"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "咖啡師問：「內用還是外帶？」"
    },
    {
      "segments": [
        {
          "text": "“"
        },
        {
          "text": "To go, please",
          "phraseIds": [
            "to-go"
          ]
        },
        {
          "text": ",” Mia says."
        }
      ],
      "translation": "Mia 說：「外帶，謝謝。」"
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "barista",
          "wordIds": [
            "barista"
          ]
        },
        {
          "text": " puts her "
        },
        {
          "text": "toast",
          "wordIds": [
            "toast"
          ]
        },
        {
          "text": " in a paper "
        },
        {
          "text": "bag",
          "wordIds": [
            "bag"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "咖啡師把她的吐司放進紙袋裡。"
    },
    {
      "segments": [
        {
          "text": "“"
        },
        {
          "text": "How much is it?",
          "phraseIds": [
            "how-much"
          ]
        },
        {
          "text": "” Mia asks at the "
        },
        {
          "text": "counter",
          "wordIds": [
            "counter"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "Mia 在櫃檯問：「多少錢？」"
    },
    {
      "segments": [
        {
          "text": "“Five dollars,” the "
        },
        {
          "text": "barista",
          "wordIds": [
            "barista"
          ]
        },
        {
          "text": " says."
        }
      ],
      "translation": "咖啡師說：「五元。」"
    },
    {
      "segments": [
        {
          "text": "Mia pays, takes her "
        },
        {
          "text": "breakfast",
          "wordIds": [
            "breakfast"
          ]
        },
        {
          "text": ", and says, “"
        },
        {
          "text": "Thank you!",
          "phraseIds": [
            "thank-you"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Mia 付了錢，拿起早餐，並說：「謝謝你！」"
    }
  ],
