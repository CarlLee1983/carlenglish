  "sentences": [
    {
      "segments": [
        {
          "text": "Bo sits with Mom beside a "
        },
        {
          "text": "tablet",
          "wordIds": [
            "tablet"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "小柏和媽媽一起坐在平板電腦旁。",
      "audio": {
        "src": "/audio/sentences/video-call-grandma/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "d9de983684d2d44bbb93b9e2f5350f13d34a0884f36641b578ea807efed73857",
        "sha256": "e10fac48d4ed9eb45542cf0b2fb02528aef0e8f08f06c579ad95d9e3a6a79c4e"
      }
    },
    {
      "segments": [
        {
          "text": "Grandma",
          "wordIds": [
            "grandma"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "waves",
          "wordIds": [
            "waves"
          ]
        },
        {
          "text": " from the "
        },
        {
          "text": "screen",
          "wordIds": [
            "screen"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "阿嬤在螢幕裡揮手。",
      "audio": {
        "src": "/audio/sentences/video-call-grandma/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "1417e9ddf44361f4a881a6b997e36511384764c42f64d7ce90e1bc3beddc6b9d",
        "sha256": "0eac34910337a304ecf12a2097023619ecdf39d8407d9486cb705b2259874cca"
      }
    },
    {
      "segments": [
        {
          "text": "“Hello, "
        },
        {
          "text": "Grandma",
          "wordIds": [
            "grandma"
          ]
        },
        {
          "text": "! "
        },
        {
          "text": "Can you hear me",
          "phraseIds": [
            "can-you-hear-me"
          ]
        },
        {
          "text": "?” asks Bo."
        }
      ],
      "translation": "小柏問：「阿嬤你好！你聽得到我嗎？」",
      "audio": {
        "src": "/audio/sentences/video-call-grandma/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "cd206d84d83314d61f4777b148b515d0d53fe21981fa26bc59568a1595bd5cba",
        "sha256": "c39a45851ee83d1dcda9c6b8dd72e62cd51926a287a00143883dc03f0390d5f1"
      }
    },
    {
      "segments": [
        {
          "text": "“"
        },
        {
          "text": "Yes, I can",
          "phraseIds": [
            "yes-i-can"
          ]
        },
        {
          "text": ",” she says with a smile."
        }
      ],
      "translation": "她微笑著說：「對，我聽得到。」",
      "audio": {
        "src": "/audio/sentences/video-call-grandma/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f09176b6b48a2d870835d4df7cfdd6615c34c3d2c3500d39f906b463bf80d936",
        "sha256": "2f9ce50ba12c29bcecb0aad34c88e2a593fe6e7a77d7e139f0772599bd8f17ea"
      }
    },
    {
      "segments": [
        {
          "text": "Bo "
        },
        {
          "text": "holds up",
          "phraseIds": [
            "holds-up"
          ]
        },
        {
          "text": " his "
        },
        {
          "text": "drawing",
          "wordIds": [
            "drawing"
          ]
        },
        {
          "text": " of a "
        },
        {
          "text": "cat",
          "wordIds": [
            "cat"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "小柏舉起他畫的小貓圖畫。",
      "audio": {
        "src": "/audio/sentences/video-call-grandma/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "3aee287e91b1004ca95f3760c113b2947ca8f4e5abd307926bec3959c49f9b8d",
        "sha256": "3d2f747b869ac29f074177d0c1397fc93e1ebea11a9251be49d7a20281ab7d70"
      }
    },
    {
      "segments": [
        {
          "text": "“"
        },
        {
          "text": "Look at my ",
          "phraseIds": [
            "look-at-my-cat"
          ]
        },
        {
          "text": "cat",
          "phraseIds": [
            "look-at-my-cat"
          ],
          "wordIds": [
            "cat"
          ]
        },
        {
          "text": "!” he says."
        }
      ],
      "translation": "他說：「看看我畫的小貓！」",
