  "sentences": [
    {
      "segments": [
        {
          "text": "Mei "
        },
        {
          "text": "dips",
          "wordIds": [
            "dips"
          ]
        },
        {
          "text": " a "
        },
        {
          "text": "wand",
          "wordIds": [
            "wand"
          ]
        },
        {
          "text": " into the "
        },
        {
          "text": "bubble mix",
          "phraseIds": [
            "bubble-mix"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "小美把吹泡泡棒浸入泡泡水裡。",
      "audio": {
        "src": "/audio/sentences/park-bubbles/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "7a815376270598a21d4f2c1de02d5d822d91e0a09098655b0eb7aeb7f2c3e366",
        "sha256": "e082604191b661224bfde9bb6a3948a1d3966a3005c852586d6dc045c4b0bac9"
      }
    },
    {
      "segments": [
        {
          "text": "She "
        },
        {
          "text": "blows gently",
          "phraseIds": [
            "blows-gently"
          ]
        },
        {
          "text": " and makes small "
        },
        {
          "text": "bubbles",
          "wordIds": [
            "bubbles"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "她輕輕地吹，吹出小泡泡。",
      "audio": {
        "src": "/audio/sentences/park-bubbles/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "329788563cd7a6c4dccc59baaad4f3c00a9051cee2cc29f7c4711c73a1d392b5",
        "sha256": "09c341b3e2238734f45500e0402221730242325ca3c0927066fb1f30633a6998"
      }
    },
    {
      "segments": [
        {
          "text": "“"
        },
        {
          "text": "Can I try",
          "phraseIds": [
            "can-i-try"
          ]
        },
        {
          "text": "?” asks her "
        },
        {
          "text": "brother",
          "wordIds": [
            "brother"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "弟弟問：「我可以試試看嗎？」",
      "audio": {
        "src": "/audio/sentences/park-bubbles/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "7a8855aa5d41ae58d59253928f7263b2a4cfec0b885a8f0ce691ae6ac647b335",
        "sha256": "30dcf3ffa880ca71a77a6990e6c411e6cc2c0714724e01451d1cc466e43eef30"
      }
    },
    {
      "segments": [
        {
          "text": "Mei gives him the "
        },
        {
          "text": "wand",
          "wordIds": [
            "wand"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "小美把吹泡泡棒交給他。",
      "audio": {
        "src": "/audio/sentences/park-bubbles/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "862d6b0b752fba79ae5d6f15850fa100f5143941b4d166a949d6747bcb7aea9b",
        "sha256": "9d92de4ef271acfe436f751a87f4484eed63db928fd699c131a8f65bb3b648d0"
      }
    },
    {
      "segments": [
        {
          "text": "A big bubble "
        },
        {
          "text": "floats",
          "wordIds": [
            "floats"
          ]
        },
        {
          "text": " past his "
        },
        {
          "text": "nose",
          "wordIds": [
            "nose"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "一個大泡泡飄過他的鼻子前方。",
      "audio": {
        "src": "/audio/sentences/park-bubbles/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e81fa39bf6bb7d59d8230851abf254b3877a5d368228f2763ab91986e0d95a2b",
        "sha256": "7bdcba3127940c820f5bb2d5482f46bec3b4620ec127aecb5a53a401f0514ab6"
      }
    },
    {
      "segments": [
        {
          "text": "“"
        },
        {
          "text": "Look at that one",
          "phraseIds": [
            "look-at-that-one"
          ]
        },
        {
          "text": "!” he says."
        }
      ],
      "translation": "他說：「看那個泡泡！」",
