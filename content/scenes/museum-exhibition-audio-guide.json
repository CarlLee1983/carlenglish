  "sentences": [
    {
      "segments": [
        {
          "text": "I would like to rent an "
        },
        {
          "text": "audio guide device",
          "phraseIds": [
            "audio-guide-device"
          ]
        },
        {
          "text": " for the ancient "
        },
        {
          "text": "history",
          "wordIds": [
            "history"
          ]
        },
        {
          "text": " exhibit."
        }
      ],
      "translation": "我想租借一台參觀古代歷史特展用的語音導覽機。",
      "audio": {
        "src": "/audio/sentences/museum-exhibition-audio-guide/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ad500af68f0360e56a768abe6489f0736a368a5065fd06418522a29abb086972",
        "sha256": "5c785e3b13df7ba8204c67291eaf753b8cd89cb714c74dc75f7d4e1668d169a2"
      }
    },
    {
      "segments": [
        {
          "text": "Which "
        },
        {
          "text": "language",
          "wordIds": [
            "language"
          ]
        },
        {
          "text": " would you like the audio commentary to play in?"
        }
      ],
      "translation": "請問您希望語音解說以哪一種語言播放呢？",
      "audio": {
        "src": "/audio/sentences/museum-exhibition-audio-guide/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "72f3941d5782d356022fe4ec2204106d5c498fe393c540c69f5d49bc806ad4df",
        "sha256": "68505fd84776bd2ae408eb4d8de0e7de604bf27ed0b3bad007a25344fd03446c"
      }
    },
    {
      "segments": [
        {
          "text": "Please "
        },
        {
          "text": "set it to English",
          "phraseIds": [
            "set-it-to-english"
          ]
        },
        {
          "text": " so I can practice listening to historical terms."
        }
      ],
      "translation": "請幫我設定成英文，這樣我可以順便練習聽歷史相關用語。",
      "audio": {
        "src": "/audio/sentences/museum-exhibition-audio-guide/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "fa16ad7572e52fd84417e5dde4b3c6e02fe756829015920d4b5363ae03809d42",
        "sha256": "2565847fdc7d262ce90b9678ba920407ea1dd857a785a6c2a97627ee46daa5a3"
      }
    },
    {
      "segments": [
        {
          "text": "When you walk up to any "
        },
        {
          "text": "display",
          "phraseIds": [
            "display-case"
          ],
          "wordIds": [
            "display"
          ]
        },
        {
          "text": " case",
          "phraseIds": [
            "display-case"
          ]
        },
        {
          "text": ", simply "
        },
        {
          "text": "press the matching number",
          "phraseIds": [
            "press-the-matching-number"
          ]
        },
        {
          "text": " on the keypad."
        }
      ],
      "translation": "當你走到任何展品櫥窗前時，只要在數字鍵盤上按下對應的號碼即可。",
      "audio": {
        "src": "/audio/sentences/museum-exhibition-audio-guide/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "0e4d3710e74877c5c3699da555b8299cc87a7699e22c20f064992c6175380535",
        "sha256": "ca8bb98281a5c5c3e75712e70027d893ec7494a2959bd3ecda1b864bf53cb666"
      }
    },
    {
      "segments": [
        {
          "text": "Each track explains the "
        },
        {
          "text": "culture",
          "phraseIds": [
            "culture-and-daily-life"
          ],
          "wordIds": [
            "culture"
          ]
        },
        {
          "text": " and daily life",
          "phraseIds": [
            "culture-and-daily-life"
          ]
        },
        {
          "text": " of people during that dynamic "
        },
        {
          "text": "period",
          "wordIds": [
            "period"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "每一段解說音軌都會介紹那個輝煌歷史時期人們的文化與日常生活。",
      "audio": {
        "src": "/audio/sentences/museum-exhibition-audio-guide/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "63c53e9b4424ef61d554fdf3177f66fe4b3ef06dff622eada3ce76230d52862c",
        "sha256": "670fc953b8eaa6853c5b03c816b8138226958018d618dac10f69660113a0ab5a"
      }
    },
    {
      "segments": [
        {
          "text": "This handheld player really adds great "
        },
        {
          "text": "interest",
          "wordIds": [
            "interest"
          ]
        },
        {
          "text": " to our afternoon museum tour."
        }
      ],
      "translation": "這台手持播放器真的為我們下午的博物館參觀增添了許多趣味。",
      "audio": {
        "src": "/audio/sentences/museum-exhibition-audio-guide/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "5c8fc821e8cb1b81a6e65e0d5d1f83981bca1da257280df29cdfb2642ff09e1b",
        "sha256": "c27db69923d37cf321f56700bc74797efaa72be5f388a88d54f2d1edd5891747"
      }
    }
  ]
