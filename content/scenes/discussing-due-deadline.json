  "sentences": [
    {
      "segments": [
        {
          "text": "The teacher set the "
        },
        {
          "text": "final deadline",
          "phraseIds": [
            "final-deadline"
          ]
        },
        {
          "text": " for our science report on Friday afternoon."
        }
      ],
      "translation": "老師把我們自然科學報告的最終繳交截止時間設在週五下午。",
      "audio": {
        "src": "/audio/sentences/discussing-due-deadline/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "5fb690a75ea2b55940d7d7835d9dd07366ffe407425afb166fb289564417e82d",
        "sha256": "e488c918c94f156de46b290491ac01a76193a9cfc1e4fd379b876b33e2069cb1"
      }
    },
    {
      "segments": [
        {
          "text": "We should aim to "
        },
        {
          "text": "finish",
          "wordIds": [
            "finish"
          ]
        },
        {
          "text": " our individual sections "
        },
        {
          "text": "by ",
          "phraseIds": [
            "by-tomorrow-evening"
          ]
        },
        {
          "text": "tomorrow",
          "phraseIds": [
            "by-tomorrow-evening"
          ],
          "wordIds": [
            "tomorrow"
          ]
        },
        {
          "text": " evening",
          "phraseIds": [
            "by-tomorrow-evening"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我們應該以明天傍晚前完成各自負責的章節段落為目標。",
      "audio": {
        "src": "/audio/sentences/discussing-due-deadline/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "2b3067dbced51b4084e1984bdb064e865e182f9ad52bf09735b07d8db56a9b51",
        "sha256": "ae29d3102b89c4bca663573eec34223d6d9122e14c8849e92f189bd2a7c1c29c"
      }
    },
    {
      "segments": [
        {
          "text": "If everyone "
        },
        {
          "text": "sends",
          "wordIds": [
            "send"
          ]
        },
        {
          "text": " their draft "
        },
        {
          "text": "tonight",
          "wordIds": [
            "tonight"
          ]
        },
        {
          "text": ", I can "
        },
        {
          "text": "combine them together",
          "phraseIds": [
            "combine-them-together"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "如果大家今晚把各自的草稿寄給我，我可以把它們統整在一起。",
      "audio": {
        "src": "/audio/sentences/discussing-due-deadline/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "973cc587ad42ce796c4baa479dbe16cc31286e6c5a8002566d726bcd7b156efe",
        "sha256": "c8bb8d03b63b728f0a2e79480cb76849f5dba2ec2462f1ade3b7f075a4292256"
      }
    },
    {
      "segments": [
        {
          "text": "Will that give us "
        },
        {
          "text": "enough hours to review",
          "phraseIds": [
            "enough-hours-to-review"
          ]
        },
        {
          "text": " the sentences carefully?"
        }
      ],
      "translation": "那樣會有足夠的時間讓我們仔細檢查修飾每一句話嗎？",
      "audio": {
        "src": "/audio/sentences/discussing-due-deadline/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "183cc4ad8bbb59dc91787ee0eb81df80f3bb5eb99f87c12b15dec59228013217",
        "sha256": "002d0b7c298ead9a2f5ea4f54734a945a75a67b4b462f01d98bdd97d0d57c35b"
      }
    },
    {
      "segments": [
        {
          "text": "Yes, having the report "
        },
        {
          "text": "ready",
          "wordIds": [
            "ready"
          ]
        },
        {
          "text": " by Thursday leaves us time for corrections."
        }
      ],
      "translation": "有的，週四就把報告準備好，能留給我們充分的時間做修正。",
      "audio": {
        "src": "/audio/sentences/discussing-due-deadline/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "631cfcae3e4364b0b009004e265bf50caa4650b78aff9a1602ee40183e237307",
        "sha256": "c5737f7321ddb283c064767c5a5e319766ba98128a88f61082830bc3080fdf66"
      }
    },
    {
      "segments": [
        {
          "text": "Let us promise to submit the "
        },
        {
          "text": "completed",
          "wordIds": [
            "complete"
          ]
        },
        {
          "text": " file two hours "
        },
        {
          "text": "before the deadline",
          "phraseIds": [
            "before-the-deadline"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我們約定在截止時間前兩小時，就把完成的檔案正式送出。",
      "audio": {
        "src": "/audio/sentences/discussing-due-deadline/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "127559e96de60d69ee07fade3f7e10fe0561089d587c4a37118363b855598331",
        "sha256": "54cc4ebeb2c0786281cf0d47b99a383a1048c9d4982f2f9f4ba601c9f365429b"
      }
    }
  ]
