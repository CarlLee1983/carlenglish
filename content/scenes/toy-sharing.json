      }
    },
    {
      "segments": [
        {
          "text": "Mia places a wooden "
        },
        {
          "text": "block",
          "wordIds": [
            "block"
          ]
        },
        {
          "text": " on the rug to build a bridge."
        }
      ],
      "translation": "Mia 在地毯上放了一塊木頭積木來蓋一座小橋。",
      "audio": {
        "src": "/audio/sentences/toy-sharing/5.mp3",
