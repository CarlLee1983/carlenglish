        "sha256": "d79c82d02973bdb7eb543cae696f312bac87d38c50128b43c61c1263fb1a05f0"
      }
    },
    {
      "segments": [
        {
          "text": "Mia looks at the colorful box and asks, “"
        },
        {
          "text": "Can I ",
          "phraseIds": [
            "can-i-share-your-toy"
          ]
        },
        {
          "text": "share",
          "phraseIds": [
            "can-i-share-your-toy"
          ],
          "wordIds": [
            "share"
          ]
        },
        {
          "text": " your ",
          "phraseIds": [
            "can-i-share-your-toy"
          ]
        },
        {
          "text": "toy",
          "phraseIds": [
            "can-i-share-your-toy"
          ],
          "wordIds": [
            "toy"
          ]
        },
        {
          "text": "?",
          "phraseIds": [
            "can-i-share-your-toy"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Mia 看著彩色的盒子問：「我可以分享你的玩具嗎？」",
