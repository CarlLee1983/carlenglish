        "sha256": "118c567217a72dade8d0db196229900eebe2dac6cebad4c9588131d419776682"
      }
    },
    {
      "segments": [
        {
          "text": "Together, they connect the pieces and cheer, “"
        },
        {
          "text": "We built a ",
          "phraseIds": [
            "we-built-a-track"
          ]
        },
        {
          "text": "track",
          "phraseIds": [
            "we-built-a-track"
          ],
          "wordIds": [
            "track"
          ]
        },
        {
          "text": "!",
          "phraseIds": [
            "we-built-a-track"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "他們一起把零件連接起來並歡呼：「我們做了一條軌道！」",
      "audio": {
        "src": "/audio/sentences/toy-sharing/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "de44e0b92c508256e6711bf6ed817299edd395780cf5b7d019a76121288732c7",
        "sha256": "4b9df3f21bc373264ea1ca499df42be243c21997a8b254630d45cdc7fce83842"
      }
    },
    {
      "segments": [
        {
          "text": "The two friends watch the little cars roll and have fun all afternoon."
        }
      ],
      "translation": "兩位好朋友看著小車子前進，整個下午都玩得非常開心。",
      "audio": {
