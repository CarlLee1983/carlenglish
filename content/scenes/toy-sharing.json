        "src": "/audio/sentences/toy-sharing/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "051ad12b7ead48d415073a7441d6d9f25ceb220cd3d9ffc67b8f666881b16846",
        "sha256": "88667f1e88ba5c7e939265c0de85b11ed5a711bda6b864b501840266b8ca2099"
      }
    },
    {
      "segments": [
        {
          "text": "Leo hands her a red engine and says, “"
        },
        {
          "text": "Here is a ",
          "phraseIds": [
            "here-is-a-train"
          ]
        },
        {
          "text": "train",
          "phraseIds": [
            "here-is-a-train"
          ],
          "wordIds": [
            "train"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "here-is-a-train"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Leo 遞給她一個紅色車頭並說：「這裡有一列火車。」",
      "audio": {
        "src": "/audio/sentences/toy-sharing/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "abebffba808e6bb8e6e53eaa32413174a434f9ee1a0af8984fe08be8f0756d05",
