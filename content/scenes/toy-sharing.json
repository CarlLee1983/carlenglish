  "sentences": [
    {
      "segments": [
        {
          "text": "Leo and his "
        },
        {
          "text": "friend",
          "wordIds": [
            "friend"
          ]
        },
        {
          "text": " Mia sit on the carpet in the living room."
        }
      ],
      "translation": "Leo 和他的朋友 Mia 坐在客廳的地毯上。",
