  "sentences": [
    {
      "segments": [
        {
          "text": "Welcome to Ocean World, how many adult and "
        },
        {
          "text": "child",
          "wordIds": [
            "child"
          ]
        },
        {
          "text": " tickets do you need?"
        }
      ],
      "translation": "歡迎來到海洋世界，請問需要幾張成人票和幾張兒童票？",
      "audio": {
        "src": "/audio/sentences/amusement-park-entry/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ddfef13591806e5da574452ed381c0e15f536e8df789fd468e5ad238e79fcea6",
        "sha256": "2369a20e5054fa6d93e81e70371d911f52ecf39072b22200779136dbd42d4d21"
      }
    },
    {
      "segments": [
        {
          "text": "We need two "
        },
        {
          "text": "adult day ",
          "phraseIds": [
            "adult-day-passes"
          ]
        },
        {
          "text": "passes",
          "phraseIds": [
            "adult-day-passes"
          ],
          "wordIds": [
            "pass"
          ]
        },
        {
          "text": " and one ticket for our "
        },
        {
          "text": "young ",
          "phraseIds": [
            "young-kid"
          ]
        },
        {
          "text": "kid",
          "phraseIds": [
            "young-kid"
          ],
          "wordIds": [
            "kid"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我們需要兩張成人一日通行手環，以及一張給我們家小孩的門票。",
      "audio": {
        "src": "/audio/sentences/amusement-park-entry/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "6735a97ff24309219dedd6c00b29275de7d57128d63e398bd7f8625b8f953871",
        "sha256": "167c1ab728887a7a8c0f0797bbc1da48e1a9a9a9b9ec6c74c30bf1081d331608"
      }
    },
    {
      "segments": [
        {
          "text": "Children must be over one hundred and twenty centimeters in height for the big roller coaster."
        }
      ],
      "translation": "大型雲霄飛車規定兒童的身高必須超過一百二十公分。",
      "audio": {
        "src": "/audio/sentences/amusement-park-entry/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "d2dd8087dbb5e3c381988645da1ade0a04c899d59d8421b0b58a4c3cf92ef4f2",
        "sha256": "8cbd1908b4a4f8745c7fffa8570d8a71643e60c046bf3504f93a6ecc798e0532"
      }
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "fair",
          "wordIds": [
            "fair"
          ]
        },
        {
          "text": " attendant measured him gently, and he passed the "
        },
        {
          "text": "minimum requirement",
          "phraseIds": [
            "minimum-requirement"
          ]
        },
        {
          "text": " easily."
        }
      ],
      "translation": "遊樂園工作人員親切地幫他量了身高，他很輕鬆地通過了最低身高要求。",
      "audio": {
        "src": "/audio/sentences/amusement-park-entry/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "a5b69fddf903c7f62446790520f7ae0c9c80af79e25c55c7bf8c3061557f2cc2",
        "sha256": "99302cd599537cb5e3dd3cab4f1c62d46d5420e9a846bca2ccf46e6c01039ec3"
      }
    },
    {
      "segments": [
        {
          "text": "How long is the "
        },
        {
          "text": "waiting line",
          "phraseIds": [
            "waiting-line"
          ]
        },
        {
          "text": " for the fast water splash "
        },
        {
          "text": "ride",
          "wordIds": [
            "ride"
          ]
        },
        {
          "text": " right now?"
        }
      ],
      "translation": "請問現在那個刺激的快速急流泛舟設施排隊要等多久？",
      "audio": {
        "src": "/audio/sentences/amusement-park-entry/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "4b4ec2077ba376b296b6802f8085bd986800c072d3cbfd97ba9b9829efd4c0e4",
        "sha256": "7881f31589f559258196b54c4ce2b7a995f45884562a5ed11ebb7b8ef0457aa1"
      }
    },
    {
      "segments": [
        {
          "text": "The wait is only twenty minutes, so go ahead and "
        },
        {
          "text": "have lots of ",
          "phraseIds": [
            "have-lots-of-fun"
          ]
        },
        {
          "text": "fun",
          "phraseIds": [
            "have-lots-of-fun"
          ],
          "wordIds": [
            "fun"
          ]
        },
        {
          "text": "!"
        }
      ],
      "translation": "只要等大概二十分鐘而已，快進去好好享受歡樂吧！",
      "audio": {
        "src": "/audio/sentences/amusement-park-entry/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9a8c753f2e22e77417b7b6debb560151d8e18d59dd9b5dabe682a5afeaf2aefe",
        "sha256": "5d48cfe58279a351b56f2be4b75f27fa4a747fdfdd8494144b55564a3ff6ea2e"
      }
    }
  ]
