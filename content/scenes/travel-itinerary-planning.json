  "sentences": [
    {
      "segments": [
        {
          "text": "Since "
        },
        {
          "text": "summer",
          "phraseIds": [
            "summer-holiday"
          ],
          "wordIds": [
            "summer"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "holiday",
          "phraseIds": [
            "summer-holiday"
          ],
          "wordIds": [
            "holiday"
          ]
        },
        {
          "text": " is beginning soon, let us "
        },
        {
          "text": "travel",
          "phraseIds": [
            "travel-somewhere-peaceful"
          ],
          "wordIds": [
            "travel"
          ]
        },
        {
          "text": " somewhere peaceful",
          "phraseIds": [
            "travel-somewhere-peaceful"
          ]
        },
        {
          "text": " this Saturday."
        }
      ],
      "translation": "既然暑假快開始了，我們這個星期六去一個寧靜的地方走走吧。",
      "audio": {
        "src": "/audio/sentences/travel-itinerary-planning/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "8a095e7ac9cbff7a19f0449bec4f697c6e317cef642788aef3a33decd7c6dc2c",
        "sha256": "b253e0f4dc04c94bf9d1bdd4a60500059ed28ae50a86a4f170b73185465098dc"
      }
    },
    {
      "segments": [
        {
          "text": "Do you want to explore an old historic "
        },
        {
          "text": "town",
          "wordIds": [
            "town"
          ]
        },
        {
          "text": " or walk through the quiet "
        },
        {
          "text": "country",
          "phraseIds": [
            "country-hills"
          ],
          "wordIds": [
            "country"
          ]
        },
        {
          "text": " hills",
          "phraseIds": [
            "country-hills"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "你想去探索古色古香的歷史小鎮，還是漫步在寧靜的鄉間丘陵？",
      "audio": {
        "src": "/audio/sentences/travel-itinerary-planning/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "92f5e59378a32f0ad425f92bcb53c3d2fc5fc4c75bd5c833c86bf761fda0ae82",
        "sha256": "618f46ad4627305805fdf375abe9b3662965fdba63d2bfceb3af47ce5738621e"
      }
    },
    {
      "segments": [
        {
          "text": "A walking tour through the mountain "
        },
        {
          "text": "country",
          "wordIds": [
            "country"
          ]
        },
        {
          "text": " would give us a breath of fresh life."
        }
      ],
      "translation": "在山野鄉村徒步漫遊會讓我們呼吸新鮮空氣、感受生活活力。",
      "audio": {
        "src": "/audio/sentences/travel-itinerary-planning/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "06693bbf74b225f050161d19edea9d32655125f5e646b497fc46869ad1c2dd06",
        "sha256": "8aaf2f5727a3dd43780389dc19e39d9bc7e3d4183b8982843630362eae49e961"
      }
    },
    {
      "segments": [
        {
          "text": "Is the scenic waterfall view really "
        },
        {
          "text": "worth",
          "wordIds": [
            "worth"
          ]
        },
        {
          "text": " the two-hour train ride?"
        }
      ],
      "translation": "那個風景優美的瀑布景致，真的值得我們坐兩小時的火車去嗎？",
      "audio": {
        "src": "/audio/sentences/travel-itinerary-planning/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f41499c0aa57c2a51225edcea2152b9b2739ac425f4e72217bdd09e9071a7cd5",
        "sha256": "ce27a559df00fb58506e8bc8ea233dd4651c7e86906e4ee76324c8b9fba1dc03"
      }
    },
    {
      "segments": [
        {
          "text": "It is definitely "
        },
        {
          "text": "worth",
          "phraseIds": [
            "worth-the-trip"
          ],
          "wordIds": [
            "worth"
          ]
        },
        {
          "text": " the trip",
          "phraseIds": [
            "worth-the-trip"
          ]
        },
        {
          "text": " because the forest nature trails are breathtaking."
        }
      ],
      "translation": "絕對非常值得去，因為森林步道的大自然風景令人嘆為觀止。",
      "audio": {
        "src": "/audio/sentences/travel-itinerary-planning/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c388df6163a5627742889b2972876b5fa2b660c1bb11406f0cd4bc40f9fc4784",
        "sha256": "4beea56745175ace449cb564638f263bc83aef38645b8891905d0b731138ec81"
      }
    },
    {
      "segments": [
        {
          "text": "Let us pack simple sandwiches and "
        },
        {
          "text": "visit the local tea farm",
          "phraseIds": [
            "visit-the-local-tea-farm"
          ]
        },
        {
          "text": " in the afternoon."
        }
      ],
      "translation": "我們準備簡單的三明治，下午再去拜訪當地的茶園吧。",
      "audio": {
        "src": "/audio/sentences/travel-itinerary-planning/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c2808982f3b9a99b0251f25ff921634b0c291309c7756df064969ebc4df7a0fd",
        "sha256": "3031543c9f9b83bb4163d93d999f38d4778ed3f9ded2fc2a214e0dfcce272251"
      }
    }
