  "sentences": [
    {
      "segments": [
        {
          "text": "Excuse me, I am "
        },
        {
          "text": "looking for",
          "phraseIds": [
            "looking-for"
          ]
        },
        {
          "text": " batteries for my remote control."
        }
      ],
      "translation": "不好意思，我正在找遙控器用的電池。",
      "audio": {
        "src": "/audio/sentences/convenience-store-items/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "cf4883ea500916c3ea1afd650875515357ba2189b46879c4329b6d65527533cb",
        "sha256": "b64c2e5c9bbe1a75cbf5071c4aba9e7703eb6447697d4b4e5b2dc61baae9796f"
      }
    },
    {
      "segments": [
        {
          "text": "Batteries are placed in aisle three, right "
        },
        {
          "text": "behind",
          "phraseIds": [
            "behind-the-counter"
          ],
          "wordIds": [
            "behind"
          ]
        },
        {
          "text": " the counter",
          "phraseIds": [
            "behind-the-counter"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "電池放在第三走道，就在櫃檯的正後方。",
      "audio": {
        "src": "/audio/sentences/convenience-store-items/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ec27ff9d651c3dd1389fb6919fca9b41a4e500464aada812e245b472754d1aa6",
        "sha256": "044cb24b756cb4968b14db2ccfa493d7cdc3851b26c924a9d2ab46c0b6f7a0c2"
      }
    },
    {
      "segments": [
        {
          "text": "Are they "
        },
        {
          "text": "on the top ",
          "phraseIds": [
            "on-the-top-shelf"
          ]
        },
        {
          "text": "shelf",
          "phraseIds": [
            "on-the-top-shelf"
          ],
          "wordIds": [
            "shelf"
          ]
        },
        {
          "text": " or down "
        },
        {
          "text": "at the ",
          "phraseIds": [
            "at-the-bottom"
          ]
        },
        {
          "text": "bottom",
          "phraseIds": [
            "at-the-bottom"
          ],
          "wordIds": [
            "bottom"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "請問是在最上層的貨架，還是靠近最底層呢？",
      "audio": {
        "src": "/audio/sentences/convenience-store-items/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "1f352b4de513b1568c7f62ce80e473402a5e87f10ce4b04820985cef721f2d50",
        "sha256": "a246697fa76d7a1c104ffcf4bb61988d55a1c44571d6c46c9fca3c12bb47a4c0"
      }
    },
    {
      "segments": [
        {
          "text": "They are located right in the "
        },
        {
          "text": "middle",
          "wordIds": [
            "middle"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "shelf",
          "wordIds": [
            "shelf"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "at eye level",
          "phraseIds": [
            "at-eye-level"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "它們就在中間那層貨架，剛好跟眼睛視線一樣高。",
      "audio": {
        "src": "/audio/sentences/convenience-store-items/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "57c30c96986d3576be930330e5ad2dfdaa4d772ff8ac22a6ae810f89e4d0b673",
        "sha256": "01b8c6bbe23e0441260c199e9d17bb40adcd4490e7f993f58aac345dd6b7756f"
      }
    },
    {
      "segments": [
        {
          "text": "Do you also need to "
        },
        {
          "text": "find",
          "wordIds": [
            "find"
          ]
        },
        {
          "text": " any small household "
        },
        {
          "text": "items",
          "wordIds": [
            "item"
          ]
        },
        {
          "text": " today?"
        }
      ],
      "translation": "您今天還需要尋找其他小型日常用品嗎？",
      "audio": {
        "src": "/audio/sentences/convenience-store-items/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "29d24e4721475d7efb97e306d6a2e424c0de01f2796236e0aaceec8032b7244a",
        "sha256": "f7bf3cd2828e8fc850d51eaeecd9f1b11956abc70fbb0d60881a1db327cfdaec"
      }
    },
    {
      "segments": [
        {
          "text": "No thanks, I found exactly what I needed right here."
        }
      ],
      "translation": "不需要了謝謝，我在這裡剛好找到我所需要的東西。",
      "audio": {
        "src": "/audio/sentences/convenience-store-items/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "53f7970462634619bc7e7dda33735fa76bc881b28242ae723b4e596c034b1bf9",
        "sha256": "a4aea4eb2728dc469d8e40945b0327a5af1ff672413948ac014a36b3916f0988"
      }
    }
