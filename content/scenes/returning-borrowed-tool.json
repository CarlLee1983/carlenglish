  "sentences": [
    {
      "segments": [
        {
          "text": "Hello Mr. Wang, I "
        },
        {
          "text": "came by to return",
          "phraseIds": [
            "came-by-to-return"
          ]
        },
        {
          "text": " the metal toolbox you lent me."
        }
      ],
      "translation": "王先生你好，我順道過來歸還您昨天借給我的金屬工具箱。",
      "audio": {
        "src": "/audio/sentences/returning-borrowed-tool/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c5d51c2071498b0834b1803ea311c83eb43b5375fbd03bed53382261fe01d0c8",
        "sha256": "5b929f25d8f1ab8b02363b3feccb0fd111e6039838c2e4a627720e8c373a211f"
      }
    },
    {
      "segments": [
        {
          "text": "Did the tools you "
        },
        {
          "text": "used",
          "wordIds": [
            "use"
          ]
        },
        {
          "text": " help you fix your bedroom bookshelf?"
        }
      ],
      "translation": "你使用的那套工具有幫你把臥室的書架組裝修理好嗎？",
      "audio": {
        "src": "/audio/sentences/returning-borrowed-tool/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "1f6a2473be7f93f9f03ebc34852a7bfcdcecb7aa502aedfa959ca6b37c903db5",
        "sha256": "c69ad6d17bb60c31ec8afea0efb1863546a31567e73c6431bfcd0dd3253a6045"
      }
    },
    {
      "segments": [
        {
          "text": "Yes, "
        },
        {
          "text": "having the proper tools",
          "phraseIds": [
            "having-the-proper-tools"
          ]
        },
        {
          "text": " made the work easy and my bookshelf is now "
        },
        {
          "text": "done",
          "wordIds": [
            "done"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "有的，有了合適的工具讓工作很輕鬆，而且我的書架現在組裝完成了。",
      "audio": {
        "src": "/audio/sentences/returning-borrowed-tool/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "0f51d3014fa4b015c46170aa97a89eddbb7ed94239744a930618602fab72871b",
        "sha256": "3fed24b361f17c7c7b8bd91b1e1a9ec41261b404114ef960d79b0b12b3c6a1ad"
      }
    },
    {
      "segments": [
        {
          "text": "I "
        },
        {
          "text": "wiped every ",
          "phraseIds": [
            "wiped-every-tool-clean"
          ]
        },
        {
          "text": "tool",
          "phraseIds": [
            "wiped-every-tool-clean"
          ],
          "wordIds": [
            "tool"
          ]
        },
        {
          "text": " clean",
          "phraseIds": [
            "wiped-every-tool-clean"
          ]
        },
        {
          "text": " and made sure each piece is "
        },
        {
          "text": "back in the box",
          "phraseIds": [
            "back-in-the-box"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我把每件工具都擦拭乾淨，並且確認每樣配件都已經放回箱子裡了。",
      "audio": {
        "src": "/audio/sentences/returning-borrowed-tool/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "3cae055c60afc69a90aaac5eabce871ed768d51d9bda2fb9991aaad32cc85e23",
        "sha256": "8f245a8e03ed911287631e3281eae906f2c267b6f638214b045b2026dff36cd3"
      }
    },
    {
      "segments": [
        {
          "text": "Here is a small bag of homemade cookies to "
        },
        {
          "text": "thank",
          "phraseIds": [
            "thank-you-very-much-for-your-kindness"
          ],
          "wordIds": [
            "thank"
          ]
        },
        {
          "text": " you very ",
          "phraseIds": [
            "thank-you-very-much-for-your-kindness"
          ]
        },
        {
          "text": "much",
          "phraseIds": [
            "thank-you-very-much-for-your-kindness"
          ],
          "wordIds": [
            "much"
          ]
        },
        {
          "text": " for your kindness",
          "phraseIds": [
            "thank-you-very-much-for-your-kindness"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "這裡有一小袋我自己做的手工餅乾，非常感謝您的熱心幫忙。",
      "audio": {
        "src": "/audio/sentences/returning-borrowed-tool/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "dbad878663e477ada57ae676e24dc45890b9fcedec7ff90bcf6df703a1e9945c",
        "sha256": "61ca2a8667af56f34e0ea853a1a8178b4ef958e7616c98f3b95b6a912689aed3"
      }
    },
    {
      "segments": [
        {
          "text": "That is so sweet of you Leo, you are always a thoughtful "
        },
        {
          "text": "neighbor",
          "wordIds": [
            "neighbor"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "Leo 你真是太客氣貼心了，你一直都是個非常細心體貼的好鄰居。",
      "audio": {
        "src": "/audio/sentences/returning-borrowed-tool/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "54c324faeb540424d8221db30940f15f185ea73dcf071978d2b315dae556cb1f",
        "sha256": "971aeee6992a2e7a3009f8c5bf13e085771db2bf6c244d0fe99beb9aead41371"
      }
    }
  ]
