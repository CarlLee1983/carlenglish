          "phraseIds": [
            "does-that-mean"
          ],
          "wordIds": [
            "mean"
          ]
        },
        {
          "text": " there is no dairy in this dish?"
        }
      ],
      "translation": "那是不是代表這道菜裡面完全沒有乳製品？",
      "audio": {
        "src": "/audio/sentences/checking-food-allergens/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "b7d1c151519c369371e5e44bc0abcd3cfe190baea22d2d2752f83e36bc36fe69",
