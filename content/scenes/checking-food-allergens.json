          ],
          "wordIds": [
            "sure"
          ]
        },
        {
          "text": " about",
          "phraseIds": [
            "be-sure-about"
          ]
        },
        {
          "text": " this because my sister "
        },
        {
          "text": "has a bad allergy",
          "phraseIds": [
            "has-a-bad-allergy"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我必須確定這件事，因為我妹妹有嚴重的過敏。",
      "audio": {
        "src": "/audio/sentences/checking-food-allergens/2.mp3",
