  "sentences": [
    {
      "segments": [
        {
          "text": "Excuse me, "
        },
        {
          "text": "which ",
          "phraseIds": [
            "which-line-goes-to"
          ]
        },
        {
          "text": "line",
          "phraseIds": [
            "which-line-goes-to"
          ],
          "wordIds": [
            "line"
          ]
        },
        {
          "text": " goes to",
          "phraseIds": [
            "which-line-goes-to"
          ]
        },
        {
          "text": " the central park station?"
        }
      ],
      "translation": "不好意思，請問哪一條捷運線是開往中央公園站的？",
      "audio": {
        "src": "/audio/sentences/mrt-transfer-help/1.mp3",
