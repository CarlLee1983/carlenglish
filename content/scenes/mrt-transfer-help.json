          "wordIds": [
            "transfer"
          ]
        },
        {
          "text": " at",
          "phraseIds": [
            "transfer-at"
          ]
        },
        {
          "text": " Taipei Main Station."
        }
      ],
      "translation": "你需要先搭紅線，然後在台北車站轉乘。",
      "audio": {
        "src": "/audio/sentences/mrt-transfer-help/2.mp3",
