  "sentences": [
    {
      "segments": [
        {
          "text": "Is this winter backpack currently "
        },
        {
          "text": "on ",
          "phraseIds": [
            "on-sale-this-week"
          ]
        },
        {
          "text": "sale",
          "phraseIds": [
            "on-sale-this-week"
          ],
          "wordIds": [
            "sale"
          ]
        },
        {
          "text": " this week",
          "phraseIds": [
            "on-sale-this-week"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "請問這款冬用後背包這週目前有在特價嗎？",
      "audio": {
        "src": "/audio/sentences/asking-store-discount/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e3f5f5b75d50c40b5c2bfce186039b133d6c1ba898f257de38e1dcd4e04ab69a",
        "sha256": "f7cdd4ebd3f7103a44ef7cf2a580932b9c87a4b4c6823b6397cfdb670f8ae9a6"
      }
    },
    {
      "segments": [
        {
          "text": "Yes, all items with red stickers have a "
        },
        {
          "text": "special",
          "wordIds": [
            "special"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "twenty percent discount",
          "phraseIds": [
            "twenty-percent-discount"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "有的，所有貼紅標籤的商品都有額外八折特價。",
      "audio": {
        "src": "/audio/sentences/asking-store-discount/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "a2509a1ffc298e009dd754c724e0079660d52e17adc0c810b9c9473dd8e2147d",
        "sha256": "f5296d914a374413cb8709383ff8ee4437928f893861767cf0c584ec6c56e646"
      }
    },
    {
      "segments": [
        {
          "text": "If I am a store "
        },
        {
          "text": "member",
          "wordIds": [
            "member"
          ]
        },
        {
          "text": ", can I "
        },
        {
          "text": "save",
          "phraseIds": [
            "save-more-money"
          ],
          "wordIds": [
            "save"
          ]
        },
        {
          "text": " more money",
          "phraseIds": [
            "save-more-money"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "如果我是本店會員的話，還可以省更多錢嗎？",
      "audio": {
        "src": "/audio/sentences/asking-store-discount/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "fda83ad38abc83a1792c1ffcd8d62eacfa4b233cb25bd3c58cce4e334d93bbd4",
        "sha256": "5c50dd9663429b2ddc25308549f987d7ec5ded7e347ea895e075017d2820540b"
      }
    },
    {
      "segments": [
        {
          "text": "Members get an extra five percent off the regular "
        },
        {
          "text": "price",
          "wordIds": [
            "price"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "會員可以在原價基礎上再享受額外九五折優惠。",
      "audio": {
        "src": "/audio/sentences/asking-store-discount/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "6dd9a0b89f330c04767f9dda8369538aef975bc80d8cf3d1c8570ae861817744",
        "sha256": "2b013a5aa0d74486b7d6cd74f7f5d55839296614ddd39de3d9c4f89bf46fc9d4"
      }
    },
    {
      "segments": [
        {
          "text": "That makes the "
        },
        {
          "text": "total ",
          "phraseIds": [
            "total-price"
          ]
        },
        {
          "text": "price",
          "phraseIds": [
            "total-price"
          ],
          "wordIds": [
            "price"
          ]
        },
        {
          "text": " very "
        },
        {
          "text": "cheap",
          "wordIds": [
            "cheap"
          ]
        },
        {
          "text": " for such good quality."
        }
      ],
      "translation": "這樣算下來，這麼好的品質總價真的很便宜。",
      "audio": {
        "src": "/audio/sentences/asking-store-discount/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "eb2e25f5f9ae58d9ca12925c07381f76cd5d8caf0d6bc886ae3819ac4c402973",
        "sha256": "1159384bee11fe6884ba05926020eba7b3f6f84ac8f8ec7a7bcb4df147ecf87f"
      }
    },
    {
      "segments": [
        {
          "text": "Just "
        },
        {
          "text": "scan the barcode",
          "phraseIds": [
            "scan-the-barcode"
          ]
        },
        {
          "text": " on your phone app before you pay the bill."
        }
      ],
      "translation": "在您結帳付款之前，只要刷一下手機 App 條碼就可以了。",
      "audio": {
        "src": "/audio/sentences/asking-store-discount/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9f974eb28b3fdd0ffa8482dfd63f4847517ed66429209d84b2f8a049912b8b12",
