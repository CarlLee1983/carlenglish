            "i-can-make-the-poster"
          ]
        },
        {
          "text": "poster",
          "phraseIds": [
            "i-can-make-the-poster"
          ],
          "wordIds": [
            "poster"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "i-can-make-the-poster"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Leo 微笑著說：「我可以做海報。」",
      "audio": {
        "src": "/audio/sentences/team-project/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
