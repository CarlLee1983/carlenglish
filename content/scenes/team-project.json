        "sha256": "3bc55884a147b4b9d9b4f7f3cafc4f995fe1ce71ea8428bb2673de7f577dbd19"
      }
    },
    {
      "segments": [
        {
          "text": "Kevin opens his notebook and asks, “"
        },
        {
          "text": "What should we do first?",
          "phraseIds": [
            "what-should-we-do-first"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Kevin 打開筆記本問道：「我們應該先做什麼？」",
      "audio": {
        "src": "/audio/sentences/team-project/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "28876e540fcbb7a84ca2473a6d5264b0acce9c9f6699f775453359bd28e383fa",
        "sha256": "41b364a30a0062e774be002bd5882de63f7a92100e702be4fa7203a5d4914ad2"
      }
    },
    {
      "segments": [
        {
          "text": "Mia shares a creative "
        },
        {
          "text": "idea",
          "wordIds": [
            "idea"
          ]
        },
        {
          "text": " about world festivals."
        }
      ],
      "translation": "Mia 分享了一個關於世界節慶的創意點子。",
      "audio": {
        "src": "/audio/sentences/team-project/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c6be594ad859de5f6c9a5234d6c2fb536f77cb8ec4e290ef4f4166c58171d736",
        "sha256": "3f3f16f143de0da3024f32d502ece2240bb7b0ac5c9311c35fb32ec0a5a739fa"
      }
    },
    {
      "segments": [
        {
          "text": "Leo agrees and says, “"
        },
        {
          "text": "That's a great ",
          "phraseIds": [
            "thats-a-great-idea"
          ]
        },
        {
          "text": "idea",
          "phraseIds": [
            "thats-a-great-idea"
          ],
          "wordIds": [
            "idea"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "thats-a-great-idea"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Leo 表示贊同並說：「那是個好主意。」",
      "audio": {
        "src": "/audio/sentences/team-project/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "d08dfa3118348f60a2df78baf343d9bd0cfd820f1298665fda2c71cdf839c6ea",
        "sha256": "706f218c576fafe433e588e62f0679e0d262353a571b0de040f20f07620ac283"
      }
    },
    {
      "segments": [
        {
          "text": "Next, we divide each "
        },
        {
          "text": "task",
          "wordIds": [
            "task"
          ]
        },
        {
          "text": ", and Mia offers to do the research."
        }
      ],
      "translation": "接著，我們分配各項任務，Mia 主動負責資料搜尋。",
      "audio": {
        "src": "/audio/sentences/team-project/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "bb75922bc35fea37bbac67954c7776a511dfd46bf779895962b005d9f9047450",
        "sha256": "0d9c116834a885986f1cab232b8de2cb7cd08c9fe97461ed458d99054e171f0b"
      }
    },
    {
