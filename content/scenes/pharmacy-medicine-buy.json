  "sentences": [
    {
      "segments": [
        {
          "text": "Hello, I have had a "
        },
        {
          "text": "sore ",
          "phraseIds": [
            "sore-throat"
          ]
        },
        {
          "text": "throat",
          "phraseIds": [
            "sore-throat"
          ],
          "wordIds": [
            "throat"
          ]
        },
        {
          "text": " and a "
        },
        {
          "text": "slight ",
          "phraseIds": [
            "slight-headache"
          ]
        },
        {
          "text": "headache",
          "phraseIds": [
            "slight-headache"
          ],
          "wordIds": [
            "headache"
          ]
        },
        {
          "text": " since yesterday."
        }
      ],
      "translation": "你好，我從昨天開始喉嚨痛，還有點輕微頭痛。",
      "audio": {
        "src": "/audio/sentences/pharmacy-medicine-buy/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ca69d23c65baabc43538508e198501f547fcecd033ff7a6f846df398de9c9e33",
        "sha256": "f29c49ed50536baed076e2f4ab373c46c73dff0093b41533526e5068b5503f2e"
      }
    },
    {
      "segments": [
        {
          "text": "Do you have any good "
        },
        {
          "text": "medicine",
          "wordIds": [
            "medicine"
          ]
        },
        {
          "text": " for cold symptoms?"
        }
      ],
      "translation": "請問有推薦治療感冒症狀的成藥嗎？",
      "audio": {
        "src": "/audio/sentences/pharmacy-medicine-buy/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "5519cf1095011db804f585477f93f21b2719e5d007aa6701f62dbf84b4d4bc30",
        "sha256": "2df5fde5469eaaebcae868226c5788adc27e7728074252359d90a72f02f9b42d"
      }
    },
    {
      "segments": [
        {
          "text": "This "
        },
        {
          "text": "pain",
          "phraseIds": [
            "pain-relief"
          ],
          "wordIds": [
            "pain"
          ]
        },
        {
          "text": " relief",
          "phraseIds": [
            "pain-relief"
          ]
        },
        {
          "text": " pill will help with your "
        },
        {
          "text": "headache",
          "wordIds": [
            "headache"
          ]
        },
        {
          "text": " and "
        },
        {
          "text": "throat",
          "wordIds": [
            "throat"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "這款止痛錠能有效緩解你的頭痛與喉嚨不適。",
      "audio": {
        "src": "/audio/sentences/pharmacy-medicine-buy/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "d872dd86c5a1ae69f357c8fd3bb95ad0dea3fd7351c90b751fadca6f487c65cc",
        "sha256": "e9eb51b159eac43b749fba18ccb32a343ae0bcdbba9c970ad227f4d41be7e569"
      }
    },
    {
      "segments": [
        {
          "text": "How many times a day should I take this "
        },
        {
          "text": "medicine",
          "wordIds": [
            "medicine"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "請問這種藥我一天應該吃幾次呢？",
      "audio": {
        "src": "/audio/sentences/pharmacy-medicine-buy/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "1049831ac1031a9f8792bec147c9b3cd422d90b66307feb7170be912ea6edc2b",
        "sha256": "46a64709a4a6e86da8cf8106d70fd24ac33519e34734ee7b37ced96ddfd94214"
      }
    },
    {
      "segments": [
        {
          "text": "Take one tablet "
        },
        {
          "text": "three times a day",
          "phraseIds": [
            "three-times-a-day"
          ]
        },
        {
          "text": ", always "
        },
        {
          "text": "after a full meal",
          "phraseIds": [
            "after-a-full-meal"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "一天吃三次，每次一顆，一定要在吃飽飯後服用。",
      "audio": {
        "src": "/audio/sentences/pharmacy-medicine-buy/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "7e76d1cc97e61b7a7de0014279d48496fdf98ca459911fdacede4dd80a986c94",
        "sha256": "c01507f5ce964863e0f3d7a66e4a894ec2ec45e915a9c2a2910038f25351bbfc"
      }
    },
    {
      "segments": [
        {
          "text": "If your "
        },
        {
          "text": "throat",
          "wordIds": [
            "throat"
          ]
        },
        {
          "text": " still "
        },
        {
          "text": "hurts",
          "wordIds": [
            "hurt"
          ]
        },
        {
          "text": " after three days, please see a "
        },
        {
          "text": "doctor",
          "wordIds": [
            "doctor"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "如果三天後喉嚨還是會痛，請務必去看醫生。",
      "audio": {
        "src": "/audio/sentences/pharmacy-medicine-buy/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9b8e9e7ca2b5a7bb6c8638983a5d691108b8597cf9d3000719b06cb0c510a66a",
