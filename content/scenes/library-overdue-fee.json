  "sentences": [
    {
      "segments": [
        {
          "text": "I am here to "
        },
        {
          "text": "return",
          "phraseIds": [
            "return-books"
          ],
          "wordIds": [
            "return"
          ]
        },
        {
          "text": " books",
          "phraseIds": [
            "return-books"
          ]
        },
        {
          "text": " to the front desk today."
        }
      ],
      "translation": "我今天是來櫃檯歸還書籍的。",
      "audio": {
        "src": "/audio/sentences/library-overdue-fee/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f2bda1390bf7739e82d791b1eb694cb996587f210485d8d2ab1487d94c10cde8",
        "sha256": "4a1427b8cdb03932a1f8b181b474e3f3d9d870da8eb0087a3e0ba20f445b7cca"
      }
    },
    {
      "segments": [
        {
          "text": "Let me scan the barcode on your student library card first."
        }
      ],
      "translation": "讓我先掃描您學生借書證上的條碼。",
      "audio": {
        "src": "/audio/sentences/library-overdue-fee/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "76934a92031767b2d7a6f9fb67e4a6b04c636bc2cf663776605a35913240f7ee",
        "sha256": "efb1015c0fe1108b684263008443764ae5358a84447d0330be9f638da1b68aa7"
      }
    },
    {
      "segments": [
        {
          "text": "Our "
        },
        {
          "text": "system ",
          "phraseIds": [
            "system-record"
          ]
        },
        {
          "text": "record",
          "phraseIds": [
            "system-record"
          ],
          "wordIds": [
            "record"
          ]
        },
        {
          "text": " shows that both books are "
        },
        {
          "text": "five days overdue",
          "phraseIds": [
            "five-days-overdue"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我們的系統紀錄顯示，這兩本書都已經逾期了五天。",
      "audio": {
        "src": "/audio/sentences/library-overdue-fee/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "d2fc391ca3483bdc3b6a102c130b015b564311cce1dba0e95fee44fd5e096307",
        "sha256": "c78b44ec8693d53c63019dd72212ec6afa6fd525ba9cff850c504bdd25b8c8f6"
      }
    },
    {
      "segments": [
        {
          "text": "According to the "
        },
        {
          "text": "library ",
          "phraseIds": [
            "library-rule"
          ]
        },
        {
          "text": "rule",
          "phraseIds": [
            "library-rule"
          ],
          "wordIds": [
            "rule"
          ]
        },
        {
          "text": ", there is a small "
        },
        {
          "text": "fee",
          "wordIds": [
            "fee"
          ]
        },
        {
          "text": " of two dollars per day."
        }
      ],
      "translation": "依照圖書館規定，每本書每天需要收取兩元的小額滯納費。",
      "audio": {
        "src": "/audio/sentences/library-overdue-fee/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "431200640164478809998ca8b525e6de5c4bfac92140ffcc23a020e3a50407c5",
        "sha256": "31f7e95e3aee5cc4f25681b822a9d638e58d5250c10417ed1c6f24f936421299"
      }
    },
    {
      "segments": [
        {
          "text": "I am really sorry about forgetting the "
        },
        {
          "text": "return",
          "wordIds": [
            "return"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "due ",
          "phraseIds": [
            "due-date"
          ]
        },
        {
          "text": "date",
          "phraseIds": [
            "due-date"
          ],
          "wordIds": [
            "date"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我真的非常抱歉忘記了原本的還書期限。",
      "audio": {
        "src": "/audio/sentences/library-overdue-fee/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "94120fe3628459647a5c4818a5067f18a4338499154e77a8b9fea6c7be717a2c",
        "sha256": "b4a58022a81738bfa37c463d87106f5aa1aa79b00a0304e09725197e1fd335ca"
      }
    },
    {
      "segments": [
        {
          "text": "Once you pay the twenty dollar "
        },
        {
          "text": "fee",
          "wordIds": [
            "fee"
          ]
        },
        {
          "text": ", you can "
        },
        {
          "text": "borrow",
          "wordIds": [
            "borrow"
          ]
        },
        {
          "text": " books again."
        }
      ],
      "translation": "只要您繳清二十元的費用，您就可以再次借書了。",
      "audio": {
        "src": "/audio/sentences/library-overdue-fee/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "028672ba564015113787e7bcb502ca25373dee4210947a87cd6a041e4c3b5c4e",
