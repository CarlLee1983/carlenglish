  "sentences": [
    {
      "segments": [
        {
          "text": "I would like a large black tea with milk, please."
        }
      ],
      "translation": "我想點一杯大杯鮮奶紅茶，謝謝。",
      "audio": {
        "src": "/audio/sentences/ordering-custom-drink/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "382ef4b444060dcba884c98af3dc4def109a8f24527114b8bdb42ff0f8266a81",
        "sha256": "6230028297034aa99b2313c2147cf7f3f446e6536157591ada1bedbeb177e025"
      }
    },
    {
      "segments": [
        {
          "text": "Could you please make it "
        },
        {
          "text": "with ",
          "phraseIds": [
            "with-less-ice"
          ]
        },
        {
          "text": "less",
          "phraseIds": [
            "with-less-ice"
          ],
          "wordIds": [
            "less"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "ice",
          "phraseIds": [
            "with-less-ice"
          ],
          "wordIds": [
            "ice"
          ]
        },
        {
          "text": " and "
        },
        {
          "text": "half sugar",
          "phraseIds": [
            "half-sugar"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "可以幫我做微冰半糖嗎？",
      "audio": {
        "src": "/audio/sentences/ordering-custom-drink/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "8677a784b384de0c6fab7915971001c95bf63f6717b4a74e9a8a8406cb3ff11d",
        "sha256": "a46b319631492d2c4597bce6d082b842aa2981a60f1f6bd88c301c6e97c34cf4"
      }
    },
    {
      "segments": [
        {
          "text": "Actually",
          "wordIds": [
            "actually"
          ]
        },
        {
          "text": ", I want it "
        },
        {
          "text": "not too ",
          "phraseIds": [
            "not-too-sweet"
          ]
        },
        {
          "text": "sweet",
          "phraseIds": [
            "not-too-sweet"
          ],
          "wordIds": [
            "sweet"
          ]
        },
        {
          "text": ", and please do not add "
        },
        {
          "text": "more",
          "wordIds": [
            "more"
          ]
        },
        {
          "text": " sugar."
        }
      ],
      "translation": "其實我想要不要太甜，請不要加更多糖。",
      "audio": {
        "src": "/audio/sentences/ordering-custom-drink/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "677f449774dfd18f9478f76b8358cbbe43e7ac44bbc4c8d543e2d9e252ed2ded",
        "sha256": "a39a4018349fae47c7077675b57a68ff3ed99b28fdda2058f10b39aea62e1eeb"
      }
    },
    {
      "segments": [
        {
          "text": "We have "
        },
        {
          "text": "two ",
          "phraseIds": [
            "two-types-of-tea"
          ]
        },
        {
          "text": "types",
          "phraseIds": [
            "two-types-of-tea"
          ],
          "wordIds": [
            "type"
          ]
        },
        {
          "text": " of tea",
          "phraseIds": [
            "two-types-of-tea"
          ]
        },
        {
          "text": " leaves available this season."
        }
      ],
      "translation": "我們這季有提供兩種茶葉。",
      "audio": {
        "src": "/audio/sentences/ordering-custom-drink/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "036b883db3b162fb8a25137666762450d963950d2899750dbce70cd38f563f9b",
        "sha256": "4ce5ce5653c0856440009279a7a86b75a71608a77c9e3ed72fa6d850e60fb8c0"
      }
    },
    {
      "segments": [
        {
          "text": "Instead",
          "phraseIds": [
            "instead-of-pearls"
          ],
          "wordIds": [
            "instead"
          ]
        },
        {
          "text": " of pearls",
          "phraseIds": [
            "instead-of-pearls"
          ]
        },
        {
          "text": ", can I add herbal jelly this time?"
        }
      ],
      "translation": "這次可以不要加珍珠，改成加仙草凍嗎？",
      "audio": {
        "src": "/audio/sentences/ordering-custom-drink/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "dbec21a77bab8408b24576c9e84e50f4ed1f8af1709973442a50d61566a41d99",
        "sha256": "48fd119da4fb2f2fe2d7189d86e74505569838cb9bb1776217772dd0f165b6b4"
      }
    },
    {
      "segments": [
        {
          "text": "That will be fifty-four dollars at the counter."
        }
      ],
      "translation": "在櫃檯結帳一共是五十四元。",
      "audio": {
        "src": "/audio/sentences/ordering-custom-drink/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "a62f25f1919a272a7dbe77ab3038736a1b26804227dfe63f2ad8e4a3c92b539d",
