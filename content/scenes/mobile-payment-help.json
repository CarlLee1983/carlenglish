  "sentences": [
    {
      "segments": [
        {
          "text": "I am "
        },
        {
          "text": "trying",
          "wordIds": [
            "try"
          ]
        },
        {
          "text": " to "
        },
        {
          "text": "pay",
          "wordIds": [
            "pay"
          ]
        },
        {
          "text": " for my breakfast sandwich using the "
        },
        {
          "text": "mobile payment app",
          "phraseIds": [
            "mobile-payment-app"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我正嘗試用手機行動支付 App 來付我早餐三明治的錢。",
      "audio": {
        "src": "/audio/sentences/mobile-payment-help/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "12ede15f57087c3382e0d4ccf2db86e2422f4be5457939bab0e4450aa34c2b1c",
        "sha256": "1fdcccd91025433add6baad2d6d150e1d6e2de4b4eea8233993070eca063faaa"
      }
    },
    {
      "segments": [
        {
          "text": "The scanner beeped twice with an "
        },
        {
          "text": "error",
          "phraseIds": [
            "error-message"
          ],
          "wordIds": [
            "error"
          ]
        },
        {
          "text": " message",
          "phraseIds": [
            "error-message"
          ]
        },
        {
          "text": " because the "
        },
        {
          "text": "screen brightness",
          "phraseIds": [
            "screen-brightness"
          ]
        },
        {
          "text": " was too low."
        }
      ],
      "translation": "因為螢幕亮度調太低了，掃描機發出了兩聲嗶嗶的錯誤提示音。",
      "audio": {
        "src": "/audio/sentences/mobile-payment-help/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "783342607f1b0e0e707ce8b5346af2947baaa0e98f2edae5acd1ce9b19837b45",
        "sha256": "dde8177277a38e0623508e2bb68e209defd20a4a17a329429dc71e6f20b79b4e"
      }
    },
    {
      "segments": [
        {
          "text": "Let me refresh the payment barcode and try scanning it one more time."
        }
      ],
      "translation": "讓我把付款條碼重新整理一次，然後再嘗試掃描一次看看。",
      "audio": {
        "src": "/audio/sentences/mobile-payment-help/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "a1d3e8f47ec4d22e7335b234618279080d23d2be13aa619242544fc6ca3cb779",
        "sha256": "9601d007b0afedb7991746606071e649b9b0c8d8874cdf0eda51c789d09961d3"
      }
    },
    {
      "segments": [
        {
          "text": "It still shows a connection timeout "
        },
        {
          "text": "error",
          "wordIds": [
            "error"
          ]
        },
        {
          "text": " on the "
        },
        {
          "text": "cash",
          "wordIds": [
            "cash"
          ]
        },
        {
          "text": " register "
        },
        {
          "text": "system",
          "wordIds": [
            "system"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "收銀機系統上還是持續顯示網路連線逾時的錯誤。",
      "audio": {
        "src": "/audio/sentences/mobile-payment-help/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f03f54ca8f5fb2655c56bed0cf58b6b0b6cba918d42338f6540ac8d7547a245b",
        "sha256": "4cd496b0fe62e8ecf42fc32aed06aa30b3a2a314ed416634733893bd47c9ad59"
      }
    },
    {
      "segments": [
        {
          "text": "No problem at all, I have "
        },
        {
          "text": "exact ",
          "phraseIds": [
            "exact-cash"
          ]
        },
        {
          "text": "cash",
          "phraseIds": [
            "exact-cash"
          ],
          "wordIds": [
            "cash"
          ]
        },
        {
          "text": " inside my pocket "
        },
        {
          "text": "wallet",
          "wordIds": [
            "wallet"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "完全沒關係，我口袋皮夾裡剛好帶著剛剛好的現金。",
      "audio": {
        "src": "/audio/sentences/mobile-payment-help/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "db1875f54549a9b9a0e80fe55302d7dfe7727b644731d5a13908c69e2767618c",
        "sha256": "f5cc5a0e5e2685f66b73bb9a288193b7d7b595fd0a1e4e2a4ed581ebb8ccfcb1"
      }
    },
    {
      "segments": [
        {
          "text": "Here is seventy dollars in "
        },
        {
          "text": "cash",
          "wordIds": [
            "cash"
          ]
        },
        {
          "text": ", "
        },
        {
          "text": "thank you for being patient",
          "phraseIds": [
            "thank-you-for-being-patient"
          ]
        },
        {
          "text": " while I tried."
        }
      ],
      "translation": "這裡剛好是七十元現金，非常謝謝您在我嘗試付款時耐心等候。",
      "audio": {
        "src": "/audio/sentences/mobile-payment-help/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "3faa3a0207e5c1b418eafc170ae1d41da6013e46af54a87640c10895a82ad8b1",
