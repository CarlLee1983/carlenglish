  "sentences": [
    {
      "segments": [
        {
          "text": "Are you ",
          "phraseIds": [
            "are-you-free"
          ]
        },
        {
          "text": "free",
          "phraseIds": [
            "are-you-free"
          ],
          "wordIds": [
            "free"
          ]
        },
        {
          "text": " this Saturday morning to discuss our science assignment?"
        }
      ],
      "translation": "這個星期六早上你有空一起討論我們的自然科學作業嗎？",
      "audio": {
        "src": "/audio/sentences/setting-meeting-time/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "8b5d30d9ab21a23b7e096b2fbdd7224744dae6858aab6d29dc0c5fbeb2757f37",
        "sha256": "d7d4a842001b83c2ecd5cc39aa94fdcadcec153c17efcd8ad8ebf16ef2cd87f9"
      }
    },
    {
      "segments": [
        {
          "text": "I am quite "
        },
        {
          "text": "busy",
          "wordIds": [
            "busy"
          ]
        },
        {
          "text": " until ten o'clock, but after that "
        },
        {
          "text": "my schedule is open",
          "phraseIds": [
            "my-schedule-is-open"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我十點以前滿忙的，但十點過後我的時間就空出來了。",
      "audio": {
        "src": "/audio/sentences/setting-meeting-time/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ec9f2c1ebc4f6c167ea738510f554d1603944cce9031aa76cea213e0c46de519",
        "sha256": "a73032fd1839bd2b24a062bfc1ee7edbe84177e860cac8a5e43280c49f847320"
      }
    },
    {
      "segments": [
        {
          "text": "Ten thirty would "
        },
        {
          "text": "suit me perfectly",
          "phraseIds": [
            "suit-me-perfectly"
          ]
        },
        {
          "text": ", does that sound "
        },
        {
          "text": "convenient",
          "wordIds": [
            "convenient"
          ]
        },
        {
          "text": " for you?"
        }
      ],
      "translation": "十點半對我來說非常合適，這個時間對你來說方便嗎？",
      "audio": {
        "src": "/audio/sentences/setting-meeting-time/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "610eaf1bb63ff8cfcaaf90c30d8317d4e41e4b17a9f00ee599411848cb78ce66",
        "sha256": "b2b1b21b95022f9f8b7a842b453e3ad30f988b71a65c6d8abc97b09be7ac8976"
      }
    },
    {
      "segments": [
        {
          "text": "Yes, meeting "
        },
        {
          "text": "earlier",
          "phraseIds": [
            "earlier-in-the-day"
          ],
          "wordIds": [
            "early"
          ]
        },
        {
          "text": " in the day",
          "phraseIds": [
            "earlier-in-the-day"
          ]
        },
        {
          "text": " is much better before it gets too hot."
        }
      ],
      "translation": "可以，在天氣變太熱之前早一點碰面好很多。",
      "audio": {
        "src": "/audio/sentences/setting-meeting-time/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "d26bdb5b9adf5df44a1e8cceea6dddda4c1a4ecd6beb7551aaa3c2651521f0c3",
        "sha256": "a7cd99aeab05917a3c76c82162e9610f012c9e4054311dcd33390a030ef92d3f"
      }
    },
    {
      "segments": [
        {
          "text": "What is your "
        },
        {
          "text": "plan",
          "wordIds": [
            "plan"
          ]
        },
        {
          "text": " for where to "
        },
        {
          "text": "meet",
          "wordIds": [
            "meet"
          ]
        },
        {
          "text": " so nobody gets lost along the "
        },
        {
          "text": "busy",
          "wordIds": [
            "busy"
          ]
        },
        {
          "text": " road?"
        }
      ],
      "translation": "對於要在哪裡碰面才不會有人在熱鬧的馬路上迷路，你有什麼計畫嗎？",
      "audio": {
        "src": "/audio/sentences/setting-meeting-time/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f65a997c2d30aa9f479c084cfa0150c46b760c0e68a02ebe3832474353b55e0b",
        "sha256": "254428eb293f6acc74d3e8917dd028c101e1321576b5160e7462eb1783e3c15f"
      }
    },
    {
      "segments": [
        {
          "text": "Let us "
        },
        {
          "text": "meet",
          "wordIds": [
            "meet"
          ]
        },
        {
          "text": " right "
        },
        {
          "text": "outside the subway exit",
          "phraseIds": [
            "outside-the-subway-exit"
          ]
        },
        {
          "text": " near the bakery clock tower."
        }
      ],
      "translation": "我們就約在麵包店時鐘塔附近的捷運站出口正外面吧。",
      "audio": {
        "src": "/audio/sentences/setting-meeting-time/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "84e9a9f398a26fd09e260791a2315d7b54241ff0ba7792c6a3865b9fc75004a4",
        "sha256": "9fdae959db16d2181bae7bedf97fa47087729c849991edd572c73194573641aa"
      }
    }
  ]
