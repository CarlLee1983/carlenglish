  "sentences": [
    {
      "segments": [
        {
          "text": "Good afternoon, this is my first time visiting this local "
        },
        {
          "text": "clinic",
          "wordIds": [
            "clinic"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "午安，這是我第一次來這間社區診所看診。",
      "audio": {
        "src": "/audio/sentences/clinic-check-in/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "5e7d9865fb0a6ee1e3742e39442ee9f6af8f0aeaa1b18547b0deb3cb9a880372",
        "sha256": "68bf567d8dd700ec11f1c56dcd2b4cb27d30cb0f7b04f5ba4a40dcaf02d59d3c"
      }
    },
    {
      "segments": [
        {
          "text": "Please show your health card and "
        },
        {
          "text": "fill",
          "phraseIds": [
            "fill-out-this-form"
          ],
          "wordIds": [
            "fill"
          ]
        },
        {
          "text": " out this ",
          "phraseIds": [
            "fill-out-this-form"
          ]
        },
        {
          "text": "form",
          "phraseIds": [
            "fill-out-this-form"
          ],
          "wordIds": [
            "form"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "請出示您的健保卡，並幫我填寫這張初診表單。",
      "audio": {
        "src": "/audio/sentences/clinic-check-in/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ff5cd023f2b5886e69f8534e67b872721803b5591b0f4b536c04ef5c2cd07c59",
        "sha256": "e541125f2aeb2e0e9c466e7170de4ad001adb3e69360839d980018223688547e"
      }
    },
    {
      "segments": [
        {
          "text": "I "
        },
        {
          "text": "have a mild ",
          "phraseIds": [
            "have-a-mild-fever"
          ]
        },
        {
          "text": "fever",
          "phraseIds": [
            "have-a-mild-fever"
          ],
          "wordIds": [
            "fever"
          ]
        },
        {
          "text": " and my body feels very tired."
        }
      ],
      "translation": "我有點微燒，而且全身感覺非常疲倦。",
      "audio": {
        "src": "/audio/sentences/clinic-check-in/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "efa62fccd0d0d110cc4b7ee0e014aa26fd19c71c3e8cacd5815b1c474a577d0c",
        "sha256": "1e4fd48ef5f4cdf8ed64be6a4b9ba04be61ace059249b18ad94e2459ef20a205"
      }
    },
    {
      "segments": [
        {
          "text": "Let me "
        },
        {
          "text": "take your temperature",
          "phraseIds": [
            "take-your-temperature"
          ]
        },
        {
          "text": " with the forehead thermometer first."
        }
      ],
      "translation": "讓我先用額溫槍幫您量一下體溫。",
      "audio": {
        "src": "/audio/sentences/clinic-check-in/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c3b26a9a4a294632afee6eb936a8d4405483dcf202c41607543efaa32796c69e",
        "sha256": "b32f717be459c64fa2652ace828002c64b79135d9473935466a7eae9fb4d3871"
      }
    },
    {
      "segments": [
        {
          "text": "Your "
        },
        {
          "text": "waiting ",
          "phraseIds": [
            "waiting-number"
          ]
        },
        {
          "text": "number",
          "phraseIds": [
            "waiting-number"
          ],
          "wordIds": [
            "number"
          ]
        },
        {
          "text": " is twenty-seven, please sit in the waiting room."
        }
      ],
      "translation": "您的候診號碼是二十七號，請先在候診室坐著稍候。",
      "audio": {
        "src": "/audio/sentences/clinic-check-in/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "afaf549848693a81bbd7050c35d57762c82b4050d89ee2f32880d8aefb94f874",
        "sha256": "66fbd4b47094b1a5ac75f21c43e9d4e8a54d40d124f81f51528d042d15ba713d"
      }
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "nurse",
          "wordIds": [
            "nurse"
          ]
        },
        {
          "text": " will "
        },
        {
          "text": "call your name",
          "phraseIds": [
            "call-your-name"
          ]
        },
        {
          "text": " when the doctor is ready."
        }
      ],
      "translation": "當醫師準備好時，護理師會叫您的名字。",
      "audio": {
        "src": "/audio/sentences/clinic-check-in/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "20bcdbbd9f496c3625fe97f93d772f3ae1719629585933bb2c3bb0f6c40269b4",
        "sha256": "36aaabdea1ca7fc9a1b0c2f0c546848b722af599a56c18bf3d4ceb1154d9b406"
      }
    }
  ]
