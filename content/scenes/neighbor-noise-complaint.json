  "sentences": [
    {
      "segments": [
        {
          "text": "Good evening neighbor, could I "
        },
        {
          "text": "have a brief word",
          "phraseIds": [
            "have-a-brief-word"
          ]
        },
        {
          "text": " with you about last "
        },
        {
          "text": "night",
          "wordIds": [
            "night"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "鄰居晚安，我可以跟您簡短聊一下昨天晚上的事情嗎？",
      "audio": {
        "src": "/audio/sentences/neighbor-noise-complaint/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ce05f76e516de0123465851ee2e72d2332495b023dddbbcf74e2f614c18f2d7d",
        "sha256": "63ffbb332f05953fb08310420cc213bb66f11c01f05c4269bcee63d3aef06cef"
      }
    },
    {
      "segments": [
        {
          "text": "Of course, did something unusual happen that disturbed your evening?"
        }
      ],
      "translation": "當然可以，是有發生什麼不尋常的事情打擾到您的夜晚了嗎？",
      "audio": {
        "src": "/audio/sentences/neighbor-noise-complaint/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "3926bddacddf78c5a37b5284440213cbec98603a24228e3dd8968519ace9ae3d",
        "sha256": "46aa10756ce9f329806ef28444d2aeea5198fe5a56801d0d1baa27f67d902476"
      }
    },
    {
      "segments": [
        {
          "text": "There was "
        },
        {
          "text": "loud",
          "wordIds": [
            "loud"
          ]
        },
        {
          "text": " footsteps and heavy furniture dragging downstairs "
        },
        {
          "text": "around midnight",
          "phraseIds": [
            "around-midnight"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "大概在半夜十二點左右，樓下傳來了很大聲的腳步聲和沉重的拖拉家具聲。",
      "audio": {
        "src": "/audio/sentences/neighbor-noise-complaint/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c39b17aa014d04757e7b238d65fdb8ca8e3121c1163aec6a355ef7ca1fc0c9a8",
        "sha256": "ad45f4bfa1df9672da81309527b73296f8d271f632b0b15b873015aa54e600d7"
      }
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "noise",
          "wordIds": [
            "noise"
          ]
        },
        {
          "text": " made it "
        },
        {
          "text": "difficult to fall asleep",
          "phraseIds": [
            "difficult-to-fall-asleep"
          ]
        },
        {
          "text": " and get good "
        },
        {
          "text": "sleep",
          "wordIds": [
            "sleep"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "那個噪音讓人難以入睡，也很難好好睡覺。",
      "audio": {
        "src": "/audio/sentences/neighbor-noise-complaint/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "5f2f54cf8665d9c4d519bae9d03f29129d042e25518d743377e5ca7493123140",
        "sha256": "97013c8782d94ebf649e7557abd5287cf3103d4fd425c055bbf31587009e5c22"
      }
    },
    {
      "segments": [
        {
          "text": "I am "
        },
        {
          "text": "so sorry about that",
          "phraseIds": [
            "so-sorry-about-that"
          ]
        },
        {
          "text": ", my friends helped me rearrange heavy bookshelves late at "
        },
        {
          "text": "night",
          "wordIds": [
            "night"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我對此感到非常抱歉，昨晚我朋友很晚才來幫忙我搬動笨重的書架。",
      "audio": {
        "src": "/audio/sentences/neighbor-noise-complaint/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "14ef799bb77453695702a4cfa91268ab512cb3a1f1771495ae6e5b5f8a248564",
        "sha256": "810cb6302919d0ce98f74bb987c33ad1581b89d7801695e77363aff4e5777607"
      }
    },
    {
      "segments": [
        {
          "text": "We promise to "
        },
        {
          "text": "keep things completely ",
          "phraseIds": [
            "keep-things-completely-quiet"
          ]
        },
        {
          "text": "quiet",
          "phraseIds": [
            "keep-things-completely-quiet"
          ],
          "wordIds": [
            "quiet"
          ]
        },
        {
          "text": " and in "
        },
        {
          "text": "peace",
          "wordIds": [
            "peace"
          ]
        },
        {
          "text": " after ten o'clock from now on."
        }
      ],
      "translation": "我們保證從今以後晚上十點過後一定會保持完全的安靜與平靜。",
      "audio": {
        "src": "/audio/sentences/neighbor-noise-complaint/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e3760d8d47112be7e7efb1b75bd11379d9e0113082969e1137375f84cd3c5698",
        "sha256": "29362297712299ccd7bc8c668756658989282307801a0bc2c389db80ae3c4961"
      }
    }
  ]
