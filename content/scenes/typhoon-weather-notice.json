  "sentences": [
    {
      "segments": [
        {
          "text": "The government weather bureau issued a strong land "
        },
        {
          "text": "typhoon warning",
          "phraseIds": [
            "typhoon-warning"
          ]
        },
        {
          "text": " this morning."
        }
      ],
      "translation": "政府氣象局今天早上發布了強烈陸上颱風警報。",
      "audio": {
        "src": "/audio/sentences/typhoon-weather-notice/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "6cc4dab702f2a66a25d35869cbc8e414b9ef353a066c6723830996431194da1c",
        "sha256": "ec6d3e87ae37612c017b451403c5c2d1f33815d6a65e747cfe860718ff5be6aa"
      }
    },
    {
      "segments": [
        {
          "text": "Heavy ",
          "phraseIds": [
            "heavy-rain-and-winds"
          ]
        },
        {
          "text": "rain",
          "phraseIds": [
            "heavy-rain-and-winds"
          ],
          "wordIds": [
            "rain"
          ]
        },
        {
          "text": " and ",
          "phraseIds": [
            "heavy-rain-and-winds"
          ]
        },
        {
          "text": "winds",
          "phraseIds": [
            "heavy-rain-and-winds"
          ],
          "wordIds": [
            "wind"
          ]
        },
        {
          "text": " are expected across the entire city tonight."
        }
      ],
      "translation": "預計今晚整座城市都會出現豪大雨與強烈陣風。",
      "audio": {
        "src": "/audio/sentences/typhoon-weather-notice/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "6a68895ef3cb8cd0131eba7f233b5f9d02884b9349d00335d8d886293d8e843f",
        "sha256": "e8d243cc411d877b277642c4ad6fb721f46e1c9b21ca06f448bc845c8c85723b"
      }
    },
    {
      "segments": [
        {
          "text": "All schools and public offices received an "
        },
        {
          "text": "official ",
          "phraseIds": [
            "official-notice"
          ]
        },
        {
          "text": "notice",
          "phraseIds": [
            "official-notice"
          ],
          "wordIds": [
            "notice"
          ]
        },
        {
          "text": " to close tomorrow."
        }
      ],
      "translation": "所有學校與公家機關都收到了明天全面停班停課的正式通報。",
      "audio": {
        "src": "/audio/sentences/typhoon-weather-notice/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f278678d9ddc436738c71674c54d5688301c6dd7c681a72e44897138cd9ae9d7",
        "sha256": "558bbc60c89b41ae60f7eadb11d0a2abf51f20a9758868aec3fa2e2943f4dafe"
      }
    },
    {
      "segments": [
        {
          "text": "We must "
        },
        {
          "text": "cancel",
          "wordIds": [
            "cancel"
          ]
        },
        {
          "text": " our outdoor soccer match "
        },
        {
          "text": "for safety reasons",
          "phraseIds": [
            "for-safety-reasons"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "出於安全考量，我們必須取消原定舉辦的戶外足球比賽。",
      "audio": {
        "src": "/audio/sentences/typhoon-weather-notice/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c59b446dd36842c97415e662a02dc81f0f56dbaae772b2197dee6aec31e54ece",
        "sha256": "6b81c03bfb53f62d4ec41d4ef3fc4c877cc57c06059fd274efe27d26bf397afb"
      }
    },
    {
      "segments": [
        {
          "text": "Let us "
        },
        {
          "text": "change",
          "wordIds": [
            "change"
          ]
        },
        {
          "text": " the tournament date to next Saturday when the "
        },
        {
          "text": "storm",
          "wordIds": [
            "storm"
          ]
        },
        {
          "text": " clears."
        }
      ],
      "translation": "我們把錦標賽日期改到下週六，等暴風雨遠離天晴之後再舉行。",
      "audio": {
        "src": "/audio/sentences/typhoon-weather-notice/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "999561eefe9cc7279d9750c63f1bd1f7b02ceaa7f44694e8894736e82c693049",
        "sha256": "4fae15a24af7db9141b81bc10c45ae8f2a0d7b77162326c8f6520d47f8e1b8a9"
      }
    },
    {
      "segments": [
        {
          "text": "Remember to "
        },
        {
          "text": "stay safely at home",
          "phraseIds": [
            "stay-safely-at-home"
          ]
        },
        {
          "text": " and tape the large glass windows securely."
        }
      ],
      "translation": "請大家務必平安待在家裡，並用膠帶把大片玻璃窗戶貼牢固定。",
      "audio": {
        "src": "/audio/sentences/typhoon-weather-notice/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "7b1de742809e2ddbd85ca48dd8456d9506d85abbe4200ba5fbad950721d51886",
        "sha256": "b7a617011c6f7061dc1a6df628af4cf9bd744bc2eb4b9e949071c25173b05ca7"
      }
    }
  ]
}
