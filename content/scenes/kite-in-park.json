          "wordIds": [
            "park"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "小美帶著風箏去公園。",
      "audio": {
        "src": "/audio/sentences/kite-in-park/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "726b4fbd00ed7543a81c7cf649c041c1df5b7ada29c7e0de5838e056d1e5c1c8",
        "sha256": "ddd24f52714f353447b2d144a1f2bcc2b6790882f9b921b53e1fed109f76dc56"
      }
    },
    {
      "segments": [
        {
          "text": "Dad holds it while she gets the "
        },
        {
          "text": "string",
          "wordIds": [
            "string"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "爸爸拿著風箏，小美拿起風箏線。",
      "audio": {
        "src": "/audio/sentences/kite-in-park/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ca5574e94d4ec6be62296dfcd2b81650dc69c82fa5ba55ee84f8bd47263e21ed",
        "sha256": "58b044ebc4be76908dd5c96a026e556b8c6158d08c9dba250a0f050ea69c3946"
      }
    },
    {
      "segments": [
        {
          "text": "“Ready? "
        },
        {
          "text": "Let go",
          "phraseIds": [
            "let-go"
          ]
        },
        {
          "text": "!” she calls to Dad."
        }
      ],
      "translation": "她對爸爸喊：「準備好了嗎？放手！」",
      "audio": {
        "src": "/audio/sentences/kite-in-park/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f534d3349cc54cbaff27b012a87eebe4913e15abb9b5ebadf7ef360fb47e6b11",
