  "sentences": [
    {
      "segments": [
        {
          "text": "I need to stop by the bank ATM to "
        },
        {
          "text": "withdraw ",
          "phraseIds": [
            "withdraw-cash"
          ]
        },
        {
          "text": "cash",
          "phraseIds": [
            "withdraw-cash"
          ],
          "wordIds": [
            "cash"
          ]
        },
        {
          "text": " before going to the market."
        }
      ],
      "translation": "去市場之前，我需要先去一下銀行 ATM 提領現金。",
      "audio": {
        "src": "/audio/sentences/using-atm-cash-withdrawal/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c736d1d5a3e80fc4ee24dc1723fb48e4a8e22acd0828a19cc58aec89af3e51f4",
        "sha256": "b4f5d2ad3d7a6774096d0a72100096c90beb35353740836f4412bcad62cb9a95"
      }
    },
    {
      "segments": [
        {
          "text": "Insert your debit card",
          "phraseIds": [
            "insert-your-debit-card"
          ]
        },
        {
          "text": " into the slot and choose your language on the screen."
        }
      ],
      "translation": "把你的金融卡插入插槽中，並在螢幕上選擇你的語言。",
      "audio": {
        "src": "/audio/sentences/using-atm-cash-withdrawal/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e730ad6d3f54c11bd892aeba84b53fb416db7d85db463fef35695e3ff062567b",
        "sha256": "a9c1acb25f0daabbb0817a1e359f26a89903c3ff492f0fb027600bae34b7ec3c"
      }
    },
    {
      "segments": [
        {
          "text": "Please "
        },
        {
          "text": "enter",
          "wordIds": [
            "enter"
          ]
        },
        {
          "text": " your secret six-digit "
        },
        {
          "text": "security code",
          "phraseIds": [
            "security-code"
          ]
        },
        {
          "text": " carefully on the keypad."
        }
      ],
      "translation": "請在數字鍵盤上小心輸入你的六位數個人安全密碼。",
      "audio": {
        "src": "/audio/sentences/using-atm-cash-withdrawal/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "1d0c8b192509db288c3b9b70d0e848620aa6cbd42a8c5d2f58001c56fca85259",
        "sha256": "1b6b7f4f83299db6ed9e5726363e36b2e450d2833b3b7117ded352710fc314d1"
      }
    },
    {
      "segments": [
        {
          "text": "Press the button to withdraw two "
        },
        {
          "text": "thousand",
          "wordIds": [
            "thousand"
          ]
        },
        {
          "text": " dollars "
        },
        {
          "text": "from your savings ",
          "phraseIds": [
            "from-your-savings-account"
          ]
        },
        {
          "text": "account",
          "phraseIds": [
            "from-your-savings-account"
          ],
          "wordIds": [
            "account"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "按下按鈕從你的儲蓄帳戶中提領兩千元現金。",
      "audio": {
        "src": "/audio/sentences/using-atm-cash-withdrawal/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ed4449de2ab91d0e1fe52873d99d444361c7fee3923f1f9c9c6246bf42c0616c",
        "sha256": "b5abeedaaab98cd5c9fcbac021d762a0744cedeacfd1a934c9f96d183b79d985"
      }
    },
    {
      "segments": [
        {
          "text": "Do not forget to take your bank card before the machine dispenses the paper "
        },
        {
          "text": "money",
          "wordIds": [
            "money"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "在機器吐出紙鈔之前，千萬不要忘記先把你的銀行卡抽走。",
      "audio": {
        "src": "/audio/sentences/using-atm-cash-withdrawal/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "3396ca8e4fb86360ad3e420d4b5d8c12315171de1835ba83cd1f59b02db709dd",
        "sha256": "2e32742dc979d9fa0f2719687d10b5d1f12b50c6f8b8561d4e74efb25b37ab5d"
      }
    },
    {
      "segments": [
        {
          "text": "The printed transaction receipt shows your remaining "
        },
        {
          "text": "account",
          "phraseIds": [
            "account-balance"
          ],
          "wordIds": [
            "account"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "balance",
          "phraseIds": [
            "account-balance"
          ],
          "wordIds": [
            "balance"
          ]
        },
        {
          "text": " accurately."
        }
      ],
      "translation": "印出來的交易明細收據清楚準確地顯示了你帳戶目前的剩餘餘額。",
      "audio": {
        "src": "/audio/sentences/using-atm-cash-withdrawal/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "99f376824307e3398f22a78433ceefcb933e8f6fd228177d6bc6ca7fa59866a8",
        "sha256": "0c2df489aea399bacd711bf56e15b4089b99f48e407207316dd7408fd287d205"
      }
    }
  ]
