  "sentences": [
    {
      "segments": [
        {
          "text": "An sees her "
        },
        {
          "text": "shadow",
          "wordIds": [
            "shadow"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "on the ",
          "phraseIds": [
            "on-the-ground"
          ]
        },
        {
          "text": "ground",
          "phraseIds": [
            "on-the-ground"
          ],
          "wordIds": [
            "ground"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "小安看見地上自己的影子。",
      "audio": {
        "src": "/audio/sentences/shadow-play/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "838bb9b498385e575fad05913eb0ca091139ae7860f2bcfc5b72c0015744a020",
        "sha256": "1714b856015dacd5cf880bdb834df808804f51ec2394c30697ec90065accfa10"
      }
    },
    {
      "segments": [
        {
          "text": "She "
        },
        {
          "text": "waves",
          "wordIds": [
            "waves"
          ]
        },
        {
          "text": ", and her "
        },
        {
          "text": "shadow",
          "wordIds": [
            "shadow"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "moves too",
          "phraseIds": [
            "moves-too"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "她揮揮手，她的影子也跟著動。",
      "audio": {
        "src": "/audio/sentences/shadow-play/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "1e4ea161af442ce18a55518d9f948be57d6f25101b585fab7e8e3c0dd7bb2450",
        "sha256": "b4b9bf86b85ae05b13918fc371b7cf44ba9e79b1ffced45fe03f758c3425f240"
      }
    },
    {
      "segments": [
        {
          "text": "“Its "
        },
        {
          "text": "arms",
          "wordIds": [
            "arms"
          ]
        },
        {
          "text": " are long!” she says."
        }
      ],
      "translation": "她說：「它的手臂好長！」",
      "audio": {
        "src": "/audio/sentences/shadow-play/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "a8fed143461a819dd751220ba7fa6f2207af51e69e633abce4ef2f7e809665f4",
        "sha256": "3d057af936c01b6478f513fe0f3331551e51afe554ab5395fe38892d48617381"
      }
    },
    {
      "segments": [
        {
          "text": "Dad stands beside her "
        },
        {
          "text": "in the ",
          "phraseIds": [
            "in-the-sun"
          ]
        },
        {
          "text": "sun",
          "phraseIds": [
            "in-the-sun"
          ],
          "wordIds": [
            "sun"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "爸爸在陽光下站在她旁邊。",
      "audio": {
        "src": "/audio/sentences/shadow-play/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "aaa0d398971b4a7697af5baad8b479120435e6f1959ecb3a7016d1330a456a64",
        "sha256": "172b301eb3bae050b418a30e65950252eeb7421098e0363a057da691488a6cc2"
      }
    },
    {
      "segments": [
        {
          "text": "They "
        },
        {
          "text": "make shapes",
          "phraseIds": [
            "make-shapes"
          ]
        },
        {
          "text": " with their "
        },
        {
          "text": "hands",
          "wordIds": [
            "hands"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "他們用手做出各種形狀。",
      "audio": {
        "src": "/audio/sentences/shadow-play/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9758bbf2df866d16bb0bfe70ff8a1902d1fc85ab8c8b1a781de8734029fb91b4",
        "sha256": "bdeb8c5f8b4804c65abb88eaf840ed05fdc7ad871baaacdcac3ff1c2ce8dea8a"
      }
    },
    {
      "segments": [
        {
          "text": "“Our shadows are dancing!” says An."
        }
      ],
      "translation": "小安說：「我們的影子在跳舞！」",
      "audio": {
        "src": "/audio/sentences/shadow-play/6.mp3",
