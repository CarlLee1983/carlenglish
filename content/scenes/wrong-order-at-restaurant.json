  "sentences": [
    {
      "segments": [
        {
          "text": "Excuse me, I think there is "
        },
        {
          "text": "a small ",
          "phraseIds": [
            "a-small-mistake"
          ]
        },
        {
          "text": "mistake",
          "phraseIds": [
            "a-small-mistake"
          ],
          "wordIds": [
            "mistake"
          ]
        },
        {
          "text": " here; this is not "
        },
        {
          "text": "what I ordered",
          "phraseIds": [
            "what-i-ordered"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "不好意思，我想這裡有點小差錯，這不是我點的餐點。",
      "audio": {
        "src": "/audio/sentences/wrong-order-at-restaurant/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "4bc81d7fdfb33d7fc93efca40c27a9e036b69e39ebd34153c025244489c54064",
        "sha256": "aa13dcae7c5e46c24acb59bb12bf541e999cbdec8ef020cf625ebf30074d5cf2"
      }
    },
    {
      "segments": [
        {
          "text": "This "
        },
        {
          "text": "wrong",
          "wordIds": [
            "wrong"
          ]
        },
        {
          "text": " plate is a beef burger, but my "
        },
        {
          "text": "order",
          "wordIds": [
            "order"
          ]
        },
        {
          "text": " was the chicken sandwich."
        }
      ],
      "translation": "這份送錯的盤子是牛肉漢堡，但我點的是雞肉三明治。",
      "audio": {
        "src": "/audio/sentences/wrong-order-at-restaurant/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e1d1483c56a5910cc1fff66b4191aea97142afb3769c6347f2d6e1fe9090f974",
        "sha256": "7d40e9b584a972d2367a1270d384574f2966a10995de2ee14789fe5750fb787f"
      }
    },
    {
      "segments": [
        {
          "text": "Oh, I am really "
        },
        {
          "text": "sorry about that",
          "phraseIds": [
            "sorry-about-that"
          ]
        },
        {
          "text": " confusion."
        }
      ],
      "translation": "噢，真的非常抱歉造成混淆。",
      "audio": {
        "src": "/audio/sentences/wrong-order-at-restaurant/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "68514b65a6f3c006c001697a32caba0807e044ae21b12fb73e1357dd1f25d089",
        "sha256": "71f2bcd13c7fc182351f6853252c1d8b530188fc3de18dff64ae0bc6f9f4f965"
      }
    },
    {
      "segments": [
        {
          "text": "Let me "
        },
        {
          "text": "check",
          "wordIds": [
            "check"
          ]
        },
        {
          "text": " your ticket with the kitchen staff right now."
        }
      ],
      "translation": "我現在立刻拿您的點菜單去和廚房人員核對。",
      "audio": {
        "src": "/audio/sentences/wrong-order-at-restaurant/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c01f15ea85c5f5d93d8ec5dcb5f73e6c9f077a61cfe820641c02fadd64a5b006",
        "sha256": "f669f1da0981f75c3d6a466df7b271dbb02b1f15ca98f5f4c1e085dc011d40ab"
      }
    },
    {
      "segments": [
        {
          "text": "We will bring you the correct chicken sandwich "
        },
        {
          "text": "in just five ",
          "phraseIds": [
            "in-just-five-minutes"
          ]
        },
        {
          "text": "minutes",
          "phraseIds": [
            "in-just-five-minutes"
          ],
          "wordIds": [
            "minute"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我們會在五分鐘內把正確的雞肉三明治端給您。",
      "audio": {
        "src": "/audio/sentences/wrong-order-at-restaurant/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "d7011b1b076b4fc5f92bca33b124446271fe5ab180be65b7bfd3970c84cc88d4",
        "sha256": "ce53f840ace0305fd7e1f005c7d22da8d22df89003d25314d697fc52436b607c"
      }
    },
    {
      "segments": [
        {
          "text": "Of ",
          "phraseIds": [
            "of-course"
          ]
        },
        {
          "text": "course",
          "phraseIds": [
            "of-course"
          ],
          "wordIds": [
            "course"
          ]
        },
        {
          "text": ", please keep your drink while you wait."
        }
      ],
      "translation": "當然，等候的時候請先享用您的飲料。",
      "audio": {
        "src": "/audio/sentences/wrong-order-at-restaurant/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "975e67f0f58c0b19c716bd343cac25f4ab97e67b77544e47c18e973f0661b024",
