  "sentences": [
    {
      "segments": [
        {
          "text": "Excuse me, do you provide free "
        },
        {
          "text": "customer Wi-Fi",
          "phraseIds": [
            "customer-wifi"
          ]
        },
        {
          "text": " access in this coffee shop?"
        }
      ],
      "translation": "不好意思，請問這間咖啡店有提供給客人的免費無線網路嗎？",
      "audio": {
        "src": "/audio/sentences/cafe-wifi-password/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "b947f0d39a2134e9f99e589a5253938fbed79cf328ef5d0d3c5cd406c6b9960f",
        "sha256": "5e9cf3fcb7837d40233eccb676c32bf96e144fef8ae777236505ef96cde428ce"
      }
    },
    {
      "segments": [
        {
          "text": "Yes, look for the "
        },
        {
          "text": "network name",
          "phraseIds": [
            "network-name"
          ]
        },
        {
          "text": " printed on your payment receipt."
        }
      ],
      "translation": "有的，請看印在您結帳發票收據上的網路名稱。",
      "audio": {
        "src": "/audio/sentences/cafe-wifi-password/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "8be4da9b6bb7baba80d440cfce64b54e9ecf8ca6536e872fe186223af04539fd",
        "sha256": "045b8263b52b3ee0bf459d9f445c1488e6f4481614b517f8e405c77693010bbc"
      }
    },
    {
      "segments": [
        {
          "text": "What is the "
        },
        {
          "text": "password",
          "phraseIds": [
            "password-to-connect"
          ],
          "wordIds": [
            "password"
          ]
        },
        {
          "text": " to ",
          "phraseIds": [
            "password-to-connect"
          ]
        },
        {
          "text": "connect",
          "phraseIds": [
            "password-to-connect"
          ],
          "wordIds": [
            "connect"
          ]
        },
        {
          "text": " my laptop to the internet?"
        }
      ],
      "translation": "請問要將我的筆電連上網路的密碼是什麼呢？",
      "audio": {
        "src": "/audio/sentences/cafe-wifi-password/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "361420dcf97d48467115272eeab1e352e04cb764eb1fc6efd04f09eb8df2400a",
        "sha256": "b15b86ccc91490c971e3a33b1bca24f965d1512b1ce742f58825ac927cbc2e05"
      }
    },
    {
      "segments": [
        {
          "text": "Type in the word",
          "phraseIds": [
            "type-in-the-word"
          ]
        },
        {
          "text": " coffee followed by the four digits 2026."
        }
      ],
      "translation": "請輸入單字 coffee，後面接著四個數字 2026。",
      "audio": {
        "src": "/audio/sentences/cafe-wifi-password/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "8655fa22fcee210eff21b52251f2fac8cc3c5bd90c589f9925a78b7eb313805b",
        "sha256": "402fd7d70ed40c559667b5315f2828ca994c3cb473f488d5bfbbdad38b78daa2"
      }
    },
    {
      "segments": [
        {
          "text": "Remember that the first "
        },
        {
          "text": "letter",
          "wordIds": [
            "letter"
          ]
        },
        {
          "text": " must be entered in lowercase."
        }
      ],
      "translation": "請記得第一個英文字母必須以小寫形式輸入。",
      "audio": {
        "src": "/audio/sentences/cafe-wifi-password/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "948ac9e698be96dfefaec27f1f51af1130df325e4cee352917f20f4268209bea",
        "sha256": "8b172c197fcbe7fe77055e204e07d282e5518c68cb5ceaafd51c56f25c14166c"
      }
    },
    {
      "segments": [
        {
          "text": "The Wi-Fi "
        },
        {
          "text": "signal",
          "phraseIds": [
            "signal-is-very-strong"
          ],
          "wordIds": [
            "signal"
          ]
        },
        {
          "text": " is very ",
          "phraseIds": [
            "signal-is-very-strong"
          ]
        },
        {
          "text": "strong",
          "phraseIds": [
            "signal-is-very-strong"
          ],
          "wordIds": [
            "strong"
          ]
        },
        {
          "text": " and "
        },
        {
          "text": "works",
          "wordIds": [
            "work"
          ]
        },
        {
          "text": " throughout the entire seating area."
        }
      ],
      "translation": "無線網路訊號非常強，在整個座位區都可以穩定使用。",
