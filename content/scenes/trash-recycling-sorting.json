  "sentences": [
    {
      "segments": [
        {
          "text": "Our building community follows a strict environmental "
        },
        {
          "text": "policy",
          "wordIds": [
            "policy"
          ]
        },
        {
          "text": " for "
        },
        {
          "text": "household waste",
          "phraseIds": [
            "household-waste"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我們大樓社區對於家戶廢棄物垃圾有著嚴格的環保規定政策。",
      "audio": {
        "src": "/audio/sentences/trash-recycling-sorting/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e22b183a96a83de924ea19750d6e8c5748cbb1cb18fecfdc6e93220d8288f660",
        "sha256": "dd97df0a9e93819295d3c80b0eefc963ec7039284114831d98fba584d7bca3b4"
      }
    },
    {
      "segments": [
        {
          "text": "Residents must "
        },
        {
          "text": "sort",
          "wordIds": [
            "sort"
          ]
        },
        {
          "text": " their "
        },
        {
          "text": "daily ",
          "phraseIds": [
            "daily-garbage"
          ]
        },
        {
          "text": "garbage",
          "phraseIds": [
            "daily-garbage"
          ],
          "wordIds": [
            "garbage"
          ]
        },
        {
          "text": " into general "
        },
        {
          "text": "trash",
          "wordIds": [
            "trash"
          ]
        },
        {
          "text": " and recyclable materials."
        }
      ],
      "translation": "住戶必須將日常垃圾確實分類成一般垃圾與可回收物料。",
      "audio": {
        "src": "/audio/sentences/trash-recycling-sorting/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "8f79ea0e15fad83216f4084cb88623f96bff5d1dbcea4943a50a7bb6650f53ad",
        "sha256": "f84db20500439251d49b271d09ce53d25fd2caf39553547d1df1beaced699b6f"
      }
    },
    {
      "segments": [
        {
          "text": "Flatten all paper boxes",
          "phraseIds": [
            "flatten-all-paper-boxes"
          ]
        },
        {
          "text": " and wash used plastic drink bottles before putting them in the "
        },
        {
          "text": "bins",
          "wordIds": [
            "bin"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "紙箱要壓平，用過的塑膠飲料瓶在丟入回收桶前要先沖洗乾淨。",
      "audio": {
        "src": "/audio/sentences/trash-recycling-sorting/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "45310fa4e4884bb88a867608a888549aa0cb4bb7de35f2a38f24ff05c1337933",
        "sha256": "bb761639e33a7800c5856348daa176848c028ce65d93a83e3290318c6b77306a"
      }
    },
    {
      "segments": [
        {
          "text": "Which colored bin is meant for "
        },
        {
          "text": "aluminum soda cans",
          "phraseIds": [
            "aluminum-soda-cans"
          ]
        },
        {
          "text": " and metal food tins?"
        }
      ],
      "translation": "請問哪一個顏色的桶子是用來裝汽水鋁罐和金屬食品鐵罐的？",
      "audio": {
        "src": "/audio/sentences/trash-recycling-sorting/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9f6f26f57d2db1951e5d11c9ca2e12c2ae2dd646d13ed68bd3fb55beb64eca2b",
        "sha256": "df409d1c692ebbd2edb33677544c15fa1f54652da9089960c42062c269fe5aa7"
      }
    },
    {
      "segments": [
        {
          "text": "Toss clean metal cans into the yellow bin marked with the circular "
        },
        {
          "text": "recycle",
          "phraseIds": [
            "recycle-symbol"
          ],
          "wordIds": [
            "recycle"
          ]
        },
        {
          "text": " symbol",
          "phraseIds": [
            "recycle-symbol"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "把乾淨的金屬罐丟入印有圓形循環回收標誌的黃色桶子中。",
      "audio": {
        "src": "/audio/sentences/trash-recycling-sorting/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e9db0560d343b3db36648c34005691e84fb014712a6a65f30c53ddaea1d36b3c",
        "sha256": "0d673068a823d8cce5cf61846bdb126b9d406bef4372bc084dde79f03466615d"
      }
    },
    {
      "segments": [
        {
          "text": "Following these simple sorting rules helps keep our neighborhood clean and green."
        }
      ],
      "translation": "遵守這些簡單的分類守則，能讓我們的社區保持潔淨與綠意盎然。",
      "audio": {
        "src": "/audio/sentences/trash-recycling-sorting/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "97149df15860a4dd8e9977a1becf73e1630ee458c0c0f8e9084f7fcb44534304",
