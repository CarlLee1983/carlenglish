  "sentences": [
    {
      "segments": [
        {
          "text": "Alex visits the guidance counselor's office to discuss which university "
        },
        {
          "text": "subject",
          "wordIds": [
            "subject"
          ]
        },
        {
          "text": " best matches his strengths."
        }
      ],
      "translation": "Alex 來到生涯輔導室，討論哪一個大學學科最符合他的優勢。"
    },
    {
      "segments": [
        {
          "text": "Ms. Lin smiles warmly, points to an exploratory chart, and asks, “"
        },
        {
          "text": "What are your interests?",
          "phraseIds": [
            "what-are-your-interests"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "林老師親切地微笑著，指著探索圖表問道：「你的興趣是什麼？」"
    },
    {
      "segments": [
        {
          "text": "Alex explains his deep "
        },
        {
          "text": "interest",
          "wordIds": [
            "interest"
          ]
        },
        {
          "text": " in technology and design, adding, “"
        },
        {
          "text": "I'd like to learn more about",
          "phraseIds": [
            "id-like-to-learn-more-about"
          ]
        },
        {
          "text": " interactive media.”"
        }
      ],
      "translation": "Alex 說明了他對科技與設計的濃厚興趣，並補充說：「我想多了解互動媒體。」"
    },
    {
      "segments": [
        {
          "text": "Ms. Lin suggests combining both fields into an interdisciplinary college "
        },
        {
          "text": "major",
          "wordIds": [
            "major"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "林老師建議將這兩個領域結合，作為大學的跨領域主修。"
    },
    {
      "segments": [
        {
          "text": "Looking over the degree pathways together, she encourages him, “"
        },
        {
          "text": "Consider your ",
          "phraseIds": [
            "consider-your-future-career"
          ]
        },
        {
          "text": "future",
          "phraseIds": [
            "consider-your-future-career"
          ],
          "wordIds": [
            "future"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "career",
          "phraseIds": [
            "consider-your-future-career"
          ],
          "wordIds": [
            "career"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "consider-your-future-career"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "一起檢視學位發展路徑時，她鼓勵他：「考慮你未來的職業發展。」"
    },
    {
      "segments": [
        {
          "text": "Alex organizes his ideas into a clear study plan and smiles, “"
        },
        {
          "text": "Thank you for the ",
          "phraseIds": [
            "thank-you-for-the-advice"
          ]
        },
        {
          "text": "advice",
          "phraseIds": [
            "thank-you-for-the-advice"
          ],
          "wordIds": [
            "advice"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "thank-you-for-the-advice"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Alex 將自己的想法整理成一份清晰的學習計畫，微笑著說：「謝謝您的建議。」"
    }
  ],
