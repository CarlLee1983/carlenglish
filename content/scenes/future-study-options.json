  "sentences": [
    {
      "segments": [
        {
          "text": "Alex visits the guidance counselor's office to discuss which university "
        },
        {
          "text": "subject",
          "wordIds": [
            "subject"
          ]
        },
        {
          "text": " best matches his strengths."
        }
      ],
      "translation": "Alex 來到生涯輔導室，討論哪一個大學學科最符合他的優勢。",
      "audio": {
        "src": "/audio/sentences/future-study-options/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "cc44d5f083b1542160a0814ef36b93da6e9155af9b3e237968af85a0ef39f178",
        "sha256": "5222ed3bed351a1bcaf00c4125b090126b04d6b60c6c7621910ae9a7aeb567e7"
      }
    },
    {
      "segments": [
        {
          "text": "Ms. Lin smiles warmly, points to an exploratory chart, and asks, “"
        },
        {
          "text": "What are your interests?",
          "phraseIds": [
            "what-are-your-interests"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "林老師親切地微笑著，指著探索圖表問道：「你的興趣是什麼？」",
      "audio": {
        "src": "/audio/sentences/future-study-options/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9ec0510566a0b9701aef16f7865f2883cdf3d2d948ad75cd6106401ab8e54213",
        "sha256": "49c2ce1a94b6e7300cff6453e8d907fec1205848673b2d05fbf07180fa6d9f59"
      }
    },
    {
      "segments": [
        {
          "text": "Alex explains his deep "
        },
        {
          "text": "interest",
          "wordIds": [
            "interest"
          ]
        },
        {
          "text": " in technology and design, adding, “"
        },
        {
          "text": "I'd like to learn more about",
          "phraseIds": [
            "id-like-to-learn-more-about"
          ]
        },
        {
          "text": " interactive media.”"
        }
      ],
      "translation": "Alex 說明了他對科技與設計的濃厚興趣，並補充說：「我想多了解互動媒體。」",
      "audio": {
        "src": "/audio/sentences/future-study-options/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "3418703029bdf48a744c50f1d08127246051ab09e079821cc4ea0e0e28585f20",
        "sha256": "09e7de83b8836d0494a246de4063c5a3f72166a0fb2e098c9a5c2e96672641a0"
      }
    },
    {
      "segments": [
        {
          "text": "Ms. Lin suggests combining both fields into an interdisciplinary college "
        },
        {
          "text": "major",
          "wordIds": [
            "major"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "林老師建議將這兩個領域結合，作為大學的跨領域主修。",
      "audio": {
        "src": "/audio/sentences/future-study-options/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c1592b9c1985bcbdd432a532e7b8d4f4fe7f8edca577af2ef1b0277befafa71f",
        "sha256": "9d92cf5e18869848d51b817192972fa881983b971abc70bae5fd6881fed74fa5"
      }
    },
    {
      "segments": [
        {
          "text": "Looking over the degree pathways together, she encourages him, “"
        },
        {
          "text": "Consider your ",
          "phraseIds": [
            "consider-your-future-career"
          ]
        },
        {
          "text": "future",
          "phraseIds": [
            "consider-your-future-career"
          ],
          "wordIds": [
            "future"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "career",
          "phraseIds": [
            "consider-your-future-career"
          ],
          "wordIds": [
            "career"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "consider-your-future-career"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "一起檢視學位發展路徑時，她鼓勵他：「考慮你未來的職業發展。」",
      "audio": {
        "src": "/audio/sentences/future-study-options/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "915510b328acb6019b7d94f3e2122ff8fcc72a089e04d1dcc9253f4fdfe86772",
        "sha256": "150237d07db3829448cfbd749ff5d9e5319ec60f0956cc51447bd8bdf3fe519e"
      }
    },
    {
      "segments": [
        {
          "text": "Alex organizes his ideas into a clear study plan and smiles, “"
        },
        {
          "text": "Thank you for the ",
          "phraseIds": [
            "thank-you-for-the-advice"
          ]
        },
        {
          "text": "advice",
          "phraseIds": [
            "thank-you-for-the-advice"
          ],
          "wordIds": [
            "advice"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "thank-you-for-the-advice"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "Alex 將自己的想法整理成一份清晰的學習計畫，微笑著說：「謝謝您的建議。」",
      "audio": {
        "src": "/audio/sentences/future-study-options/6.mp3",
