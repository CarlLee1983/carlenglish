  "sentences": [
    {
      "segments": [
        {
          "text": "Teacher, I "
        },
        {
          "text": "fell",
          "wordIds": [
            "fall"
          ]
        },
        {
          "text": " while playing soccer and twisted my right ankle."
        }
      ],
      "translation": "老師，我踢足球時摔倒，扭傷了右腳踝。",
      "audio": {
        "src": "/audio/sentences/ice-pack-for-sprain/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "57f70e04f3ab58ce4537263238f9a273384ade089c0d80bb1928468b57cabbc8",
        "sha256": "7362207114382b923b47522d583c13b11824dffa8357de44030c60400ed2f32e"
      }
    },
    {
      "segments": [
        {
          "text": "Sit down right here, be "
        },
        {
          "text": "careful",
          "wordIds": [
            "careful"
          ]
        },
        {
          "text": ", "
        },
        {
          "text": "take a deep ",
          "phraseIds": [
            "take-a-deep-breath"
          ]
        },
        {
          "text": "breath",
          "phraseIds": [
            "take-a-deep-breath"
          ],
          "wordIds": [
            "breath"
          ]
        },
        {
          "text": ", and do not "
        },
        {
          "text": "put weight on that ",
          "phraseIds": [
            "put-weight-on-that-foot"
          ]
        },
        {
          "text": "foot",
          "phraseIds": [
            "put-weight-on-that-foot"
          ],
          "wordIds": [
            "foot"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "先在這裡坐下，小心一點，深呼吸一口氣，那隻腳千萬不要受力踩地。",
      "audio": {
        "src": "/audio/sentences/ice-pack-for-sprain/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "436b948ddf7decd911968faeb3a219b2d3752b2a483ed7375abf2c12d3cd910c",
        "sha256": "76658d4c3f94c82114331d06158dadf517f617fd35cbc3c61fe846b09c2c9373"
      }
    },
    {
      "segments": [
        {
          "text": "Is the skin around the ankle joint starting to "
        },
        {
          "text": "look swollen",
          "phraseIds": [
            "look-swollen"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "腳踝關節周圍的皮膚是不是已經開始腫起來了？",
      "audio": {
        "src": "/audio/sentences/ice-pack-for-sprain/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "2026a7a01bb8356894e90997690aeb8c1b95088186cd4d18ce37940addd9a19a",
        "sha256": "7706f98faf18e37d1128834207a750705af65d02ef0a45e94e827c8cd379a99d"
      }
    },
    {
      "segments": [
        {
          "text": "Yes, it looks red and feels very warm and painful."
        }
      ],
      "translation": "是的，看起來紅紅的，而且摸起來熱熱的非常痛。",
      "audio": {
        "src": "/audio/sentences/ice-pack-for-sprain/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "0e9fb123b223dd4ef2c6a195bd447a905477969c80a05bcd9f88f1c4d95b7894",
        "sha256": "4d4eab70bcae1aaf29a6b1944a2f211285f859644743cbeef8c7836b106c8ff6"
      }
    },
    {
      "segments": [
        {
          "text": "We need to put a "
        },
        {
          "text": "cold",
          "phraseIds": [
            "cold-ice-pack"
          ],
          "wordIds": [
            "cold"
          ]
        },
        {
          "text": " ice pack",
          "phraseIds": [
            "cold-ice-pack"
          ]
        },
        {
          "text": " on it for fifteen minutes."
        }
      ],
      "translation": "我們需要用冰袋在上面冰敷十五分鐘。",
      "audio": {
        "src": "/audio/sentences/ice-pack-for-sprain/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "027d18d2948a58981a9fe01913a25a63fe7079a534827cddd98360eb4d5b000f",
        "sha256": "ee78420f53c6bd7c880c2e1f3ec4c1db91f6893553ecab5326afa70f25bdc51a"
      }
    },
    {
      "segments": [
        {
          "text": "Wrap a clean towel around",
          "phraseIds": [
            "wrap-a-clean-towel-around"
          ]
        },
        {
          "text": " the ice to protect your skin, and I will "
        },
        {
          "text": "help",
          "wordIds": [
            "help"
          ]
        },
        {
          "text": " you."
        }
      ],
      "translation": "用乾淨毛巾包在冰塊外面以保護皮膚，我會幫你。",
      "audio": {
        "src": "/audio/sentences/ice-pack-for-sprain/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e841ce8e7f9da935bca3ba03de5826fc0531990f4a5161c4dba4396332970197",
        "sha256": "2204bf68b783a3c5dc8b3b6256fc951aa29e2aa5f6550724ef36cd2d186880b8"
      }
    }
  ]
}
