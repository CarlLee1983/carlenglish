  "sentences": [
    {
      "segments": [
        {
          "text": "Excuse me coach, may our class "
        },
        {
          "text": "borrow",
          "phraseIds": [
            "borrow-equipment"
          ],
          "wordIds": [
            "borrow"
          ]
        },
        {
          "text": " equipment",
          "phraseIds": [
            "borrow-equipment"
          ]
        },
        {
          "text": " for afternoon practice?"
        }
      ],
      "translation": "教練不好意思，我們班下午練習可以借用運動器材嗎？",
      "audio": {
        "src": "/audio/sentences/borrowing-sports-gear/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "27ea02cbf78192190a5e7d4fa454f7ef91386620d248db48db77e1e44380e7f3",
        "sha256": "e24d92bdb097698a2632b6bf46b551841ff631de10b467593c42d717c1020ad8"
      }
    },
    {
      "segments": [
        {
          "text": "Please write down your grade and "
        },
        {
          "text": "sign your name",
          "phraseIds": [
            "sign-your-name"
          ]
        },
        {
          "text": " in the "
        },
        {
          "text": "gym",
          "wordIds": [
            "gym"
          ]
        },
        {
          "text": " logbook."
        }
      ],
      "translation": "請在體育室登記簿上寫下你的班級並簽上你的名字。",
      "audio": {
        "src": "/audio/sentences/borrowing-sports-gear/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "2dc474da18dcf2d3671ad11cbe7add12cfd212d034442b8c05997f73d9789f0d",
        "sha256": "e77aecf981e0c54159acefe283a79f63e4a4c0b6976a0b7f61c1b53e44c5e706"
      }
    },
    {
      "segments": [
        {
          "text": "Are we allowed to use the outdoor "
        },
        {
          "text": "volleyball ",
          "phraseIds": [
            "volleyball-court"
          ]
        },
        {
          "text": "court",
          "phraseIds": [
            "volleyball-court"
          ],
          "wordIds": [
            "court"
          ]
        },
        {
          "text": " behind the cafeteria?"
        }
      ],
      "translation": "我們可以使用餐廳後面的戶外排球場嗎？",
      "audio": {
        "src": "/audio/sentences/borrowing-sports-gear/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9caaf468a15d17ead0c8a0fd699cfe20b66d378bc01084914f7d6b6692cdc66e",
        "sha256": "1205d0eb3f06e20a546b405eab619fc9b398ecc5995b7272076df905cb4c4c42"
      }
    },
    {
      "segments": [
        {
          "text": "Yes, but remember that another class booked the "
        },
        {
          "text": "court",
          "wordIds": [
            "court"
          ]
        },
        {
          "text": " after four."
        }
      ],
      "translation": "可以，但請記得四點之後有另一個班級預約了那個球場。",
      "audio": {
        "src": "/audio/sentences/borrowing-sports-gear/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "7694ae41aae841a70cd99f15a64f62c36c3f11c9d430bfd52fd69947dc8b1ab7",
        "sha256": "c11a70ccd99269d5aa6957e5b17e9c2965a3141d683309cef5e1587dfbb7d4a5"
      }
    },
    {
      "segments": [
        {
          "text": "We promise to return all sports balls ten minutes "
        },
        {
          "text": "before",
          "phraseIds": [
            "before-the-final-bell"
          ],
          "wordIds": [
            "before"
          ]
        },
        {
          "text": " the final ",
          "phraseIds": [
            "before-the-final-bell"
          ]
        },
        {
          "text": "bell",
          "phraseIds": [
            "before-the-final-bell"
          ],
          "wordIds": [
            "bell"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我們保證在放學最後一響鐘聲前十分鐘，把所有運動球具歸還。",
      "audio": {
        "src": "/audio/sentences/borrowing-sports-gear/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "de9bc211ae1e6ccc2169ea4d9d8aa267ac7b6a10fda299757fb771ba31333ff0",
        "sha256": "f4e9dede4747a1674aae595c6fbc545df591655d2bc78b6e748701589634c7e3"
      }
    },
    {
      "segments": [
        {
          "text": "Make sure to wipe the balls "
        },
        {
          "text": "clean",
          "wordIds": [
            "clean"
          ]
        },
        {
          "text": " and put the air pump "
        },
        {
          "text": "back on its shelf",
          "phraseIds": [
            "back-on-its-shelf"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "記得要把球擦拭乾淨，並把打氣筒放回原本的架子上。",
      "audio": {
        "src": "/audio/sentences/borrowing-sports-gear/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "bdd1b2ae33ed3e3d7d7a8d04846f1e6bef4958d99dc7b30613796df9457403de",
        "sha256": "1a60b8c7cafc7208dea52165fa3d90142eb7d0bc16737d8e9a243f6879bce9d8"
      }
    }
  ]
