  "sentences": [
    {
      "segments": [
        {
          "text": "The sharp edge of the cardboard "
        },
        {
          "text": "box",
          "wordIds": [
            "box"
          ]
        },
        {
          "text": " gave me a "
        },
        {
          "text": "minor paper ",
          "phraseIds": [
            "minor-paper-cut"
          ]
        },
        {
          "text": "cut",
          "phraseIds": [
            "minor-paper-cut"
          ],
          "wordIds": [
            "cut"
          ]
        },
        {
          "text": " on my "
        },
        {
          "text": "finger",
          "wordIds": [
            "finger"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "鋒利的紙箱邊緣劃破了我的手指，造成了一道小小的紙張割傷。",
      "audio": {
        "src": "/audio/sentences/first-aid-for-minor-cut/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "43f64cb273d6efe3efc7333c8df473c0714c7da71fc34e3d83d3df64b537cc43",
        "sha256": "029da3f0de22807a12b8f9c5fa6d1691e3d18a95370c1171824346a758b6726e"
      }
    },
    {
      "segments": [
        {
          "text": "It bleeds a little bit and hurts whenever I bend my index "
        },
        {
          "text": "finger",
          "wordIds": [
            "finger"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "只要我一彎曲食指，傷口就會流一點點血而且隱隱作痛。",
      "audio": {
        "src": "/audio/sentences/first-aid-for-minor-cut/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "b7d002d45873403d5e3b60689fda6082a404fd76f5ef7f8eeafc7f94ee07c337",
        "sha256": "80e3930da3b10dc5f791ae04e706a9cb39d95e6d141e98a4c5c6f89f03e51a3f"
      }
    },
    {
      "segments": [
        {
          "text": "First, "
        },
        {
          "text": "wash",
          "wordIds": [
            "wash"
          ]
        },
        {
          "text": " the small "
        },
        {
          "text": "cut",
          "wordIds": [
            "cut"
          ]
        },
        {
          "text": " gently under "
        },
        {
          "text": "running clean water",
          "phraseIds": [
            "running-clean-water"
          ]
        },
        {
          "text": " and soap."
        }
      ],
      "translation": "首先，用流動的乾淨自來水和肥皂輕輕清洗那道小傷口。",
      "audio": {
        "src": "/audio/sentences/first-aid-for-minor-cut/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "217722e354d065bd764e6cefc9483e7743178f0efc07f2b7f0ed66970dd119e8",
        "sha256": "f2f27881302c624eb6b4e018233f2a7bf798bb0f800be535c0d27177fac08c8e"
      }
    },
    {
      "segments": [
        {
          "text": "Open the green "
        },
        {
          "text": "first aid kit",
          "phraseIds": [
            "first-aid-kit"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "box",
          "wordIds": [
            "box"
          ]
        },
        {
          "text": " kept in the medicine cabinet."
        }
      ],
      "translation": "把放在醫藥櫃裡的綠色急救箱打開。",
      "audio": {
        "src": "/audio/sentences/first-aid-for-minor-cut/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c4c0e6cc73c293ddd6e9ba73d78cbfc8ada3985eb57156de3f724e4bd974280f",
        "sha256": "21c8f1c1ff331d7fe2133a4f406d68409581dc6de67ce1aee7b1061cc9910021"
      }
    },
    {
      "segments": [
        {
          "text": "Be "
        },
        {
          "text": "careful",
          "wordIds": [
            "careful"
          ]
        },
        {
          "text": " and wrap a breathable "
        },
        {
          "text": "adhesive ",
          "phraseIds": [
            "adhesive-bandage"
          ]
        },
        {
          "text": "bandage",
          "phraseIds": [
            "adhesive-bandage"
          ],
          "wordIds": [
            "bandage"
          ]
        },
        {
          "text": " around the wound."
        }
      ],
      "translation": "要小心，並用透氣的繃帶貼布緊緊包紮在傷口周圍。",
      "audio": {
        "src": "/audio/sentences/first-aid-for-minor-cut/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "897ff963ae6a5f00a935eeeedc00616dd659d1c8b832b12b233d0361626fc9bd",
        "sha256": "bb0fe3b751565aa17a07864ff2e482cafb7dcbc290529b2ce0fab8a914859b08"
      }
    },
    {
      "segments": [
        {
          "text": "The "
        },
        {
          "text": "bleeding stopped",
          "phraseIds": [
            "bleeding-stopped"
          ]
        },
        {
          "text": " immediately, and the "
        },
        {
          "text": "finger",
          "wordIds": [
            "finger"
          ]
        },
        {
          "text": " is well protected now."
        }
      ],
      "translation": "血立刻止住了，現在手指受到了很好的保護。",
      "audio": {
        "src": "/audio/sentences/first-aid-for-minor-cut/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "33a852080bea4bf524c7e8991e382195980d3e4c316212b7b4696bca9e8e6ec2",
