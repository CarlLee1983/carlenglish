            "here-comes-the-bus"
          ]
        },
        {
          "text": "bus",
          "phraseIds": [
            "here-comes-the-bus"
          ],
          "wordIds": [
            "bus"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "here-comes-the-bus"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "他確認了公車號碼，開心地說：「公車來了。」"
    },
    {
      "segments": [
        {
          "text": "To be sure, he asks a student next to him, “"
        },
        {
          "text": "Does this ",
          "phraseIds": [
            "does-this-bus-go-to-our-school"
          ]
        },
        {
          "text": "bus",
          "phraseIds": [
            "does-this-bus-go-to-our-school"
          ],
          "wordIds": [
            "bus"
          ]
        },
        {
          "text": " go to our ",
          "phraseIds": [
            "does-this-bus-go-to-our-school"
          ]
        },
        {
          "text": "school",
          "phraseIds": [
            "does-this-bus-go-to-our-school"
          ],
          "wordIds": [
            "school"
          ]
        },
        {
          "text": "?",
          "phraseIds": [
            "does-this-bus-go-to-our-school"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "為了確定，他問身旁的同學：「這班公車會到我們學校嗎？」"
    },
    {
      "segments": [
        {
          "text": "The student smiles and answers, “Yes, it does! "
        },
        {
          "text": "Tap your ",
          "phraseIds": [
            "tap-your-card"
          ]
        },
        {
          "text": "card",
          "phraseIds": [
            "tap-your-card"
          ],
          "wordIds": [
            "card"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "tap-your-card"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "那位同學微笑著回答：「會的！感應你的卡片吧。」"
    },
    {
      "segments": [
        {
          "text": "Ethan steps onto the "
        },
        {
          "text": "bus",
          "wordIds": [
            "bus"
          ]
        },
        {
          "text": " and taps his "
        },
        {
          "text": "card",
          "wordIds": [
            "card"
          ]
        },
        {
          "text": " against the reader."
        }
      ],
      "translation": "Ethan 踏上公車，將卡片靠在感應機上刷卡。"
    },
    {
      "segments": [
        {
          "text": "He walks down the aisle, and a friendly passenger says, “"
        },
        {
          "text": "Have a ",
          "phraseIds": [
            "have-a-seat"
          ]
        },
        {
          "text": "seat",
          "phraseIds": [
            "have-a-seat"
          ],
          "wordIds": [
            "seat"
          ]
        },
        {
          "text": ".",
          "phraseIds": [
            "have-a-seat"
          ]
        },
        {
          "text": "”"
        }
      ],
      "translation": "他走下走道，一位親切的乘客說：「請坐。」"
    },
    {
      "segments": [
        {
          "text": "Ethan sits down with a smile and enjoys the ride to "
        },
        {
          "text": "school",
          "wordIds": [
            "school"
          ]
        },
        {
          "text": "."
        }
