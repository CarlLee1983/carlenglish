  "sentences": [
    {
      "segments": [
        {
          "text": "Good morning, I need to "
        },
        {
          "text": "send",
          "phraseIds": [
            "send-an-important-document"
          ],
          "wordIds": [
            "send"
          ]
        },
        {
          "text": " an important document",
          "phraseIds": [
            "send-an-important-document"
          ]
        },
        {
          "text": " to this overseas "
        },
        {
          "text": "address",
          "wordIds": [
            "address"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "早安，我需要把一份重要文件寄到這個海外地址。",
      "audio": {
        "src": "/audio/sentences/mailing-registered-letter/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "7453e9d7b204168f2fd88a6c8c79180586eb72053243c3016d250a17d10e7ada",
        "sha256": "d488e3c22f760986501bdd819b91f6441b8d26bdf01fb4a36c05415ffd1dddde"
      }
    },
    {
      "segments": [
        {
          "text": "Please place the envelope on the electronic scale to "
        },
        {
          "text": "check the ",
          "phraseIds": [
            "check-the-weight"
          ]
        },
        {
          "text": "weight",
          "phraseIds": [
            "check-the-weight"
          ],
          "wordIds": [
            "weight"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "請把信封放在電子秤上以檢查重量。",
      "audio": {
        "src": "/audio/sentences/mailing-registered-letter/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "50b84ea3ba465b2bbb6e6e70b1aa3b7eda24eb7715857352b434523ef57eb7ae",
        "sha256": "565588232d2fd5b570a4497f578439baf4d636b81453df43bd51c142cac2ad49"
      }
    },
    {
      "segments": [
        {
          "text": "Do you want to "
        },
        {
          "text": "send",
          "wordIds": [
            "send"
          ]
        },
        {
          "text": " it by regular "
        },
        {
          "text": "air mail",
          "phraseIds": [
            "air-mail"
          ]
        },
        {
          "text": " or "
        },
        {
          "text": "express ",
          "phraseIds": [
            "express-post"
          ]
        },
        {
          "text": "post",
          "phraseIds": [
            "express-post"
          ],
          "wordIds": [
            "post"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "您希望用一般航空平信寄出，還是使用快捷快遞呢？",
      "audio": {
        "src": "/audio/sentences/mailing-registered-letter/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e48bee3cd9a20bd69312581f841dd248ad67120b544d9215c5d3f5ac6cca7f0f",
        "sha256": "53e14119deaa1424e9e70b09e3589ee87356be8953d6433c268691dc774f887b"
      }
    },
    {
      "segments": [
        {
          "text": "Express ",
          "phraseIds": [
            "express-post"
          ]
        },
        {
          "text": "post",
          "phraseIds": [
            "express-post"
          ],
          "wordIds": [
            "post"
          ]
        },
        {
          "text": " is very "
        },
        {
          "text": "fast",
          "wordIds": [
            "fast"
          ]
        },
        {
          "text": " and provides an online tracking number."
        }
      ],
      "translation": "快捷郵件速度非常快，而且會提供線上郵件追蹤號碼。",
      "audio": {
        "src": "/audio/sentences/mailing-registered-letter/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f7d2d2300becdcc5d8798aa0b1e94bcbd56456da3ac00e69ef7978adc9c17dc1",
        "sha256": "e9dca9fad3ad5c86de3fda4a17cee64b31bad86e432b728b096230fb0e2a5e2e"
      }
    },
    {
      "segments": [
        {
          "text": "How much does the express registered stamp cost for this "
        },
        {
          "text": "letter",
          "wordIds": [
            "letter"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "這封信寄快捷掛號的郵資費用是多少錢？",
      "audio": {
        "src": "/audio/sentences/mailing-registered-letter/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "9e1380c1edf632493b25326789b6b122c45ea0ab3564c79be5c26b17fe77bf22",
        "sha256": "b58cebd3ec102ff36810db0f7141fd414e0d66c233fb680cee9b09745aa7caff"
      }
    },
    {
      "segments": [
        {
          "text": "It costs eighty dollars, and it will arrive "
        },
        {
          "text": "within four business days",
          "phraseIds": [
            "within-four-business-days"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "費用是八十元，在四個工作天內就會送達。",
      "audio": {
        "src": "/audio/sentences/mailing-registered-letter/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
