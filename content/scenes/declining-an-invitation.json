  "sentences": [
    {
      "segments": [
        {
          "text": "Thank you for ",
          "phraseIds": [
            "thank-you-for-inviting-me"
          ]
        },
        {
          "text": "inviting",
          "phraseIds": [
            "thank-you-for-inviting-me"
          ],
          "wordIds": [
            "invite"
          ]
        },
        {
          "text": " me",
          "phraseIds": [
            "thank-you-for-inviting-me"
          ]
        },
        {
          "text": " to join the seaside bike trip."
        }
      ],
      "translation": "非常謝謝你邀請我參加這個週末的海邊騎車出遊。",
      "audio": {
        "src": "/audio/sentences/declining-an-invitation/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "0a4774d9abbc73902dc5e9529961e9fc2b2e597cd0150ec7582387710a6dbb0a",
        "sha256": "14257f58861cd377df4150398c31e9e83fa7a1c5956ad2bafcbeb6a4fa6edc42"
      }
    },
    {
      "segments": [
        {
          "text": "It sounds like wonderful fun, and I really "
        },
        {
          "text": "wish",
          "phraseIds": [
            "wish-i-could-come"
          ],
          "wordIds": [
            "wish"
          ]
        },
        {
          "text": " I ",
          "phraseIds": [
            "wish-i-could-come"
          ]
        },
        {
          "text": "could",
          "phraseIds": [
            "wish-i-could-come"
          ],
          "wordIds": [
            "could"
          ]
        },
        {
          "text": " come",
          "phraseIds": [
            "wish-i-could-come"
          ]
        },
        {
          "text": " along."
        }
      ],
      "translation": "聽起來非常好玩，我也真的好希望能跟你們一起去。",
      "audio": {
        "src": "/audio/sentences/declining-an-invitation/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c6e1994f42b19c76bd5b7096be534e53d16bce89dab954439eabadd40669e898",
        "sha256": "16aa889ac4ebb2b1cafe9d5445ab0e77a8ac6a450d09ffbcc7a57d77077c5a75"
      }
    },
    {
      "segments": [
        {
          "text": "However, I "
        },
        {
          "text": "already",
          "wordIds": [
            "already"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "made a promise",
          "phraseIds": [
            "made-a-promise"
          ]
        },
        {
          "text": " to visit my grandparents this Sunday."
        }
      ],
      "translation": "然而，我這個星期天已經先答應要去鄉下探望我的祖父母了。",
      "audio": {
        "src": "/audio/sentences/declining-an-invitation/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "907c7beb85c3679ddbed0eb3c72b2d51ca6659777a016d8bfe2a0e700c0b7294",
        "sha256": "744a64364b000dc089d322107bca6e786c62e9dae8d62f4660e8eb046b108318"
      }
    },
    {
      "segments": [
        {
          "text": "My whole "
        },
        {
          "text": "family",
          "wordIds": [
            "family"
          ]
        },
        {
          "text": " is gathering together for grandpa's birthday dinner."
        }
      ],
      "translation": "我們全家人都要聚在一起慶祝我爺爺的生日晚宴。",
      "audio": {
        "src": "/audio/sentences/declining-an-invitation/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "90a4e38a5204d0e8ea4ab4f7580d50deaad439b793e9aca8a0ff957291f99dc7",
        "sha256": "2f7108a15ff0107229443935791e4a46c2cb44b2e25554aade3d59f6fb56bbed"
      }
    },
    {
      "segments": [
        {
          "text": "That is completely fine, "
        },
        {
          "text": "family",
          "wordIds": [
            "family"
          ]
        },
        {
          "text": " celebrations should always "
        },
        {
          "text": "come first",
          "phraseIds": [
            "come-first"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "完全沒問題的，家人的重要慶祝本來就應該放在第一位。",
      "audio": {
        "src": "/audio/sentences/declining-an-invitation/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "8639b0ff186f3d579bc0c4dde60cfb42d7d2186a250326977cf9e2240852562e",
        "sha256": "a218829e426513e039df5d3bdf511154002ec16ae9575deba8421ddff062d819"
      }
    },
    {
      "segments": [
        {
          "text": "Let us definitely plan another exciting trip together "
        },
        {
          "text": "next",
          "phraseIds": [
            "next-time"
          ],
          "wordIds": [
            "next"
          ]
        },
        {
          "text": " time",
          "phraseIds": [
            "next-time"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "我們下一次一定要再一起規劃一趟令人興奮的出遊！",
      "audio": {
        "src": "/audio/sentences/declining-an-invitation/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "d5595b71751b2e9e810230f692b7ca9b2b127307e0d041d23688b51d6b4e8f3f",
        "sha256": "b666c905479e386b6fd7d06ec47e86bb8af4fa2d925b48f70495518d2494df47"
      }
    }
  ]
