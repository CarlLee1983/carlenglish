  "sentences": [
    {
      "segments": [
        {
          "text": "Good morning, I am "
        },
        {
          "text": "in a ",
          "phraseIds": [
            "in-a-hurry"
          ]
        },
        {
          "text": "hurry",
          "phraseIds": [
            "in-a-hurry"
          ],
          "wordIds": [
            "hurry"
          ]
        },
        {
          "text": " to catch my train."
        }
      ],
      "translation": "早安司機先生，我有點趕時間要去搭火車。",
      "audio": {
        "src": "/audio/sentences/taking-a-taxi/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "6e81bc6f35beaa5208cb6930c2a663d0125a6974ef7aad586cd4f657197bf48a",
        "sha256": "a8f88f758809830d7b805f44778f2cf9d065d034cb49ef73a49833c42c86ed0e"
      }
    },
    {
      "segments": [
        {
          "text": "Could you please take me to the high-speed rail station?"
        }
      ],
      "translation": "可以請您載我到高鐵車站嗎？",
      "audio": {
        "src": "/audio/sentences/taking-a-taxi/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "3edbc6dc3fba33a39bd7a7c43de2a947336c48f42b4d53f3b9b6ec2eca830066",
        "sha256": "ae87da67572f8e496c574df958615113bc965ca274f3a61a66c47bc168e0dc0d"
      }
    },
    {
      "segments": [
        {
          "text": "The main avenue "
        },
        {
          "text": "ahead",
          "wordIds": [
            "ahead"
          ]
        },
        {
          "text": " has "
        },
        {
          "text": "heavy ",
          "phraseIds": [
            "heavy-traffic"
          ]
        },
        {
          "text": "traffic",
          "phraseIds": [
            "heavy-traffic"
          ],
          "wordIds": [
            "traffic"
          ]
        },
        {
          "text": " today."
        }
      ],
      "translation": "前面那條主要大道今天早上的車流量非常大。",
      "audio": {
        "src": "/audio/sentences/taking-a-taxi/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "874fefe4a00fc25cb33d941737ed46fd4439f166038c2ec00ded711aed4632f4",
        "sha256": "6cb421185849fff284517406c84e1efe4a7ee5a867a19758f7cc07152a118245"
      }
    },
    {
      "segments": [
        {
          "text": "Can you turn right into the smaller "
        },
        {
          "text": "road",
          "wordIds": [
            "road"
          ]
        },
        {
          "text": " to "
        },
        {
          "text": "save time",
          "phraseIds": [
            "save-time"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "您可以右轉走那條小路來節省時間嗎？",
      "audio": {
        "src": "/audio/sentences/taking-a-taxi/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "415da777f3912dc879e7ae8ebf914df887362f21f77feac30d3f953174368ce9",
        "sha256": "3597b9e873dbf57cb9e3d3a1f98924d844a04c809118853e6423b1d1605d726c"
      }
    },
    {
      "segments": [
        {
          "text": "Do not worry, I will "
        },
        {
          "text": "drive",
          "wordIds": [
            "drive"
          ]
        },
        {
          "text": " carefully and take "
        },
        {
          "text": "the fastest route",
          "phraseIds": [
            "the-fastest-route"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "別擔心，我會安全駕駛並走最快的路線。",
      "audio": {
        "src": "/audio/sentences/taking-a-taxi/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "7cd2ef12416e932efd9afacab054a6406f0b365e921383f75064649d5abbe42b",
        "sha256": "81f3d06a71b0b8f6c3411c186934409d7785f5cfc5609ab24133c5d0216324cf"
      }
    },
    {
      "segments": [
        {
          "text": "Please "
        },
        {
          "text": "drop",
          "phraseIds": [
            "drop-me-off"
          ],
          "wordIds": [
            "drop"
          ]
        },
        {
          "text": " me off",
          "phraseIds": [
            "drop-me-off"
          ]
        },
        {
          "text": " right at the main entrance "
        },
        {
          "text": "drop",
          "wordIds": [
            "drop"
          ]
        },
        {
          "text": " point."
        }
      ],
      "translation": "請在正大門的下車處讓我下車就好。",
      "audio": {
        "src": "/audio/sentences/taking-a-taxi/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "965049093b8e52d8dd611bf286092d1c2ecd54e16e0762684a25a08caabf5d64",
