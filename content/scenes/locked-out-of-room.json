  "sentences": [
    {
      "segments": [
        {
          "text": "Excuse me security guard, the wind just "
        },
        {
          "text": "slammed my apartment ",
          "phraseIds": [
            "slammed-my-apartment-door-shut"
          ]
        },
        {
          "text": "door",
          "phraseIds": [
            "slammed-my-apartment-door-shut"
          ],
          "wordIds": [
            "door"
          ]
        },
        {
          "text": " shut",
          "phraseIds": [
            "slammed-my-apartment-door-shut"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "管理員不好意思，剛才一陣風把我的公寓大門碰一聲關上了。",
      "audio": {
        "src": "/audio/sentences/locked-out-of-room/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "3ecff371e7f8e9e8f2d94b529bc1336881330771b3e72d4a621858e0c3778702",
        "sha256": "a7518311e8119f5c81ace0de69f1c76cad5d5c368f1c48f5a34bd56380b2449e"
      }
    },
    {
      "segments": [
        {
          "text": "I stepped "
        },
        {
          "text": "outside",
          "wordIds": [
            "outside"
          ]
        },
        {
          "text": " to throw away the trash and "
        },
        {
          "text": "forgot",
          "phraseIds": [
            "forgot-my-keys-inside"
          ],
          "wordIds": [
            "forget"
          ]
        },
        {
          "text": " my ",
          "phraseIds": [
            "forgot-my-keys-inside"
          ]
        },
        {
          "text": "keys",
          "phraseIds": [
            "forgot-my-keys-inside"
          ],
          "wordIds": [
            "key"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "inside",
          "phraseIds": [
            "forgot-my-keys-inside"
          ],
          "wordIds": [
            "inside"
          ]
        },
        {
          "text": " on the table."
        }
      ],
      "translation": "我走出門倒垃圾，結果把鑰匙忘在屋內的桌上了。",
      "audio": {
        "src": "/audio/sentences/locked-out-of-room/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "5279fa90c9e104fe1083da5e0a19e9929036986c2cf692ef34ffea0e71151182",
        "sha256": "98f630273b92117128ee9d0b6cdc73e87573907334249e27f737848e4b9cbc0f"
      }
    },
    {
      "segments": [
        {
          "text": "Do not worry young man, could you "
        },
        {
          "text": "borrow our security office phone",
          "phraseIds": [
            "borrow-our-security-office-phone"
          ]
        },
        {
          "text": " to call your family?"
        }
      ],
      "translation": "別擔心年輕人，你要不要借用我們警衛室的電話打給你家人？",
      "audio": {
        "src": "/audio/sentences/locked-out-of-room/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e933091032a1b5c53da744076c7726c12803e2e7f93f2214d6a4d1282bc3322b",
        "sha256": "e4d5095f1495da3d901f700b5182b2054be8874e721f6d3970b8933bca494a18"
      }
    },
    {
      "segments": [
        {
          "text": "My father is at work, but my sister carries a "
        },
        {
          "text": "spare key",
          "phraseIds": [
            "spare-key"
          ]
        },
        {
          "text": " in her bag."
        }
      ],
      "translation": "我爸爸在上班，但我姊姊包包裡面隨身帶著一把備用鑰匙。",
      "audio": {
        "src": "/audio/sentences/locked-out-of-room/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ed30aa8d3c2bb7c90fef2d412a5848e671a91686aa4653d502eacaf95088e58c",
        "sha256": "6e57c736638a231c870707d50d65700f3025d07ad25080a0e5fe760812d3a2c5"
      }
    },
    {
      "segments": [
        {
          "text": "She said she will take the subway home and be here within twenty minutes."
        }
      ],
      "translation": "她說她會馬上坐捷運回家，二十分鐘之內就會趕到這裡。",
      "audio": {
        "src": "/audio/sentences/locked-out-of-room/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "4bdbe51f208195376704cf010334b4a51ef8977bf0d5a2f23589029ebd8ec311",
        "sha256": "e6cae82b726464392e7a84f6c05b971c895dcc08c9da0c90dd490ccc70a00a61"
      }
    },
    {
      "segments": [
        {
          "text": "You can sit "
        },
        {
          "text": "inside",
          "wordIds": [
            "inside"
          ]
        },
        {
          "text": " our warm office lobby while you "
        },
        {
          "text": "wait for the ",
          "phraseIds": [
            "wait-for-the-door-to-open"
          ]
        },
        {
          "text": "door",
          "phraseIds": [
            "wait-for-the-door-to-open"
          ],
          "wordIds": [
            "door"
          ]
        },
        {
          "text": " to ",
          "phraseIds": [
            "wait-for-the-door-to-open"
          ]
        },
        {
          "text": "open",
          "phraseIds": [
            "wait-for-the-door-to-open"
          ],
          "wordIds": [
            "open"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "在等門打開的這段時間，你可以先坐在我們溫暖的大廳沙發上等。",
      "audio": {
        "src": "/audio/sentences/locked-out-of-room/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "cbd1e86aa5285b7ab09da5411744ed3413e9442aafe3050730848e8b096e6b79",
        "sha256": "de9f7211875f4e0ac29b7c3fb244a71455c94fabef5cd7b44c10b5f79e94f389"
      }
    }
