  "sentences": [
    {
      "segments": [
        {
          "text": "Excuse me, bus number 302 was "
        },
        {
          "text": "scheduled",
          "phraseIds": [
            "scheduled-to-arrive"
          ],
          "wordIds": [
            "schedule"
          ]
        },
        {
          "text": " to ",
          "phraseIds": [
            "scheduled-to-arrive"
          ]
        },
        {
          "text": "arrive",
          "phraseIds": [
            "scheduled-to-arrive"
          ],
          "wordIds": [
            "arrive"
          ]
        },
        {
          "text": " at nine."
        }
      ],
      "translation": "不好意思，302 路公車表定應該在九點抵達。",
      "audio": {
        "src": "/audio/sentences/bus-delay-inquiry/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "bbe386ed37d355fa4f7e852d6d70e379d84de1a15a76135553ee9b07230a607f",
        "sha256": "22ded7f426fecf40280184e4d76a00c395c3f707e2434f866d3aa64b386f74b6"
      }
    },
    {
      "segments": [
        {
          "text": "It is already "
        },
        {
          "text": "twenty minutes late",
          "phraseIds": [
            "twenty-minutes-late"
          ]
        },
        {
          "text": ", do you know "
        },
        {
          "text": "what ",
          "phraseIds": [
            "what-happened"
          ]
        },
        {
          "text": "happened",
          "phraseIds": [
            "what-happened"
          ],
          "wordIds": [
            "happen"
          ]
        },
        {
          "text": " on the road?"
        }
      ],
      "translation": "現在已經晚了二十分鐘，路上是有發生什麼事嗎？",
      "audio": {
        "src": "/audio/sentences/bus-delay-inquiry/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "954fdf37bcd64cb00e45afbc2c0c67edf4e552e1fe5aa22ddc40b758487319d8",
        "sha256": "13ed75c6685d3bb754cd6e0b40a8b3d06839ee43401d880dd7984daa821c7da4"
      }
    },
    {
      "segments": [
        {
          "text": "There was a small car accident that "
        },
        {
          "text": "caused",
          "phraseIds": [
            "caused-a-long-delay"
          ],
          "wordIds": [
            "cause"
          ]
        },
        {
          "text": " a long ",
          "phraseIds": [
            "caused-a-long-delay"
          ]
        },
        {
          "text": "delay",
          "phraseIds": [
            "caused-a-long-delay"
          ],
          "wordIds": [
            "delay"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "前面路上發生了一起小車禍，導致了嚴重的誤點延遲。",
      "audio": {
        "src": "/audio/sentences/bus-delay-inquiry/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c52f297a3fbf9064e656a95c7f62157c37d41e4f9b15e0ee059de38c1ebbb5b3",
        "sha256": "55a852512757576c148b0366f81bb0c543245412b45f248c561ee68b8f51ba4d"
      }
    },
    {
      "segments": [
        {
          "text": "Is the bus still coming, or will we miss our transfer?"
        }
      ],
      "translation": "公車還會來嗎？還是我們會錯過後面的轉乘班次？",
      "audio": {
        "src": "/audio/sentences/bus-delay-inquiry/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "328497f0b3202312b6b760240894b587e90e94853e90e0a78310b725850472b0",
        "sha256": "7a48b4fdc1de0ad2f7ba3b0ef09914758e32c95db0239fe07b74818ac452607b"
      }
    },
    {
      "segments": [
        {
          "text": "The GPS system shows it will "
        },
        {
          "text": "probably",
          "phraseIds": [
            "probably-arrive-in"
          ],
          "wordIds": [
            "probably"
          ]
        },
        {
          "text": " "
        },
        {
          "text": "arrive",
          "phraseIds": [
            "probably-arrive-in"
          ],
          "wordIds": [
            "arrive"
          ]
        },
        {
          "text": " in",
          "phraseIds": [
            "probably-arrive-in"
          ]
        },
        {
          "text": " six minutes."
        }
      ],
      "translation": "公車動態定位系統顯示，它大概六分鐘後就會抵達。",
      "audio": {
        "src": "/audio/sentences/bus-delay-inquiry/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "c1e2ac0f79313810c30d84e950d9ea58d3c3307ff431a553551bf61521620b38",
        "sha256": "748193b605c3626f96ca7b3d90f378f22119b5c5a983b8d24c97b19ee875c7fa"
      }
    },
    {
      "segments": [
        {
          "text": "It seems the "
        },
        {
          "text": "delay",
          "wordIds": [
            "delay"
          ]
        },
        {
          "text": " will not be much longer, thank you."
        }
      ],
      "translation": "看起來不會再耽擱太久了，非常感謝您。",
      "audio": {
        "src": "/audio/sentences/bus-delay-inquiry/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "a5500265ac9971e4d5d0cf064d78933eea57f1842fef03558661b777f6e23896",
        "sha256": "acebc82e18c9145d331c1a8b32a879726c80fa87c01ed46a7ed7d9c8dfc201e2"
      }
    }
  ]
