  "sentences": [
    {
      "segments": [
        {
          "text": "Hello, I think I "
        },
        {
          "text": "left",
          "phraseIds": [
            "left-my-bag-inside"
          ],
          "wordIds": [
            "leave"
          ]
        },
        {
          "text": " my bag ",
          "phraseIds": [
            "left-my-bag-inside"
          ]
        },
        {
          "text": "inside",
          "phraseIds": [
            "left-my-bag-inside"
          ],
          "wordIds": [
            "inside"
          ]
        },
        {
          "text": " the concert hall."
        }
      ],
      "translation": "你好，我想我剛才把隨身包忘在音樂廳裡面了。",
      "audio": {
        "src": "/audio/sentences/lost-bag-inquiry/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e4e7ae40711a5a2dcbfb0971a5e9b5747547b11459090c71b45740ee9189f28d",
        "sha256": "fef5c361883bf2a1e1998e8ead1cef0393cbc3249c9fcfea5cbfffea5020a0ce"
      }
    },
    {
      "segments": [
        {
          "text": "Can you "
        },
        {
          "text": "remember",
          "wordIds": [
            "remember"
          ]
        },
        {
          "text": " the color and what material it was made of?"
        }
      ],
      "translation": "你能記得包包的顏色以及它是什麼材質做的嗎？",
      "audio": {
        "src": "/audio/sentences/lost-bag-inquiry/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "194f26feae55cbc3fa53e929b55a4eae6347994d60bc5cd201cc7e861afeb430",
        "sha256": "2c5af5a0ebd15a67a22c657ccf4ec56804fe11f0c0175e0b07b94692087fc44d"
      }
    },
    {
      "segments": [
        {
          "text": "It is a small "
        },
        {
          "text": "black",
          "phraseIds": [
            "black-leather-bag"
          ],
          "wordIds": [
            "black"
          ]
        },
        {
          "text": " leather bag",
          "phraseIds": [
            "black-leather-bag"
          ]
        },
        {
          "text": " with a metal zipper."
        }
      ],
      "translation": "它是一個黑色的小皮包，上面附有金屬拉鍊。",
      "audio": {
        "src": "/audio/sentences/lost-bag-inquiry/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e1a8dc539d2b9c9e387f2efee5ad8a5e58a52f18674c6fc515abf80daafc2288",
        "sha256": "7a8617cc2623140ba69921ea4d53b95257c1531f8a4f3fb5c8cb295e6f68bcad"
      }
    },
    {
      "segments": [
        {
          "text": "Can you tell me "
        },
        {
          "text": "what was ",
          "phraseIds": [
            "what-was-inside"
          ]
        },
        {
          "text": "inside",
          "phraseIds": [
            "what-was-inside"
          ],
          "wordIds": [
            "inside"
          ]
        },
        {
          "text": " the main pocket?"
        }
      ],
      "translation": "你能告訴我主要口袋裡面裝了什麼嗎？",
      "audio": {
        "src": "/audio/sentences/lost-bag-inquiry/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "927afeb2cb8204f50e7f1281f2129eb170661ef3e6dcde33e7a3879ab22034dd",
        "sha256": "8f81f84b6b3ad67f8a7a548712bd4c0fafaa2c6f4c6e9c9600d6281e0403d5e5"
      }
    },
    {
      "segments": [
        {
          "text": "There are "
        },
        {
          "text": "house ",
          "phraseIds": [
            "house-keys"
          ]
        },
        {
          "text": "keys",
          "phraseIds": [
            "house-keys"
          ],
          "wordIds": [
            "key"
          ]
        },
        {
          "text": ", an umbrella, and a blue student notebook."
        }
      ],
      "translation": "裡面有一串家裡的鑰匙、一把雨傘和一本藍色學生筆記本。",
      "audio": {
        "src": "/audio/sentences/lost-bag-inquiry/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "6ec2f0ed10392ffb09bde4e96a7db4af4dcb731834168c1a9c2d8c68b4ade7d6",
        "sha256": "499ed6ff923761b9fee145bd6a7692ee14e5f67c03c3d14f329045be58d2112a"
      }
    },
    {
      "segments": [
        {
          "text": "A cleaner just found that exact bag, please "
        },
        {
          "text": "sign the ",
          "phraseIds": [
            "sign-the-contact-form"
          ]
        },
        {
          "text": "contact",
          "phraseIds": [
            "sign-the-contact-form"
          ],
          "wordIds": [
            "contact"
          ]
        },
        {
          "text": " form",
          "phraseIds": [
            "sign-the-contact-form"
          ]
        },
        {
          "text": " to claim it."
        }
      ],
      "translation": "一位清潔人員剛好撿到了完全相符的包包，請在聯絡單上簽名認領。",
      "audio": {
        "src": "/audio/sentences/lost-bag-inquiry/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "2c0eb682a8592d8b8406996ce835c68807131dd9f961c11ace8fc9c4b2af2362",
        "sha256": "0157f8721f2d6952fb0ae1b8529f6ebe4493d3f6b7d522546cfd47c32c819998"
      }
    }
  ]
