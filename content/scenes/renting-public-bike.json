  "sentences": [
    {
      "segments": [
        {
          "text": "I want to "
        },
        {
          "text": "rent",
          "phraseIds": [
            "rent-a-bike"
          ],
          "wordIds": [
            "rent"
          ]
        },
        {
          "text": " a bike",
          "phraseIds": [
            "rent-a-bike"
          ]
        },
        {
          "text": " to "
        },
        {
          "text": "ride",
          "wordIds": [
            "ride"
          ]
        },
        {
          "text": " around the lake."
        }
      ],
      "translation": "我想租借一輛腳踏車在湖邊騎一騎。",
      "audio": {
        "src": "/audio/sentences/renting-public-bike/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "d40d0340f5b39defc7987863bd8beece258ce7d86b870dbb0ac98998e9cf0bd2",
        "sha256": "de9bb7022d9faab5c4da187577ed756ba9ee55d746919cc8f1ed80c6ba6439b0"
      }
    },
    {
      "segments": [
        {
          "text": "Tap your card",
          "phraseIds": [
            "tap-your-card"
          ]
        },
        {
          "text": " on the sensor right beside the bike."
        }
      ],
      "translation": "請把你的交通卡感應在自行車旁的感應器上。",
      "audio": {
        "src": "/audio/sentences/renting-public-bike/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "bfabed9558da6da42ee867564eafe615a2d1cb82c58c588ed784025192a15963",
        "sha256": "4bb2a35fbb4f070cea0227120fee472f3f9dce219f6958e409358eb937987c8c"
      }
    },
    {
      "segments": [
        {
          "text": "When the green light turns on, pull the "
        },
        {
          "text": "lock",
          "wordIds": [
            "lock"
          ]
        },
        {
          "text": " firmly."
        }
      ],
      "translation": "當綠燈亮起時，請把車鎖穩穩地往後拉出。",
      "audio": {
        "src": "/audio/sentences/renting-public-bike/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "be6fcdc87c10ea0df27048b47c3db856a0b0b6e505375acfe4e1a0dcc99a133f",
        "sha256": "4759e6a55d8f68c6c38f2ebe07b474aefa0d335d45181bfe35477b63624484bc"
      }
    },
    {
      "segments": [
        {
          "text": "Remember to "
        },
        {
          "text": "check the tires",
          "phraseIds": [
            "check-the-tires"
          ]
        },
        {
          "text": " before you start your "
        },
        {
          "text": "ride",
          "wordIds": [
            "ride"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "開始騎乘前，記得先檢查兩邊的輪胎。",
      "audio": {
        "src": "/audio/sentences/renting-public-bike/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "f9d5b50180ee6fdaff125890ae2c31c06bce1b27a7335309bfe498da3015b59c",
        "sha256": "b90ba965594ac7a2171571305a20de8f3a2a48cfd4713c36a0509a88bd051d6e"
      }
    },
    {
      "segments": [
        {
          "text": "You can "
        },
        {
          "text": "adjust",
          "phraseIds": [
            "adjust-the-seat"
          ],
          "wordIds": [
            "adjust"
          ]
        },
        {
          "text": " the seat",
          "phraseIds": [
            "adjust-the-seat"
          ]
        },
        {
          "text": " height by "
        },
        {
          "text": "pressing",
          "wordIds": [
            "press"
          ]
        },
        {
          "text": " the metal lever."
        }
      ],
      "translation": "你可以按下金屬扳手來調整坐墊的高度。",
      "audio": {
        "src": "/audio/sentences/renting-public-bike/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
