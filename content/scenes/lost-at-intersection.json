  "sentences": [
    {
      "segments": [
        {
          "text": "Excuse",
          "wordIds": [
            "excuse"
          ]
        },
        {
          "text": " me sir, I think I am "
        },
        {
          "text": "completely ",
          "phraseIds": [
            "completely-lost"
          ]
        },
        {
          "text": "lost",
          "phraseIds": [
            "completely-lost"
          ],
          "wordIds": [
            "lost"
          ]
        },
        {
          "text": " at this crossroads."
        }
      ],
      "translation": "不好意思先生，我想我在這個十字路口完全迷路了。",
      "audio": {
        "src": "/audio/sentences/lost-at-intersection/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "0d04796be88e4b14481a8ba6295c1bd8d6956978ad871198136d6663b7d12ce7",
        "sha256": "12bf1838f489a3417e0bcbaa48617333dfb0dd32f1609dbfd7a8d4d3a4c99a2b"
      }
    },
    {
      "segments": [
        {
          "text": "Can you tell me "
        },
        {
          "text": "how to get to",
          "phraseIds": [
            "how-to-get-to"
          ]
        },
        {
          "text": " the modern art museum?"
        }
      ],
      "translation": "您可以告訴我怎麼去當代美術館嗎？",
      "audio": {
        "src": "/audio/sentences/lost-at-intersection/2.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "e9714022319287fe79a8042381920631aa1702f8cabc33554de75ece7ed4581a",
        "sha256": "7a64a7cf47cd067bfe8b5576824f3082a1ab9b88e9ff72c57ca7ad6459f5f287"
      }
    },
    {
      "segments": [
        {
          "text": "Do not worry, it is not too "
        },
        {
          "text": "far",
          "wordIds": [
            "far"
          ]
        },
        {
          "text": ", only "
        },
        {
          "text": "half a mile away",
          "phraseIds": [
            "half-a-mile-away"
          ]
        },
        {
          "text": " from here."
        }
      ],
      "translation": "別擔心，離這裡不會太遠，只有大概半英里遠而已。",
      "audio": {
        "src": "/audio/sentences/lost-at-intersection/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "846385fe287c2be57df78c4bec8d9c53af61c935d52465db709400204f3f3694",
        "sha256": "ebe117cc2a27eb3c6a6c881fd051f104c8fb589562954a994c8a70c93f037550"
      }
    },
    {
      "segments": [
        {
          "text": "Walk straight along",
          "phraseIds": [
            "walk-straight-along"
          ]
        },
        {
          "text": " this avenue and walk "
        },
        {
          "text": "past",
          "wordIds": [
            "past"
          ]
        },
        {
          "text": " the tall white "
        },
        {
          "text": "building",
          "wordIds": [
            "building"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "沿著這條大道一直往前走，經過那棟白色高樓。",
      "audio": {
        "src": "/audio/sentences/lost-at-intersection/4.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "bd84a2e07029bb39d9c212ba3b7be10a25ecb25fd34b8f06fdb3691660fcc9c1",
        "sha256": "dccbb098022e5107e75b8bb41391c09f21dbf08f4e8a25fb7a5fa8521ca0d2fe"
      }
    },
    {
      "segments": [
        {
          "text": "Cross",
          "phraseIds": [
            "cross-the-street"
          ],
          "wordIds": [
            "cross"
          ]
        },
        {
          "text": " the street",
          "phraseIds": [
            "cross-the-street"
          ]
        },
        {
          "text": " at the pedestrian light and turn right at the corner."
        }
      ],
      "translation": "在行人號誌燈處過馬路，然後在轉角處右轉。",
      "audio": {
        "src": "/audio/sentences/lost-at-intersection/5.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "ed6266b4d78cc2799d4e008ada22423b203e9f45e06bc084e304a0fe6d707ade",
        "sha256": "12e15295cb7461056bdfc9006f7fe1508f2e653d4bc819a994b89c57ea1a206d"
      }
    },
    {
      "segments": [
        {
          "text": "You will see the museum entrance right on your left hand side."
        }
      ],
      "translation": "你就會在左手邊看到美術館的正門入口了。",
      "audio": {
        "src": "/audio/sentences/lost-at-intersection/6.mp3",
        "voiceId": "kokoro-af-heart-v1",
        "textSha256": "249586865f27e518f2f88f25cda89fe91812ef5f4d87b4314e13e9fc5417c879",
        "sha256": "c45d48fe8e816292228cdc7fc2c5b33e3d0fad8b2434b29d6680329bad9431a9"
      }
    }
  ]
