        {
          "text": " for the afternoon animated "
        },
        {
          "text": "movie",
          "wordIds": [
            "movie"
          ]
        },
        {
          "text": "."
        }
      ],
      "translation": "午安，我們想買下午場動畫電影的學生票。",
      "audio": {
        "src": "/audio/sentences/cinema-ticket-booking/1.mp3",
        "voiceId": "kokoro-af-heart-v1",
