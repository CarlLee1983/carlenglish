          "phraseIds": [
            "in-the-middle-row"
          ]
        },
        {
          "text": "?"
        }
      ],
      "translation": "四點半的場次符合我們的時間，請問中間排數還有好座位嗎？",
      "audio": {
        "src": "/audio/sentences/cinema-ticket-booking/3.mp3",
        "voiceId": "kokoro-af-heart-v1",
