---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { loadArticles, originLabels, trackLabels, type Track } from '../lib/articles';
import { loadScenes } from '../lib/scenes';
import { createCatalog } from '../lib/catalog';
import { canonicalUrl, siteDescription } from '../lib/seo';
const scenes = loadScenes();
const previewScene = scenes.find((scene) => scene.id === 'cafe-breakfast') ?? scenes[0];
// Content accepts case-insensitive image extensions, including mixed case.
const previewImages = import.meta.glob<{ default: ImageMetadata }>('../../public/images/scenes/**/*.{[wW][eE][bB][pP],[pP][nN][gG],[jJ][pP][gG],[jJ][pP][eE][gG]}');
const previewImage = previewScene ? (await previewImages[`../../public${previewScene.image.src}`]()).default : undefined;
const previewRatio = previewImage ? previewImage.width / previewImage.height : 1;
const catalog = createCatalog(scenes);
const homeUrl = canonicalUrl('/', Astro.site);
const structuredData = [
  { '@type': 'WebSite', '@id': `${homeUrl}#website`, name: 'CarlEnglish', url: homeUrl, description: siteDescription, inLanguage: ['zh-Hant', 'en'] },
  { '@type': 'WebPage', '@id': `${homeUrl}#webpage`, name: '生活讀本與新聞貼文閱讀', url: homeUrl, description: siteDescription, inLanguage: 'zh-Hant', isPartOf: { '@id': `${homeUrl}#website` } },
];
const articles = loadArticles();
const tracks: Track[] = ['news', 'posts'];
const articleGroups = tracks.map((track) => ({
  track,
  items: articles.filter((article) => article.track === track)
    .sort((a, b) => a.stage.localeCompare(b.stage) || a.id.localeCompare(b.id)),
})).filter((group) => group.items.length > 0);
---
<Layout title="生活英文閱讀：初中高級讀本與新聞貼文" structuredData={structuredData}>
  <div class="page-shell home-page">
    <section class="home-intro" aria-labelledby="intro-title">
      <div>
        <p class="eyebrow">生活裡的英文，一篇一篇讀。</p>
        <h1 id="intro-title">今天，從哪個<br />程度開始？</h1>
        <p class="intro-description">選擇適合你的讀本。看圖、讀短文，<br class="desktop-break" />再聽聽日常會用到的單字與短句。</p>
      </div>
      {previewScene && previewImage && <Image class="home-preview" src={previewImage} alt={previewScene.image.alt} width={360} widths={[240, 360, 480, 720]} sizes={`(max-width: 767px) ${160 * previewRatio}px, (max-width: 1000px) 36vw, ${Math.min(360, 240 * previewRatio)}px`} style={`--preview-width: ${240 * previewRatio}px; --preview-mobile-width: ${160 * previewRatio}px;`} format="webp" loading="eager" fetchpriority="high" />}
    </section>
    <section class="level-selection" aria-labelledby="levels-title">
      <div class="collection-heading"><h2 id="levels-title">選擇你的學習程度</h2><p>{scenes.length} 篇生活讀本</p></div>
      <ol class="level-list">
        {catalog.map(({ level, scenes }, index) => (
          <li>
            <a class="level-entry" href={`/levels/${level.id}/`} aria-label={`進入${level.name}`}>
              <span class="level-number" aria-hidden="true">0{index + 1}</span>
              <div class="level-entry-title"><h3>{level.name}</h3><p lang="en">{level.english}</p></div>
              <p class="level-entry-description">{level.focus}</p>
              <span class="level-entry-count">{scenes.length ? `${scenes.length} 篇讀本` : '教材準備中'}</span>
              <span class="entry-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
    <p class="level-help">剛開始讀英文？先從初級試讀，再依閱讀感受調整，隨時可以切換程度。</p>
    <section class="articles-section" id="articles" aria-labelledby="articles-title">
      <div class="collection-heading">
        <h2 id="articles-title">新聞與貼文</h2>
        <p>{articles.length} 篇文章</p>
      </div>
      {articleGroups.map((group) => (
        <div class="article-group">
          <h3>{trackLabels[group.track]}</h3>
          <ul class="article-list">
            {group.items.map((article) => (
              <li>
                <a class="article-card" href={`/articles/${article.id}/`}>
                  <p class="scene-meta">{article.stage}<span>{originLabels[article.origin]}</span></p>
                  <h4 lang="en">{article.titleEn}</h4>
                  <p class="article-card-title">{article.title}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
</Layout>
