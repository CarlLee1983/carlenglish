---
import Layout from '../layouts/Layout.astro';
import { loadArticles, originLabels, trackLabels, type Track } from '../lib/articles';
import { loadScenes } from '../lib/scenes';
const scenes = loadScenes();
const articles = loadArticles();
const tracks: Track[] = ['news', 'posts'];
const articleGroups = tracks.map((track) => ({
  track,
  items: articles.filter((article) => article.track === track)
    .sort((a, b) => a.stage.localeCompare(b.stage) || a.id.localeCompare(b.id)),
})).filter((group) => group.items.length > 0);
---
<Layout title="生活場景">
  <div class="page-shell">
    <section class="list-intro" aria-labelledby="intro-title">
      <h1 id="intro-title">從生活場景，<br />開始讀英文。</h1>
      <p>先看圖，再讀一篇短文。<br />把日常會用到的英文，一點一點記起來。</p>
    </section>
    <section aria-labelledby="scenes-title">
      <div class="collection-heading">
        <h2 id="scenes-title">選一個場景</h2>
        <span>{scenes.length} 篇讀本</span>
      </div>
      <ul class="scene-list">
        {scenes.map((scene) => (
          <li>
            <a class="scene-card" href={`/scenes/${scene.id}/`} aria-label={`閱讀${scene.title}`}>
              <img src={scene.image.src} alt={scene.image.alt} width={scene.image.width} height={scene.image.height} fetchpriority="high" />
              <div class="scene-card-copy">
                <p class="scene-meta">{scene.category}<span>{scene.level}</span></p>
                <h3 lang="en">{scene.titleEn}</h3>
                <p class="scene-card-title">{scene.title}</p>
                <p class="scene-counts">{scene.sentences.length} 句短文 / {scene.phrases.length} 個短句 / {scene.words.length} 個單字</p>
                <span class="read-label">開始閱讀 <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section class="articles-section" id="articles" aria-labelledby="articles-title">
      <div class="collection-heading">
        <h2 id="articles-title">新聞與貼文</h2>
        <span>{articles.length} 篇文章</span>
      </div>
      {articleGroups.map((group) => (
        <div class="article-group">
          <h3>{trackLabels[group.track]}</h3>
          <ul class="article-list">
            {group.items.map((article) => (
              <li>
                <a class="article-card" href={`/articles/${article.id}/`}>
                  <p class="scene-meta">{article.stage}<span>{originLabels[article.origin]}</span></p>
                  <h4 lang="en">{article.titleEn}</h4>
                  <p class="article-card-title">{article.title}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
</Layout>
