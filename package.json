{
  "name": "carlenglish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "deploy": "npm run verify && wrangler deploy",
    "test:content": "node --test tests/content.test.mjs",
    "test:browser": "playwright test",
    "test:extension": "node --test tests/extension.test.mjs",
    "verify": "npm run check && npm run validate:content && npm run test:content && npm run build && npm run test:browser && npm run test:extension"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.150.0"
  }
}
