{
  "name": "carlenglish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "deploy": "pnpm run verify && wrangler deploy",
    "test:content": "node --test tests/content.test.mjs tests/catalog.test.mjs tests/articles.test.mjs tests/seo.test.mjs",
    "test:browser": "playwright test",
    "test:extension": "node --test tests/extension.test.mjs",
    "verify": "pnpm run check && pnpm run validate:content && pnpm run test:content && pnpm run build && pnpm run test:browser && pnpm run test:extension"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "wrangler": "4.150.0"
  }
}
