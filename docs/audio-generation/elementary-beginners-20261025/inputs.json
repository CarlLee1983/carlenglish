      "sceneId": "rainy-school-day",
      "kind": "sentences",
      "sentenceIndex": 0,
      "src": "/audio/sentences/rainy-school-day/1.mp3",
      "text": "It is raining on the way to school.",
      "textSha256": "6d07401337913cf36233843775d773f208e6022e5cd3604a8491ee10a113633b"
    },
    {
      "sceneId": "rainy-school-day",
      "kind": "sentences",
      "sentenceIndex": 1,
      "src": "/audio/sentences/rainy-school-day/2.mp3",
      "text": "Bo puts on his raincoat and boots.",
      "textSha256": "a44cf416f60074b5cf2f06460f22f52df39259894ce3a32404f76fd0647c7d82"
    },
    {
      "sceneId": "rainy-school-day",
      "kind": "sentences",
      "sentenceIndex": 2,
      "src": "/audio/sentences/rainy-school-day/3.mp3",
      "text": "His dad holds a big umbrella.",
      "textSha256": "2810b5c5764de0d44596ad592026c070118b31f1c047010b03ebe7e8232b8c30"
    },
    {
      "sceneId": "rainy-school-day",
      "kind": "sentences",
      "sentenceIndex": 3,
      "src": "/audio/sentences/rainy-school-day/4.mp3",
      "text": "They stand together under the umbrella.",
      "textSha256": "0e7ea246025582d79b653f2c3e6fc3fb1c6f92eebb031c7a1f968ee952b8263e"
    },
    {
      "sceneId": "rainy-school-day",
      "kind": "sentences",
      "sentenceIndex": 4,
      "src": "/audio/sentences/rainy-school-day/5.mp3",
      "text": "Dad says, “We can walk slowly.”",
      "textSha256": "93e9a7137fe1ed61dd9bbc098f4d9b5727700820cff7946263e56d34a0589a31"
    },
    {
      "sceneId": "rainy-school-day",
