      "kind": "sentences",
      "sentenceIndex": 0,
      "src": "/audio/sentences/classroom-cleanup/1.mp3",
      "text": "After class, An says, “Let's clean up.”",
      "textSha256": "aad40115080f726ed69980b5705ff788931cd05bacfcba2c8c7ac5c3873f5c5f"
    },
    {
      "sceneId": "classroom-cleanup",
      "kind": "sentences",
      "sentenceIndex": 1,
      "src": "/audio/sentences/classroom-cleanup/2.mp3",
      "text": "She wipes the desk with a cloth.",
      "textSha256": "5b4847db4e45647d8a22db92cb9b87611f0549e09c91899db4a8ad200c189425"
    },
    {
      "sceneId": "classroom-cleanup",
      "kind": "sentences",
      "sentenceIndex": 2,
      "src": "/audio/sentences/classroom-cleanup/3.mp3",
      "text": "Yu uses a broom to sweep the floor.",
      "textSha256": "f6485cdc78aadbf067615fbf6e2e8d9f87fcb78625d37f52807659d16ab14c32"
    },
    {
      "sceneId": "classroom-cleanup",
      "kind": "sentences",
      "sentenceIndex": 3,
      "src": "/audio/sentences/classroom-cleanup/4.mp3",
      "text": "An says, “We can recycle the paper.”",
      "textSha256": "e0cd33398b4db9a8b9b571c3fa1b3ac1ab7e9073d625a7607524d55f1404c26f"
    },
    {
      "sceneId": "classroom-cleanup",
      "kind": "sentences",
      "sentenceIndex": 4,
      "src": "/audio/sentences/classroom-cleanup/5.mp3",
      "text": "Mia puts the paper in the recycling bin.",
      "textSha256": "1282fbda8fb2d33bae16d8952bfcb323fb0f13ac20abaab824a84e7a6999b3f1"
    },
    {
      "sceneId": "classroom-cleanup",
      "kind": "sentences",
      "sentenceIndex": 5,
      "src": "/audio/sentences/classroom-cleanup/6.mp3",
      "text": "The room is clean, and they smile.",
      "textSha256": "04632f8b54a5e80af17addd317a3ea52c611665cd9588d9c08abb313c217188b"
    },
