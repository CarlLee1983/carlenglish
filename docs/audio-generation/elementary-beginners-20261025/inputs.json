      "kind": "sentences",
      "sentenceIndex": 1,
      "src": "/audio/sentences/pretend-picnic/2.mp3",
      "text": "They put toy food in a basket.",
      "textSha256": "48e1a1db1b8cfcd69e17cbcf29b50d699e7f171b7202577a7454249d9ac856aa"
    },
    {
      "sceneId": "pretend-picnic",
      "kind": "sentences",
      "sentenceIndex": 2,
      "src": "/audio/sentences/pretend-picnic/3.mp3",
      "text": "An says, “Let's have a picnic!”",
      "textSha256": "add7d97d517ecd5d1b6836eebebd1b5952e5f192d24f97c5a0759567e8023bac"
    },
    {
      "sceneId": "pretend-picnic",
      "kind": "sentences",
      "sentenceIndex": 3,
      "src": "/audio/sentences/pretend-picnic/4.mp3",
      "text": "Yu says, “Here is your cup.”",
      "textSha256": "0ce6ba46f2c668d0074b0d5eef9ed38f0862f31fb37842e9fcd8d74cf0d2fff5"
    },
    {
      "sceneId": "pretend-picnic",
      "kind": "sentences",
      "sentenceIndex": 4,
      "src": "/audio/sentences/pretend-picnic/5.mp3",
      "text": "They pretend to drink tea and share the food.",
