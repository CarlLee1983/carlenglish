      "sceneId": "night-market-fruit",
      "kind": "sentences",
      "sentenceIndex": 0,
      "src": "/audio/sentences/night-market-fruit/1.mp3",
      "text": "Bo visits the night market with his mother.",
      "textSha256": "971df794fc37b6b7698e484dfdb1802f18e2ba03cc78de39dabefe11357b74d8"
    },
    {
      "sceneId": "night-market-fruit",
      "kind": "sentences",
      "sentenceIndex": 1,
      "src": "/audio/sentences/night-market-fruit/2.mp3",
      "text": "The fruit stall has bright lights.",
      "textSha256": "4013ca9da1ebc5e8429cff183a65ca4e9f776f237d03d83dbe3f2446c8a651e2"
    },
    {
      "sceneId": "night-market-fruit",
      "kind": "sentences",
      "sentenceIndex": 2,
      "src": "/audio/sentences/night-market-fruit/3.mp3",
      "text": "Bo says, “I like these bananas.”",
      "textSha256": "acffdbacda4a5c824a1a8caeadedc2199546af993b3e2e38ded1fd27c555aec4"
    },
    {
      "sceneId": "night-market-fruit",
      "kind": "sentences",
      "sentenceIndex": 3,
      "src": "/audio/sentences/night-market-fruit/4.mp3",
      "text": "He asks the seller, “Two apples, please.”",
      "textSha256": "6928e12564e14612c44ddcec042ff3179843e5dedbdc201296d51f47f6a07cb4"
    },
    {
      "sceneId": "night-market-fruit",
      "kind": "sentences",
      "sentenceIndex": 4,
      "src": "/audio/sentences/night-market-fruit/5.mp3",
      "text": "His mother helps him put fruit in a bag.",
      "textSha256": "f832f65c61f1f810adebdcb1e1174b611d123a6a2fd7bc4b1eccf7e466327cba"
    },
    {
      "sceneId": "night-market-fruit",
      "kind": "sentences",
      "sentenceIndex": 5,
      "src": "/audio/sentences/night-market-fruit/6.mp3",
      "text": "“Thank you!” Bo says to the seller.",
      "textSha256": "3c48b458d98031dad504a8a359110f58db0f86e875bf3daeb3da3816ba1f43f4"
    },
    {
      "sceneId": "night-market-fruit",
