    {
      "src": "/audio/sentences/confirming-online-booking/1.mp3",
      "text": "Good evening, we made an advance reservation for a private game room tonight.",
      "textSha256": "1c5c8f6bb16cc9e331853fe6a1bebe18f3956cd9470e94bef3d93ea85f165579"
