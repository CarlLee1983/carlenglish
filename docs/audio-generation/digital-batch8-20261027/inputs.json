    {
      "src": "/audio/sentences/resending-verification-code/1.mp3",
      "text": "I am registering a new online account, but I have not received the text message.",
      "textSha256": "86f0355f7159102d4b6b61c3bc6f803d336e66f06ff4e6a44eb3e38f2edffd24"
