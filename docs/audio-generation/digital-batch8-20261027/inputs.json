    },
    {
      "src": "/audio/sentences/confirming-online-booking/4.mp3",
      "text": "The reservation code is BK-920 under the name of Sarah Chen.",
      "textSha256": "8889f395d7a559862d44ed067c6b7879e2b3579ce36585ea527d83299c5bf40d"
    },
    {
      "src": "/audio/sentences/confirming-online-booking/5.mp3",
      "text": "Our computer system confirms your table is clean and completely ready.",
