    },
    {
      "src": "/audio/sentences/cafe-wifi-password/4.mp3",
      "text": "Type in the word coffee followed by the four digits 2026.",
      "textSha256": "8655fa22fcee210eff21b52251f2fac8cc3c5bd90c589f9925a78b7eb313805b"
    },
    {
      "src": "/audio/sentences/cafe-wifi-password/5.mp3",
      "text": "Remember that the first letter must be entered in lowercase.",
      "textSha256": "948ac9e698be96dfefaec27f1f51af1130df325e4cee352917f20f4268209bea"
    },
    {
