    {
      "src": "/audio/sentences/cafe-wifi-password/1.mp3",
      "text": "Excuse me, do you provide free customer Wi-Fi access in this coffee shop?",
      "textSha256": "b947f0d39a2134e9f99e589a5253938fbed79cf328ef5d0d3c5cd406c6b9960f"
    },
    {
      "src": "/audio/sentences/cafe-wifi-password/2.mp3",
      "text": "Yes, look for the network name printed on your payment receipt.",
      "textSha256": "8be4da9b6bb7baba80d440cfce64b54e9ecf8ca6536e872fe186223af04539fd"
    },
    {
      "src": "/audio/sentences/cafe-wifi-password/3.mp3",
      "text": "What is the password to connect my laptop to the internet?",
