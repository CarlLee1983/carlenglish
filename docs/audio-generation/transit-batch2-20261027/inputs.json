    {
      "src": "/audio/sentences/bus-delay-inquiry/1.mp3",
      "text": "Excuse me, bus number 302 was scheduled to arrive at nine.",
      "textSha256": "bbe386ed37d355fa4f7e852d6d70e379d84de1a15a76135553ee9b07230a607f"
    },
    {
      "src": "/audio/sentences/bus-delay-inquiry/2.mp3",
      "text": "It is already twenty minutes late, do you know what happened on the road?",
      "textSha256": "954fdf37bcd64cb00e45afbc2c0c67edf4e552e1fe5aa22ddc40b758487319d8"
    },
    {
      "src": "/audio/sentences/bus-delay-inquiry/3.mp3",
      "text": "There was a small car accident that caused a long delay.",
      "textSha256": "c52f297a3fbf9064e656a95c7f62157c37d41e4f9b15e0ee059de38c1ebbb5b3"
    },
    {
      "src": "/audio/sentences/bus-delay-inquiry/4.mp3",
      "text": "Is the bus still coming, or will we miss our transfer?",
      "textSha256": "328497f0b3202312b6b760240894b587e90e94853e90e0a78310b725850472b0"
    },
    {
      "src": "/audio/sentences/bus-delay-inquiry/5.mp3",
      "text": "The GPS system shows it will probably arrive in six minutes.",
      "textSha256": "c1e2ac0f79313810c30d84e950d9ea58d3c3307ff431a553551bf61521620b38"
    },
    {
      "src": "/audio/sentences/bus-delay-inquiry/6.mp3",
      "text": "It seems the delay will not be much longer, thank you.",
