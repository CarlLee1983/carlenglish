      "src": "/audio/sentences/bakery-fresh-batch/1.mp3",
      "text": "The whole store smells wonderful like warm butter.",
      "textSha256": "40cd0e6802b82789b3d395dbab50cfcdced30d3eea057ea096e0a3d0014c5adf"
    },
    {
