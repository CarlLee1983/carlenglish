    {
      "src": "/audio/sentences/renting-public-bike/1.mp3",
      "text": "I want to rent a bike to ride around the lake.",
      "textSha256": "d40d0340f5b39defc7987863bd8beece258ce7d86b870dbb0ac98998e9cf0bd2"
    },
    {
      "src": "/audio/sentences/renting-public-bike/2.mp3",
      "text": "Tap your card on the sensor right beside the bike.",
      "textSha256": "bfabed9558da6da42ee867564eafe615a2d1cb82c58c588ed784025192a15963"
    },
    {
      "src": "/audio/sentences/renting-public-bike/3.mp3",
      "text": "When the green light turns on, pull the lock firmly.",
      "textSha256": "be6fcdc87c10ea0df27048b47c3db856a0b0b6e505375acfe4e1a0dcc99a133f"
    },
    {
      "src": "/audio/sentences/renting-public-bike/4.mp3",
      "text": "Remember to check the tires before you start your ride.",
      "textSha256": "f9d5b50180ee6fdaff125890ae2c31c06bce1b27a7335309bfe498da3015b59c"
    },
    {
      "src": "/audio/sentences/renting-public-bike/5.mp3",
      "text": "You can adjust the seat height by pressing the metal lever.",
      "textSha256": "9da6a1fa28da9b5b32c3362f051af3c911e7788d11f67e2efc6214aed6812c3f"
    },
    {
      "src": "/audio/sentences/renting-public-bike/6.mp3",
      "text": "The first thirty minutes are completely free for registered members.",
      "textSha256": "ee21f3aab2657d45be2f7e936cc6d96f4a1b3de7f04a2f038d81d04ce8451ccf"
    },
    {
