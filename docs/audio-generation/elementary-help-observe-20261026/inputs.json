      "src": "/audio/sentences/setting-table/1.mp3",
      "text": "Bo helps Dad set the table.",
      "textSha256": "36b9d80a28db9e52ddc7cf6197ff51e38f6873a40db6671647fe59dfa485446f"
    },
    {
