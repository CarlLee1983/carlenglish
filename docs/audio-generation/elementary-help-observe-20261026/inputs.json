    {
      "src": "/audio/sentences/shoe-shop-fit/1.mp3",
      "text": "Mei tries on new shoes with Mom.",
      "textSha256": "c2434ad666add80fd78a4c8e3c9d2b754d49f0713c2c994e2a14f53d86bc2d75"
    },
    {
      "src": "/audio/sentences/shoe-shop-fit/2.mp3",
      "text": "“These shoes are too small,” she says.",
      "textSha256": "8160286d1b327faa626f0643d180aa316fe6d858c3b244d9e7682ea94bb346a4"
    },
    {
      "src": "/audio/sentences/shoe-shop-fit/3.mp3",
      "text": "A clerk brings her a bigger pair.",
      "textSha256": "f9e3c545cffb77a28de5da320a02aefb422bc441eaa14370c56689a75ca39119"
    },
    {
      "src": "/audio/sentences/shoe-shop-fit/4.mp3",
      "text": "Mei walks a few steps in them.",
      "textSha256": "426d01a154c221234e017e8bb37b47afa7b067995849006523b373934ccbbd82"
    },
    {
      "src": "/audio/sentences/shoe-shop-fit/5.mp3",
      "text": "“How do they feel?” asks Mom.",
      "textSha256": "3dbe054df317653d265505fb079f64877534762214137a5dfe3b08cc410aae6b"
    },
    {
      "src": "/audio/sentences/shoe-shop-fit/6.mp3",
      "text": "“They fit well!” says Mei with a smile.",
      "textSha256": "5583a4ebb11314dff85672c2df0c06c4172442177a78c0feb25a7532eb931394"
    },
