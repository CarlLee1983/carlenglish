    {
      "src": "/audio/sentences/seed-in-a-pot/1.mp3",
      "text": "Mei puts soil in a small pot.",
      "textSha256": "f63ce91a8e05e59c62ae297fa956fbe47e57d26fec1f4613533f7b86efeb10c6"
    },
    {
      "src": "/audio/sentences/seed-in-a-pot/2.mp3",
      "text": "She plants a seed with Mom.",
      "textSha256": "deb472e0e693e52a53c2073ef3f26a59a5a0b5f40c45e631cbefa4b595c49198"
    },
    {
      "src": "/audio/sentences/seed-in-a-pot/3.mp3",
      "text": "“A little water, please,” says Mom.",
      "textSha256": "2055289e73e03af782ae9483d547dda13fd7ad2d85fdd32a83cd1c9be444f304"
    },
    {
      "src": "/audio/sentences/seed-in-a-pot/4.mp3",
      "text": "They put the pot by the window.",
      "textSha256": "c11370d7a9b2d71fcab6fa20aeffbde12b1f371b3575fcec3d29aca0e86294ef"
    },
    {
      "src": "/audio/sentences/seed-in-a-pot/5.mp3",
      "text": "Mei checks the pot every day.",
      "textSha256": "e766db89642f0ffceb9ed3a9ae4cf055942a7ed12e91b6f317e3166154375ce2"
    },
    {
