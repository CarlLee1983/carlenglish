    {
      "src": "/audio/sentences/folding-laundry/1.mp3",
      "text": "Yu helps Dad with the clean clothes.",
      "textSha256": "d63ad215e3465e92b9e92ad6393ede236f31e4ac34eeadf93a7a5dd8df023b12"
    },
    {
      "src": "/audio/sentences/folding-laundry/2.mp3",
      "text": "Dad says, “Let’s fold this shirt.”",
      "textSha256": "31ad6028a85e83acad05ab5605d59704b4540e7aeb6210032361dda52abae517"
    },
    {
      "src": "/audio/sentences/folding-laundry/3.mp3",
      "text": "Yu finds one blue sock in the basket.",
      "textSha256": "59ef828c2999ef91ab504c8a4933e5157f9c09d244faf4a26c8c3eabd1ee83e9"
    },
    {
      "src": "/audio/sentences/folding-laundry/4.mp3",
      "text": "“Where is the other sock?” he asks.",
      "textSha256": "e294a27e8abc7ab2813672ae670c80d0fb258902b780e9f80cf2920403ddd82c"
    },
    {
      "src": "/audio/sentences/folding-laundry/5.mp3",
      "text": "Dad points to a sock under the shirt.",
      "textSha256": "6d590964a68c4da21bbd3207413fc02be1783dd048df507c89915845ff9aad43"
    },
    {
      "src": "/audio/sentences/folding-laundry/6.mp3",
      "text": "“Now I have a pair!” says Yu.",
