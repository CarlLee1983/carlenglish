    {
      "src": "/audio/sentences/wash-before-snack/1.mp3",
      "text": "An comes home and puts down her bag.",
      "textSha256": "48927a2beda9b3bd064d9b5dabf190773a328fa6929ffc8dd6bf297c7d89ea5b"
    },
    {
      "src": "/audio/sentences/wash-before-snack/2.mp3",
      "text": "Mom says, “Let’s wash our hands.”",
      "textSha256": "4a61ffbae30eed17d800e8b08516c8d8bbbcaa20f9db60eb6c35c5194d508fa6"
    },
    {
      "src": "/audio/sentences/wash-before-snack/3.mp3",
