      "textSha256": "04df1a2ae0d48856b177af3a59f4a01d5faa96b6af8b498573341b97b8d61209"
    },
    {
      "src": "/audio/sentences/wash-before-snack/5.mp3",
      "text": "“Here is a towel,” says Mom.",
      "textSha256": "86bd3efde865b4a6095dd658e7411db13cca97c91fad53146b8dce6346aef6ce"
    },
    {
      "src": "/audio/sentences/wash-before-snack/6.mp3",
