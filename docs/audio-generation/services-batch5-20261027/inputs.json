    {
      "src": "/audio/sentences/information-desk-map/1.mp3",
      "text": "Good afternoon, could I get an English guide map of the building?",
      "textSha256": "f2aabda782696af8bfdb643e373cc7a82b01d30a6c41bef9f218272a3aa914b5"
    },
    {
      "src": "/audio/sentences/information-desk-map/2.mp3",
      "text": "Here is our free visitor guide with every exhibition hall.",
      "textSha256": "57c569146988d5dd708ceec4bab176d7f7e1e919a5ef776cbf56cf7992f22804"
    },
    {
      "src": "/audio/sentences/information-desk-map/3.mp3",
      "text": "Where are the public restrooms and the drinking water fountains located?",
      "textSha256": "a1b329c48ea5c25212d3a9e2cfff55e3d75593b0613898107e0ab1c8fd4af370"
    },
    {
      "src": "/audio/sentences/information-desk-map/4.mp3",
      "text": "Restrooms are on every floor right next to the elevator.",
      "textSha256": "aa504785f7ceb74e109f7f70f58686e39110f226bf708d51728c6f0f752100d4"
    },
    {
      "src": "/audio/sentences/information-desk-map/5.mp3",
      "text": "Can you show me where the special dinosaur hall is on this level?",
      "textSha256": "9c11d3d49b73fdb57a4b5aa87637e15f948383ef245b3fc7fc7719a0347462ab"
    },
    {
      "src": "/audio/sentences/information-desk-map/6.mp3",
      "text": "It is straight down this corridor behind the gift shop.",
