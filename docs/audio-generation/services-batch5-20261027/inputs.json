    {
      "src": "/audio/sentences/library-overdue-fee/1.mp3",
      "text": "I am here to return books to the front desk today.",
      "textSha256": "f2bda1390bf7739e82d791b1eb694cb996587f210485d8d2ab1487d94c10cde8"
    },
    {
      "src": "/audio/sentences/library-overdue-fee/2.mp3",
      "text": "Let me scan the barcode on your student library card first.",
      "textSha256": "76934a92031767b2d7a6f9fb67e4a6b04c636bc2cf663776605a35913240f7ee"
    },
    {
      "src": "/audio/sentences/library-overdue-fee/3.mp3",
      "text": "Our system record shows that both books are five days overdue.",
      "textSha256": "d2fc391ca3483bdc3b6a102c130b015b564311cce1dba0e95fee44fd5e096307"
    },
    {
      "src": "/audio/sentences/library-overdue-fee/4.mp3",
      "text": "According to the library rule, there is a small fee of two dollars per day.",
      "textSha256": "431200640164478809998ca8b525e6de5c4bfac92140ffcc23a020e3a50407c5"
    },
    {
      "src": "/audio/sentences/library-overdue-fee/5.mp3",
      "text": "I am really sorry about forgetting the return due date.",
      "textSha256": "94120fe3628459647a5c4818a5067f18a4338499154e77a8b9fea6c7be717a2c"
    },
    {
      "src": "/audio/sentences/library-overdue-fee/6.mp3",
      "text": "Once you pay the twenty dollar fee, you can borrow books again.",
      "textSha256": "028672ba564015113787e7bcb502ca25373dee4210947a87cd6a041e4c3b5c4e"
    },
    {
