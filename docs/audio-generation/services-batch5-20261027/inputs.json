    {
      "src": "/audio/sentences/mailing-registered-letter/1.mp3",
      "text": "Good morning, I need to send an important document to this overseas address.",
      "textSha256": "7453e9d7b204168f2fd88a6c8c79180586eb72053243c3016d250a17d10e7ada"
    },
    {
      "src": "/audio/sentences/mailing-registered-letter/2.mp3",
      "text": "Please place the envelope on the electronic scale to check the weight.",
      "textSha256": "50b84ea3ba465b2bbb6e6e70b1aa3b7eda24eb7715857352b434523ef57eb7ae"
    },
    {
      "src": "/audio/sentences/mailing-registered-letter/3.mp3",
      "text": "Do you want to send it by regular air mail or express post?",
      "textSha256": "e48bee3cd9a20bd69312581f841dd248ad67120b544d9215c5d3f5ac6cca7f0f"
    },
    {
      "src": "/audio/sentences/mailing-registered-letter/4.mp3",
      "text": "Express post is very fast and provides an online tracking number.",
      "textSha256": "f7d2d2300becdcc5d8798aa0b1e94bcbd56456da3ac00e69ef7978adc9c17dc1"
    },
    {
      "src": "/audio/sentences/mailing-registered-letter/5.mp3",
      "text": "How much does the express registered stamp cost for this letter?",
      "textSha256": "9e1380c1edf632493b25326789b6b122c45ea0ab3564c79be5c26b17fe77bf22"
    },
    {
      "src": "/audio/sentences/mailing-registered-letter/6.mp3",
      "text": "It costs eighty dollars, and it will arrive within four business days.",
      "textSha256": "10e6be94c3983aa61ff074e149740b0a721a0954713fff6068d448f781c190a9"
    },
    {
      "src": "/audio/phrases/mailing-registered-letter-send-an-important-document.mp3",
