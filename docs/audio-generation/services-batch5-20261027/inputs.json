    {
      "src": "/audio/sentences/lost-bag-inquiry/1.mp3",
      "text": "Hello, I think I left my bag inside the concert hall.",
      "textSha256": "e4e7ae40711a5a2dcbfb0971a5e9b5747547b11459090c71b45740ee9189f28d"
    },
    {
      "src": "/audio/sentences/lost-bag-inquiry/2.mp3",
      "text": "Can you remember the color and what material it was made of?",
      "textSha256": "194f26feae55cbc3fa53e929b55a4eae6347994d60bc5cd201cc7e861afeb430"
    },
    {
      "src": "/audio/sentences/lost-bag-inquiry/3.mp3",
      "text": "It is a small black leather bag with a metal zipper.",
      "textSha256": "e1a8dc539d2b9c9e387f2efee5ad8a5e58a52f18674c6fc515abf80daafc2288"
    },
    {
      "src": "/audio/sentences/lost-bag-inquiry/4.mp3",
      "text": "Can you tell me what was inside the main pocket?",
      "textSha256": "927afeb2cb8204f50e7f1281f2129eb170661ef3e6dcde33e7a3879ab22034dd"
    },
    {
      "src": "/audio/sentences/lost-bag-inquiry/5.mp3",
      "text": "There are house keys, an umbrella, and a blue student notebook.",
      "textSha256": "6ec2f0ed10392ffb09bde4e96a7db4af4dcb731834168c1a9c2d8c68b4ade7d6"
    },
    {
      "src": "/audio/sentences/lost-bag-inquiry/6.mp3",
      "text": "A cleaner just found that exact bag, please sign the contact form to claim it.",
