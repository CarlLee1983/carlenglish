  "clips": [
    {
      "src": "/audio/sentences/lost-at-intersection/1.mp3",
      "text": "Excuse me sir, I think I am completely lost at this crossroads.",
      "textSha256": "0d04796be88e4b14481a8ba6295c1bd8d6956978ad871198136d6663b7d12ce7"
    },
    {
      "src": "/audio/sentences/lost-at-intersection/2.mp3",
      "text": "Can you tell me how to get to the modern art museum?",
      "textSha256": "e9714022319287fe79a8042381920631aa1702f8cabc33554de75ece7ed4581a"
    },
    {
      "src": "/audio/sentences/lost-at-intersection/3.mp3",
      "text": "Do not worry, it is not too far, only half a mile away from here.",
      "textSha256": "846385fe287c2be57df78c4bec8d9c53af61c935d52465db709400204f3f3694"
    },
    {
      "src": "/audio/sentences/lost-at-intersection/4.mp3",
      "text": "Walk straight along this avenue and walk past the tall white building.",
      "textSha256": "bd84a2e07029bb39d9c212ba3b7be10a25ecb25fd34b8f06fdb3691660fcc9c1"
    },
    {
      "src": "/audio/sentences/lost-at-intersection/5.mp3",
      "text": "Cross the street at the pedestrian light and turn right at the corner.",
      "textSha256": "ed6266b4d78cc2799d4e008ada22423b203e9f45e06bc084e304a0fe6d707ade"
    },
    {
      "src": "/audio/sentences/lost-at-intersection/6.mp3",
      "text": "You will see the museum entrance right on your left hand side.",
      "textSha256": "249586865f27e518f2f88f25cda89fe91812ef5f4d87b4314e13e9fc5417c879"
    },
