    {
      "src": "/audio/sentences/bedtime-book/1.mp3",
      "text": "Mei chooses a book before bed.",
      "textSha256": "e619425e6c1f49d36abca96f1b924c78a7178194fd16f07c36757352f3f97fc0"
    },
    {
      "src": "/audio/sentences/bedtime-book/2.mp3",
      "text": "“This one, please,” she says to Dad.",
      "textSha256": "6ec7acb18dc8c380ce5eb1a3fe14a9caf27494325b3d987068fdcd7a9f1f901c"
    },
    {
      "src": "/audio/sentences/bedtime-book/3.mp3",
      "text": "They sit together under a soft blanket.",
      "textSha256": "16a72b76e4dc0457647d8702c2a0b0155119f7367ddebc9563dd24a315d624a1"
    },
    {
      "src": "/audio/sentences/bedtime-book/4.mp3",
      "text": "Dad opens the book to the first page.",
      "textSha256": "e098a42c7c111d9793980c616cebc0626a6d823459f3a8faaf9d5ae02d07bd9a"
    },
    {
      "src": "/audio/sentences/bedtime-book/5.mp3",
      "text": "Mei points to a star in the picture.",
      "textSha256": "369192857d2ff4ecc51c7a14fcbdbaf44dbeea806a5ade2844d45a416ded10f0"
    },
    {
      "src": "/audio/sentences/bedtime-book/6.mp3",
      "text": "“One more page, please!” she says.",
      "textSha256": "f320e83ff03b3c307cdca2b65ca7dfaa57283c99ed126eb5e01045ba7a1a9468"
    },
