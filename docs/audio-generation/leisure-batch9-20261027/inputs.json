    {
      "src": "/audio/sentences/sports-match-cheering/1.mp3",
      "text": "The basketball gym is completely packed with students cheering for our school match.",
      "textSha256": "371924f5a5680f293bd66404e3a1a99f05c48c9904737c16d1f39c1e94085cda"
    },
    {
      "src": "/audio/sentences/sports-match-cheering/2.mp3",
      "text": "Our team is trailing by just two points on the electronic scoreboard.",
      "textSha256": "7a523798ccc92be07b597e587380bd46fb29738ca3205a93544ac21283a526a4"
    },
    {
      "src": "/audio/sentences/sports-match-cheering/3.mp3",
      "text": "Number seven made a fantastic pass, and the center scored a thrilling goal!",
      "textSha256": "13bc870b6d8c8ae0ac7760d4c852c17def16decc95799f1542592c4abae68d48"
    },
    {
      "src": "/audio/sentences/sports-match-cheering/4.mp3",
      "text": "Every player on the court showed incredible defensive action in the final minute.",
      "textSha256": "8ad46ea319f312b7b64a5b8fd61b7091abac4ac6d9ec63bb9bd3bdbc865cf357"
    },
    {
      "src": "/audio/sentences/sports-match-cheering/5.mp3",
      "text": "Everyone stood up and shouted loud cheers as our team took the lead.",
      "textSha256": "427df01072779206c4196b95394220fdd82c97e373fd122f8005fbb14250df32"
    },
    {
      "src": "/audio/sentences/sports-match-cheering/6.mp3",
      "text": "With great effort and collective determination, our classmates celebrated a proud win.",
      "textSha256": "6616bf8ccb84cd298ccc2d0e0ea8a523042e0b59bc04ad0e3dad38cb813c12ec"
    },
