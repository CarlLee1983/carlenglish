    {
      "src": "/audio/sentences/museum-exhibition-audio-guide/1.mp3",
      "text": "I would like to rent an audio guide device for the ancient history exhibit.",
      "textSha256": "ad500af68f0360e56a768abe6489f0736a368a5065fd06418522a29abb086972"
    },
    {
      "src": "/audio/sentences/museum-exhibition-audio-guide/2.mp3",
      "text": "Which language would you like the audio commentary to play in?",
      "textSha256": "72f3941d5782d356022fe4ec2204106d5c498fe393c540c69f5d49bc806ad4df"
    },
    {
      "src": "/audio/sentences/museum-exhibition-audio-guide/3.mp3",
      "text": "Please set it to English so I can practice listening to historical terms.",
      "textSha256": "fa16ad7572e52fd84417e5dde4b3c6e02fe756829015920d4b5363ae03809d42"
    },
    {
      "src": "/audio/sentences/museum-exhibition-audio-guide/4.mp3",
      "text": "When you walk up to any display case, simply press the matching number on the keypad.",
      "textSha256": "0e4d3710e74877c5c3699da555b8299cc87a7699e22c20f064992c6175380535"
    },
    {
      "src": "/audio/sentences/museum-exhibition-audio-guide/5.mp3",
      "text": "Each track explains the culture and daily life of people during that dynamic period.",
      "textSha256": "63c53e9b4424ef61d554fdf3177f66fe4b3ef06dff622eada3ce76230d52862c"
    },
    {
      "src": "/audio/sentences/museum-exhibition-audio-guide/6.mp3",
      "text": "This handheld player really adds great interest to our afternoon museum tour.",
