    {
      "src": "/audio/sentences/cinema-ticket-booking/1.mp3",
      "text": "Good afternoon, we want to buy student tickets for the afternoon animated movie.",
      "textSha256": "42f87cd936c008451317bf197fecb0ad25e3084a21b4c0d5d5cc79652a491fcb"
    },
    {
      "src": "/audio/sentences/cinema-ticket-booking/2.mp3",
      "text": "Which screening time would you prefer, the two o'clock or the four thirty show?",
      "textSha256": "888eeef9639ffc8f807074b38951f7c046eff8a07a4f4bfd0022a5fb8a19b456"
    },
    {
      "src": "/audio/sentences/cinema-ticket-booking/3.mp3",
      "text": "The four thirty show fits our schedule, and are there good seats available in the middle row?",
      "textSha256": "9594da32d2072dba74832776a25a144c1d1a1b7c73f9678faefd3acbf75a6e6d"
    },
    {
      "src": "/audio/sentences/cinema-ticket-booking/4.mp3",
      "text": "Row F and row G in the center have a fairly clear view of the big screen.",
      "textSha256": "8051507ba7d23c9ba748d9c2ad105ccaf20d95c2f56f9dab73334a3b4a52f3bb"
    },
    {
      "src": "/audio/sentences/cinema-ticket-booking/5.mp3",
      "text": "I really hate sitting too close to the front because the sound is too loud.",
      "textSha256": "584ef4d24ec754f49331bbebef34e21b5e2ddd817e085fb19a9e8dc82dd5718b"
    },
    {
      "src": "/audio/sentences/cinema-ticket-booking/6.mp3",
