    },
    {
      "src": "/audio/sentences/asking-store-discount/5.mp3",
      "text": "That makes the total price very cheap for such good quality.",
      "textSha256": "eb2e25f5f9ae58d9ca12925c07381f76cd5d8caf0d6bc886ae3819ac4c402973"
    },
    {
