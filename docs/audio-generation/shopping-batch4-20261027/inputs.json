    {
      "src": "/audio/sentences/clothing-fitting-room/1.mp3",
      "text": "Excuse me, can I try on this blue jacket in the fitting room?",
      "textSha256": "552686e4f6138d72b22403b72d664cd3445924cd14d6d9eff1e48e439743b8b5"
    },
