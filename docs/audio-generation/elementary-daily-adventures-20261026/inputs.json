    {
      "src": "/audio/sentences/kite-in-park/1.mp3",
      "text": "Mei takes her kite to the park.",
      "textSha256": "726b4fbd00ed7543a81c7cf649c041c1df5b7ada29c7e0de5838e056d1e5c1c8"
    },
    {
      "src": "/audio/sentences/kite-in-park/2.mp3",
      "text": "Dad holds it while she gets the string.",
      "textSha256": "ca5574e94d4ec6be62296dfcd2b81650dc69c82fa5ba55ee84f8bd47263e21ed"
    },
    {
      "src": "/audio/sentences/kite-in-park/3.mp3",
      "text": "“Ready? Let go!” she calls to Dad.",
      "textSha256": "f534d3349cc54cbaff27b012a87eebe4913e15abb9b5ebadf7ef360fb47e6b11"
    },
    {
      "src": "/audio/sentences/kite-in-park/4.mp3",
      "text": "The kite goes up into the sky.",
      "textSha256": "3509dcfad8e8ebc169ab019e47f9c87d35968a2ee8cee5c68270d76f0c10cd9a"
    },
    {
      "src": "/audio/sentences/kite-in-park/5.mp3",
      "text": "Mei holds the string with both hands.",
      "textSha256": "95113c4e9782ef529fb169bd16595c857a256ead721faf13c61b99cf92fde369"
    },
    {
      "src": "/audio/sentences/kite-in-park/6.mp3",
      "text": "“Look! It is flying!” she says.",
