    },
    {
      "src": "/audio/sentences/fast-food-combo/4.mp3",
      "text": "I will take the salad, and what about the drink size?",
      "textSha256": "099add9ed7eeb7fd8e46431d2fc0ff1a16bbd3d2869c2639013ad1a73447c4f7"
    },
    {
      "src": "/audio/sentences/fast-food-combo/5.mp3",
      "text": "You can upgrade to a large cup for an extra dollar.",
