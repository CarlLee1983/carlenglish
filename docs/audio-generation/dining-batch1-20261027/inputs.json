    {
      "src": "/audio/sentences/checking-food-allergens/1.mp3",
      "text": "Excuse me, does it contain any peanuts in this salad dressing?",
      "textSha256": "7e0896f1b061f75d2fd0cd5ee6985d3b15ffb2b59f234dddab2878fe4386b205"
    },
    {
      "src": "/audio/sentences/checking-food-allergens/2.mp3",
      "text": "I need to be sure about this because my sister has a bad allergy.",
      "textSha256": "7bae62cc9ed8a077cb2c036b3ae5a01ebfa5c62b3fb4a52fe4ee333a1344745b"
    },
    {
      "src": "/audio/sentences/checking-food-allergens/3.mp3",
      "text": "If it contains nuts, could you prepare a safe one without dressing?",
      "textSha256": "81e7778ad17111b026c7ecfcd4db363e1de7701e74c7c0aade54d16172442900"
    },
    {
      "src": "/audio/sentences/checking-food-allergens/4.mp3",
      "text": "Our kitchen uses a special kind of olive oil for that.",
      "textSha256": "a063d826e2cfdc2aba7d45f7dbdb95ff95baf520681044ec51af8beb06b5c04d"
    },
    {
      "src": "/audio/sentences/checking-food-allergens/5.mp3",
      "text": "Does that mean there is no dairy in this dish?",
      "textSha256": "b7d1c151519c369371e5e44bc0abcd3cfe190baea22d2d2752f83e36bc36fe69"
    },
    {
      "src": "/audio/sentences/checking-food-allergens/6.mp3",
      "text": "Do not worry, food allergies really matter to us, so it is safe.",
