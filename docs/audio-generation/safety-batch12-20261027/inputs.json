    {
      "src": "/audio/sentences/first-aid-for-minor-cut/1.mp3",
      "text": "The sharp edge of the cardboard box gave me a minor paper cut on my finger.",
      "textSha256": "43f64cb273d6efe3efc7333c8df473c0714c7da71fc34e3d83d3df64b537cc43"
    },
    {
      "src": "/audio/sentences/first-aid-for-minor-cut/2.mp3",
      "text": "It bleeds a little bit and hurts whenever I bend my index finger.",
      "textSha256": "b7d002d45873403d5e3b60689fda6082a404fd76f5ef7f8eeafc7f94ee07c337"
    },
    {
      "src": "/audio/sentences/first-aid-for-minor-cut/3.mp3",
      "text": "First, wash the small cut gently under running clean water and soap.",
      "textSha256": "217722e354d065bd764e6cefc9483e7743178f0efc07f2b7f0ed66970dd119e8"
    },
    {
      "src": "/audio/sentences/first-aid-for-minor-cut/4.mp3",
      "text": "Open the green first aid kit box kept in the medicine cabinet.",
      "textSha256": "c4c0e6cc73c293ddd6e9ba73d78cbfc8ada3985eb57156de3f724e4bd974280f"
    },
    {
      "src": "/audio/sentences/first-aid-for-minor-cut/5.mp3",
      "text": "Be careful and wrap a breathable adhesive bandage around the wound.",
      "textSha256": "897ff963ae6a5f00a935eeeedc00616dd659d1c8b832b12b233d0361626fc9bd"
    },
    {
      "src": "/audio/sentences/first-aid-for-minor-cut/6.mp3",
      "text": "The bleeding stopped immediately, and the finger is well protected now.",
      "textSha256": "33a852080bea4bf524c7e8991e382195980d3e4c316212b7b4696bca9e8e6ec2"
    },
    {
