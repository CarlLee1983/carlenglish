    {
      "src": "/audio/sentences/fire-alarm-drill-response/1.mp3",
      "text": "A piercing fire alarm started ringing loudly throughout the school building.",
      "textSha256": "20b31d2979ef05515f08cc6e4d4373bca9c3331d9f072e9785ec92b2165e9f38"
    },
    {
      "src": "/audio/sentences/fire-alarm-drill-response/2.mp3",
      "text": "Our teacher told everybody to stay calm and not to panic.",
      "textSha256": "26b17589ff8acd45f9940d10ec81dd5b7f26205dba44aef4b75f82f7cffd6a75"
    },
    {
      "src": "/audio/sentences/fire-alarm-drill-response/3.mp3",
      "text": "Cover your mouth and nose with a damp cloth if there is any smoke in the hallway.",
      "textSha256": "6e73333d0d8dce932405fa793f2e5f5994facb636056eae737a7f9024e88d5d5"
    },
    {
      "src": "/audio/sentences/fire-alarm-drill-response/4.mp3",
      "text": "Do not take the elevator under any circumstances during an evacuation drill.",
      "textSha256": "7c4f30e42936f0cf3a287ae0aa8c1a718e6edab0f5e3280a6567306f348aa9f2"
    },
    {
      "src": "/audio/sentences/fire-alarm-drill-response/5.mp3",
      "text": "Follow the emergency exit signs down the wide concrete stairs.",
      "textSha256": "a17b89748917e07c43a35bed8b5f94c58b4d44a32d1c234c7664e4ff0d313636"
    },
    {
      "src": "/audio/sentences/fire-alarm-drill-response/6.mp3",
      "text": "All classes gathered safely outside on the open athletic field within three minutes.",
      "textSha256": "7c2970c1745bf5dd895034737645996629fa7ad99d179ae0efbd12774808e15d"
    },
