    {
      "src": "/audio/sentences/typhoon-weather-notice/1.mp3",
      "text": "The government weather bureau issued a strong land typhoon warning this morning.",
      "textSha256": "6cc4dab702f2a66a25d35869cbc8e414b9ef353a066c6723830996431194da1c"
    },
    {
      "src": "/audio/sentences/typhoon-weather-notice/2.mp3",
      "text": "Heavy rain and winds are expected across the entire city tonight.",
      "textSha256": "6a68895ef3cb8cd0131eba7f233b5f9d02884b9349d00335d8d886293d8e843f"
    },
    {
      "src": "/audio/sentences/typhoon-weather-notice/3.mp3",
      "text": "All schools and public offices received an official notice to close tomorrow.",
      "textSha256": "f278678d9ddc436738c71674c54d5688301c6dd7c681a72e44897138cd9ae9d7"
    },
    {
      "src": "/audio/sentences/typhoon-weather-notice/4.mp3",
      "text": "We must cancel our outdoor soccer match for safety reasons.",
      "textSha256": "c59b446dd36842c97415e662a02dc81f0f56dbaae772b2197dee6aec31e54ece"
    },
    {
      "src": "/audio/sentences/typhoon-weather-notice/5.mp3",
      "text": "Let us change the tournament date to next Saturday when the storm clears.",
      "textSha256": "999561eefe9cc7279d9750c63f1bd1f7b02ceaa7f44694e8894736e82c693049"
    },
    {
      "src": "/audio/sentences/typhoon-weather-notice/6.mp3",
      "text": "Remember to stay safely at home and tape the large glass windows securely.",
      "textSha256": "7b1de742809e2ddbd85ca48dd8456d9506d85abbe4200ba5fbad950721d51886"
    },
