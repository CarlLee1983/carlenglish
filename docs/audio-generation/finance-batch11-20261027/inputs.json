    {
      "src": "/audio/sentences/asking-for-change-at-counter/1.mp3",
      "text": "Excuse me counter clerk, could you please break this thousand-dollar bill for me?",
      "textSha256": "293ef1637fc34d91c0afa7224ce65b9452ad42024759704ffe0d83ec53969f62"
    },
    {
      "src": "/audio/sentences/asking-for-change-at-counter/2.mp3",
      "text": "I need small coins to use the self-service laundry machines down the street.",
