    {
      "src": "/audio/sentences/opening-student-bank-account/1.mp3",
      "text": "Good morning, I want to open a student savings account to save money today.",
      "textSha256": "8344d9d2252be06f506b83638e24a36f3c06d9bde2e7e42ce84aba1f3304ce69"
    },
    {
      "src": "/audio/sentences/opening-student-bank-account/2.mp3",
      "text": "Please provide your photo identification card and a written signature consent form from your parents.",
      "textSha256": "ff00e8f1df20952f731a66a6c912d6dd07328aa4bb2f8b742a564eab34bfb7af"
    },
    {
      "src": "/audio/sentences/opening-student-bank-account/3.mp3",
      "text": "Here are all the legal documents and our family household certificate.",
      "textSha256": "731c0baa1765b7ac5b6eff529cd6ea0ee08fbc496ad05f66a67e1477e08a95e9"
    },
    {
      "src": "/audio/sentences/opening-student-bank-account/4.mp3",
      "text": "The bank staff helped me fill out the registration form line by line.",
      "textSha256": "c09f5f4679f6775e7faa0650530c9558cbaa25ee8c7c9532c9ba511c793a27b5"
    },
    {
      "src": "/audio/sentences/opening-student-bank-account/5.mp3",
      "text": "You can make an initial deposit of five hundred dollars into your new account.",
      "textSha256": "3feb0f29dfbc3a9ceed054bb16002dbeccc9d38f5b1abf9c9e1b5fd024d63a45"
    },
    {
      "src": "/audio/sentences/opening-student-bank-account/6.mp3",
      "text": "This savings account earns yearly interest and includes a debit card for payments.",
      "textSha256": "566f1c8ca27c1edd552742b49dfcc1684a94d353f4895b6e3613c390d6a2b170"
    },
