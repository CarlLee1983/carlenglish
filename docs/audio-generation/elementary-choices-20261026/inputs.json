    {
      "src": "/audio/sentences/comparing-pencils/1.mp3",
      "text": "Bo has a red pencil and a blue pencil.",
      "textSha256": "a6f7b185cccfe3f536a6ccce4bc8d3739d3f15eacfebce9a9d27215761c65781"
    },
    {
      "src": "/audio/sentences/comparing-pencils/2.mp3",
      "text": "He puts them side by side.",
      "textSha256": "279c1739135d948edb017f7b7c5e6e9ddc78e1db4fa49d07d8d3ca67de8df38b"
    },
    {
      "src": "/audio/sentences/comparing-pencils/3.mp3",
      "text": "“Which one is longer?” asks his teacher.",
      "textSha256": "68b76e6a274d9cd2ced296fd9b0890bfb3d1f89e63a7fff5ede7f8757a182a93"
    },
    {
      "src": "/audio/sentences/comparing-pencils/4.mp3",
      "text": "“The red one,” says Bo.",
      "textSha256": "b73d426e0712e249d52db775bd0b8cb2e7c2872406f1f7aa073a7f81762982eb"
    },
    {
      "src": "/audio/sentences/comparing-pencils/5.mp3",
      "text": "He points to the shorter blue pencil.",
      "textSha256": "79680849e6b8999c7e23ca3da54d28d47ec4d43253bcf27b1ebf0e683a785e97"
    },
    {
      "src": "/audio/sentences/comparing-pencils/6.mp3",
