    {
      "src": "/audio/sentences/ice-cream-choice/1.mp3",
      "text": "Mei stops at an ice cream stand.",
      "textSha256": "9735234397dc43fb4dd72cc06cc9948afc6854aed5d7affa9e8e750af09304ac"
    },
    {
      "src": "/audio/sentences/ice-cream-choice/2.mp3",
      "text": "“Which flavor would you like?” asks the seller.",
      "textSha256": "0a527921be8296c477ea658dbc1a2881d4b0cf33ced026ea9c0a54fa04f96161"
    },
    {
      "src": "/audio/sentences/ice-cream-choice/3.mp3",
      "text": "“Strawberry, please,” says Mei.",
      "textSha256": "be7e4c2611f2c87ab7558b2108d89afb559d52a123be2313587fbb8e2e187928"
    },
    {
      "src": "/audio/sentences/ice-cream-choice/4.mp3",
      "text": "“A cone or a cup?” he asks.",
      "textSha256": "b1010466e8915cb8d2959e32338ae07b18e77bffbfb8aa25d72870e6e966209a"
    },
    {
      "src": "/audio/sentences/ice-cream-choice/5.mp3",
      "text": "“A cup, please,” she says.",
      "textSha256": "2f1e8f72c454093fdef9a788f80694f4c51e82a5ebf24fed7f4958dd46f09554"
    },
    {
      "src": "/audio/sentences/ice-cream-choice/6.mp3",
