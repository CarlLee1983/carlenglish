    {
      "src": "/audio/sentences/tablet-charging/1.mp3",
      "text": "An puts her tablet on the desk.",
      "textSha256": "188fd4e6e0d7fdf43c7e75ae7af869a66a24b023185df14f7b00b8c9e3e6fdb9"
    },
    {
      "src": "/audio/sentences/tablet-charging/2.mp3",
      "text": "“The battery is low,” she tells Mom.",
      "textSha256": "f39c9c4f85977b86e9ddc7335839af024f7ec8cebdf4bd1b8c263592a5577755"
    },
    {
      "src": "/audio/sentences/tablet-charging/3.mp3",
      "text": "“Can you help me?” she asks.",
      "textSha256": "87c7598d7ffe5b99c0ee2a8c33f2e7ba24307685428ec7f3f571c5d2ebe05089"
    },
    {
      "src": "/audio/sentences/tablet-charging/4.mp3",
      "text": "Mom brings a charger and a cable.",
      "textSha256": "03626953d85a9e4e05b3f8fc4b029fc6739fb589b1554aad814979da78133855"
    },
    {
      "src": "/audio/sentences/tablet-charging/5.mp3",
      "text": "She connects them to charge the tablet.",
      "textSha256": "7aa834306c35c850b0dc50272eb3f7d8d94845e65a0807e5b4e8a3ebae7ec6f3"
    },
    {
      "src": "/audio/sentences/tablet-charging/6.mp3",
      "text": "“We can wait,” says An.",
      "textSha256": "db9a4f59849fcae0634de21404d9b4078c864639141aa7ebaf87d7fda72b0222"
    },
    {
