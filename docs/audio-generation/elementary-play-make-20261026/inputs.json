      "textSha256": "ec07d4d39627b709da3c770674c26446665ccb5baf382f6f52c8dcc5c3c55389"
    },
    {
      "src": "/audio/sentences/wrapping-gift/3.mp3",
      "text": "“Hold this end, please,” he asks Mom.",
      "textSha256": "b4eb179a9b0012699ff250d707b31973270ec5df3116b343aca3aa804c002a8f"
    },
    {
      "src": "/audio/sentences/wrapping-gift/4.mp3",
