      "textSha256": "24d8f635e814e73e2b733ce682c612149779e1097a6414a4d7f52933dfc5ef52"
    },
    {
      "src": "/audio/sentences/family-photo/5.mp3",
      "text": "“Ready? Say cheese!” Mom says.",
      "textSha256": "33b76169bfded15df2e62bc9195efda8786a453dfea365b803aaa87094fa819d"
    },
    {
