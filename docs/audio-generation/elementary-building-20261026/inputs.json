    {
      "src": "/audio/sentences/bakery-rolls/1.mp3",
      "text": "Mei visits a bakery with Dad.",
      "textSha256": "78b3e187fe026a0bd962830bdf86d063222794411e9f2be1105f1d6752bd9d27"
    },
    {
      "src": "/audio/sentences/bakery-rolls/2.mp3",
      "text": "“Two rolls, please,” she tells the baker.",
      "textSha256": "a8dd2f211917e3f217cae54f58bf74d65fd14c4b544734b0bcaca7bdd6a28513"
    },
    {
      "src": "/audio/sentences/bakery-rolls/3.mp3",
      "text": "“Would you like a bag?” he asks.",
      "textSha256": "6487e15a4770dc63b7504ce33d344a8ed7e49aecf6737d35f06cc22b95e7830c"
    },
    {
      "src": "/audio/sentences/bakery-rolls/4.mp3",
      "text": "“Yes, please,” says Mei.",
      "textSha256": "5014f46bf346529eac58eae39cb133868a260f5da3eba3b4acf080bd9653be16"
    },
    {
      "src": "/audio/sentences/bakery-rolls/5.mp3",
      "text": "The baker puts the rolls in a bag.",
      "textSha256": "af1498c4caab2fa5d0516468b07134f0d8676a1d4c1c3316130572cd8d09212f"
    },
    {
      "src": "/audio/sentences/bakery-rolls/6.mp3",
      "text": "Mei carries the warm bread home.",
