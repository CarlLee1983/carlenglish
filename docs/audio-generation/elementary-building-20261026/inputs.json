    {
      "src": "/audio/sentences/block-tower/1.mp3",
      "text": "Bo builds a tower with An.",
      "textSha256": "1e78d83267a1c35a46be87f71e704c31704670a1b4996497680073e8d2b86f25"
    },
    {
      "src": "/audio/sentences/block-tower/2.mp3",
      "text": "He puts a big block on the rug.",
