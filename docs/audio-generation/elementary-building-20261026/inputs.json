    {
      "src": "/audio/sentences/art-tools-away/1.mp3",
      "text": "Yu sorts his art tools after class.",
      "textSha256": "9cf9ebfdadecabd78bf54aca47330816e2b35a4da158388506fa5508873ee911"
    },
    {
      "src": "/audio/sentences/art-tools-away/2.mp3",
      "text": "He puts the brushes in a jar.",
      "textSha256": "cbcc6fb08be2292675e6380776069561fa0c5e7b63dbe79f27b1610060146551"
    },
    {
      "src": "/audio/sentences/art-tools-away/3.mp3",
      "text": "“Where do these crayons go?” he asks.",
      "textSha256": "bb983d2b1d59e93a5bc5867e8870313e21a158c4fef4989700e4bed7862d436f"
    },
    {
      "src": "/audio/sentences/art-tools-away/4.mp3",
      "text": "“In this box,” says his teacher.",
      "textSha256": "1a3512b87216f12558e9000244a1cee703e74f5603ca31196b033c86a8a84c11"
    },
    {
      "src": "/audio/sentences/art-tools-away/5.mp3",
      "text": "Yu closes the box and stacks the paper.",
      "textSha256": "efc128544fa796d5fc011952c1649863b35fd4249e236ec9cd4d44f6c84b900f"
    },
    {
      "src": "/audio/sentences/art-tools-away/6.mp3",
      "text": "“Now my desk is tidy!” he says.",
      "textSha256": "769555601f909e47f7da82db507338ef9ffc9c75ade87ad8628cb77cff89cb0f"
    },
