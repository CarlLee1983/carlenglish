      "textSha256": "8a684aee1f01f90ed5d181258b46ca7f005359b640d92c3be45a174883d429fc"
    },
    {
      "src": "/audio/sentences/block-tower/4.mp3",
      "text": "“Can it stand?” asks Bo.",
      "textSha256": "5d3bf141e75d2c49f9fe627a32e3b7b015f7dd0ad0b2140bf023f8a1f84d8988"
    },
    {
      "src": "/audio/sentences/block-tower/5.mp3",
      "text": "They let go and watch the tower.",
      "textSha256": "7ab211aa3bedabc4675c1311c7a7bfd1234f4eec6d8116e98f88b698aba8b19a"
    },
    {
      "src": "/audio/sentences/block-tower/6.mp3",
      "text": "“Yes! It stands!” says An.",
