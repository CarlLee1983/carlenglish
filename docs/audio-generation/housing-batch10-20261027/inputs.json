    {
      "src": "/audio/sentences/replacing-burnt-out-bulb/1.mp3",
      "text": "The main ceiling light in my study room suddenly went dark last night.",
      "textSha256": "8d8a993ec9e5b7bae39a3480654020377312335cef59c9d9f882253c27362270"
    },
    {
      "src": "/audio/sentences/replacing-burnt-out-bulb/2.mp3",
      "text": "I brought the old burnt-out bulb to the hardware store to find an exact match.",
      "textSha256": "30009499399bb5d224feb86891823a4ab9877d9706010bf5f047ba5335f4120d"
    },
    {
      "src": "/audio/sentences/replacing-burnt-out-bulb/3.mp3",
      "text": "This energy-saving LED bulb fits the standard screw socket perfectly.",
      "textSha256": "f6e0cd95ce7ea3b08da9a44058006ec4ef8a217ce3f1b63991fd5eca4e7814b1"
    },
    {
      "src": "/audio/sentences/replacing-burnt-out-bulb/4.mp3",
      "text": "Before replacing the bulb on the ceiling, always turn off the wall power switch.",
      "textSha256": "a142767778ba86115ee97168dabfb995c2bca024f3a8d73d7bb10e8e390eb727"
    },
    {
      "src": "/audio/sentences/replacing-burnt-out-bulb/5.mp3",
      "text": "Wait five minutes to make sure the glass fixture is completely cool to the touch.",
      "textSha256": "ea84060bc16d09919766b1b9249632fdd388a817b2f03fe30770b98167f721e9"
    },
    {
      "src": "/audio/sentences/replacing-burnt-out-bulb/6.mp3",
      "text": "Turn the new bulb clockwise gently until it sits securely in place.",
      "textSha256": "b7dfc4e160a096064c28b12666fbb08860d5caf678635be291aae531ee2e2a61"
    },
    {
      "src": "/audio/phrases/replacing-burnt-out-bulb-went-dark.mp3",
      "text": "went dark",
      "textSha256": "18d0f1d82282f35f31ab949ace026f4dccd84ac572367b5b82cd62997bcafc80"
    },
    {
