    {
      "src": "/audio/sentences/neighbor-elevator-chat/1.mp3",
      "text": "Good morning Mrs. Chen, are you heading out for a morning walk?",
      "textSha256": "743c8672fc081ad22a8cd1ef5af246dafad4876852d829deed4507b35c3d1956"
    },
    {
      "src": "/audio/sentences/neighbor-elevator-chat/2.mp3",
      "text": "Good morning Leo, yes, the weather is so nice and cool today.",
      "textSha256": "7df35d0be4ee6c74a43b10d88d3b1b96a1e28a242673449ccb5fb2261082565d"
    },
    {
      "src": "/audio/sentences/neighbor-elevator-chat/3.mp3",
      "text": "After several days of rain, it is wonderful to see the bright sun.",
      "textSha256": "c84568b889f2b314ed2a8be83d8a0828f0566a559fc07d644cc8498a948d140b"
    },
    {
      "src": "/audio/sentences/neighbor-elevator-chat/4.mp3",
      "text": "Are you heading off to school or do you have sports practice?",
      "textSha256": "1eea1bfebbd65b4e903fa6c454a77db10c4e65c7a72a81670659a69f38391aa1"
    },
    {
      "src": "/audio/sentences/neighbor-elevator-chat/5.mp3",
      "text": "I have soccer training with my school teammates on the grass field.",
      "textSha256": "2ad7e2c67a99849a6ad31c34d5b4ed2382dfd8f1764f935b3cddc8ad6aa4a865"
    },
    {
      "src": "/audio/sentences/neighbor-elevator-chat/6.mp3",
      "text": "With a warm smile, she wished me a lovely sunny weekend!",
      "textSha256": "c96a95e34bde87b2c484b41fbeaadf57ed16ee70419f2d883de1306483df6039"
    },
    {
