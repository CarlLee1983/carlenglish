    {
      "src": "/audio/sentences/apologizing-for-being-late/1.mp3",
      "text": "Hi Kevin, I am calling because my bus is completely stuck in heavy traffic.",
      "textSha256": "f1f5e8cfc71d14602b7018bb2cbca66171916902a47cd80947f2ab1ffc865948"
    },
    {
      "src": "/audio/sentences/apologizing-for-being-late/2.mp3",
      "text": "I am so sorry about that, but I will be fifteen minutes late.",
      "textSha256": "ac65a293adb37ac371a87374d44cbf2d51a0c1cb649e248485b3c162da031e70"
    },
    {
      "src": "/audio/sentences/apologizing-for-being-late/3.mp3",
      "text": "Do not worry at all Leo, thank you for calling to let me know.",
      "textSha256": "ce92ce62ddd3be353fb380689d8bc167255663cf5db47ba434413b23ae881062"
    },
    {
      "src": "/audio/sentences/apologizing-for-being-late/4.mp3",
      "text": "There was a broken delivery truck blocking two lanes on the bridge.",
      "textSha256": "24e0803f9fe07712a1b4daedd512b3dffaf3e0461c5fcb5845d5845d3d0cbcda"
    },
    {
      "src": "/audio/sentences/apologizing-for-being-late/5.mp3",
      "text": "The traffic is starting to move again, so I should arrive very soon.",
      "textSha256": "10297fc164180d2b46b6306bbfe40ca870dc36a66ffa51fa23214cfe9a892f9f"
    },
    {
      "src": "/audio/sentences/apologizing-for-being-late/6.mp3",
      "text": "Take your time and stay safe, I will wait for you inside the bookstore.",
      "textSha256": "1e5e39dd764d20d6c9daeff5b1b7eb6a44c6363fefee3b223f2206724df2b65b"
    },
