    {
      "src": "/audio/sentences/setting-meeting-time/1.mp3",
      "text": "Are you free this Saturday morning to discuss our science assignment?",
      "textSha256": "8b5d30d9ab21a23b7e096b2fbdd7224744dae6858aab6d29dc0c5fbeb2757f37"
    },
    {
      "src": "/audio/sentences/setting-meeting-time/2.mp3",
      "text": "I am quite busy until ten o'clock, but after that my schedule is open.",
      "textSha256": "ec9f2c1ebc4f6c167ea738510f554d1603944cce9031aa76cea213e0c46de519"
    },
    {
      "src": "/audio/sentences/setting-meeting-time/3.mp3",
      "text": "Ten thirty would suit me perfectly, does that sound convenient for you?",
      "textSha256": "610eaf1bb63ff8cfcaaf90c30d8317d4e41e4b17a9f00ee599411848cb78ce66"
    },
    {
      "src": "/audio/sentences/setting-meeting-time/4.mp3",
      "text": "Yes, meeting earlier in the day is much better before it gets too hot.",
      "textSha256": "d26bdb5b9adf5df44a1e8cceea6dddda4c1a4ecd6beb7551aaa3c2651521f0c3"
    },
    {
      "src": "/audio/sentences/setting-meeting-time/5.mp3",
      "text": "What is your plan for where to meet so nobody gets lost along the busy road?",
      "textSha256": "f65a997c2d30aa9f479c084cfa0150c46b760c0e68a02ebe3832474353b55e0b"
    },
    {
      "src": "/audio/sentences/setting-meeting-time/6.mp3",
      "text": "Let us meet right outside the subway exit near the bakery clock tower.",
      "textSha256": "84e9a9f398a26fd09e260791a2315d7b54241ff0ba7792c6a3865b9fc75004a4"
    },
