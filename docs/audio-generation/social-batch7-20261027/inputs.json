    {
      "src": "/audio/sentences/returning-borrowed-tool/1.mp3",
      "text": "Hello Mr. Wang, I came by to return the metal toolbox you lent me.",
      "textSha256": "c5d51c2071498b0834b1803ea311c83eb43b5375fbd03bed53382261fe01d0c8"
    },
    {
      "src": "/audio/sentences/returning-borrowed-tool/2.mp3",
      "text": "Did the tools you used help you fix your bedroom bookshelf?",
      "textSha256": "1f6a2473be7f93f9f03ebc34852a7bfcdcecb7aa502aedfa959ca6b37c903db5"
    },
    {
      "src": "/audio/sentences/returning-borrowed-tool/3.mp3",
      "text": "Yes, having the proper tools made the work easy and my bookshelf is now done.",
      "textSha256": "0f51d3014fa4b015c46170aa97a89eddbb7ed94239744a930618602fab72871b"
    },
    {
      "src": "/audio/sentences/returning-borrowed-tool/4.mp3",
      "text": "I wiped every tool clean and made sure each piece is back in the box.",
      "textSha256": "3cae055c60afc69a90aaac5eabce871ed768d51d9bda2fb9991aaad32cc85e23"
    },
    {
      "src": "/audio/sentences/returning-borrowed-tool/5.mp3",
      "text": "Here is a small bag of homemade cookies to thank you very much for your kindness.",
      "textSha256": "dbad878663e477ada57ae676e24dc45890b9fcedec7ff90bcf6df703a1e9945c"
    },
    {
      "src": "/audio/sentences/returning-borrowed-tool/6.mp3",
      "text": "That is so sweet of you Leo, you are always a thoughtful neighbor.",
      "textSha256": "54c324faeb540424d8221db30940f15f185ea73dcf071978d2b315dae556cb1f"
    },
    {
