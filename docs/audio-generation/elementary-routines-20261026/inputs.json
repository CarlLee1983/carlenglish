    {
      "src": "/audio/sentences/board-game-turns/1.mp3",
      "text": "Mei and Bo play a board game.",
      "textSha256": "9533cab1d7a0f5c5b9fbca13f197c5789eead08905d4160b83ea098ba203310d"
    },
    {
      "src": "/audio/sentences/board-game-turns/2.mp3",
      "text": "“It is your turn,” says Bo.",
      "textSha256": "b53fbbeeab98ffe3aeed00c5f3b58673aad249a862fbb87db77c5d78f07f4dc0"
    },
    {
      "src": "/audio/sentences/board-game-turns/3.mp3",
