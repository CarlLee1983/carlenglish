    {
      "src": "/audio/sentences/bedtime-alarm/1.mp3",
      "text": "An needs to get up early tomorrow.",
      "textSha256": "4729d9c88e9a080c9b6d80897f2b3b8290b47bac4b66d0e7cb369c292974fa11"
    },
    {
      "src": "/audio/sentences/bedtime-alarm/2.mp3",
      "text": "Mom sets An's alarm clock for seven.",
      "textSha256": "19ed0ee78e97c12bf94e071bc0adf3bbd92982d2da76f75834ff1f974ac56ff8"
    },
    {
      "src": "/audio/sentences/bedtime-alarm/3.mp3",
      "text": "“Is the alarm on?” asks An.",
      "textSha256": "26f978fb9f53122fb6f15847a3ff4836c8026d7b0e5ffd04312f66160955c6d9"
    },
    {
      "src": "/audio/sentences/bedtime-alarm/4.mp3",
      "text": "Mom points to a bell on the screen.",
      "textSha256": "5551f35b65a9be64ee2f59ee5e69a0308fdb5fb7f53a12bc7bc81c28130582de"
    },
    {
      "src": "/audio/sentences/bedtime-alarm/5.mp3",
      "text": "“Yes, it is on,” she says.",
      "textSha256": "4b139a77e8842539eb0d131d5f1d44e66f4e60f92d371584a2b78a93646c2d78"
    },
    {
      "src": "/audio/sentences/bedtime-alarm/6.mp3",
      "text": "An puts the clock beside her bed.",
      "textSha256": "49cba3fdc073a6c4e53cbdbf52f9c761c082624f3fdb4fed025dfc2d702802b8"
    },
    {
