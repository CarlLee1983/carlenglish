      "textSha256": "14264070f7b0ab8aca58c155df42f6e918f3e2d787cc0b9dead1ef2ef26ab957"
    },
    {
      "src": "/audio/sentences/board-game-turns/4.mp3",
      "text": "She moves her piece three spaces.",
      "textSha256": "a0b54cb1a4d5b312b1ccd6d6ca17dff236eccd9fb250873df741a65255485589"
    },
    {
      "src": "/audio/sentences/board-game-turns/5.mp3",
      "text": "“Your piece is near the end!” says Bo.",
      "textSha256": "c5dce410b878e092a16f733153134a570787d7a2347cd30fed871e974ebdc61d"
    },
    {
